msgstr "-2 VERNUNFT nach Abschluss jedes Falls"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:535"
msgid "<<it's hopeless!>>"
msgstr "„Es ist hoffnungslos!“"

msgctxt "woh_nana:536"
msgid "PRIMAL FEAR"
msgstr "URANGST"

msgctxt "woh_nana:537"
msgid "-2 STAMINA after completing each mystery"
msgstr "-2 AUSDAUER nach Abschluss jedes Falls"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:538"
msgid "<<it can't be...>>"
msgstr "„Es kann nicht sein …“"

