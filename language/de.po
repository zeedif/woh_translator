msgid "MOUSE TRAIL: ON/OFF"
msgstr "MAUSSPUR: EIN/AUS"

msgctxt "woh_halo:90"
msgid "SKIP PALETTE CUSTOMIZATION"
msgstr "FARBANPASSUNG ÜBERSPRINGEN"

