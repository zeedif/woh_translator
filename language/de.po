msgstr "Triff in einem Spieldurchgang auf drei TRAUM-Gegner."

msgctxt "woh_dec:80"
msgid "KICK-BOX CUTTER"
msgstr "MESSERSCHARFER TRITT"

msgctxt "woh_dec:81"
msgid "deal 10 damage with a single kick"
msgstr "Verursache mit einem einzigen Tritt 10 Schaden."

msgctxt "woh_dec:82"
msgid "WELCOME TO THE FAMILY"
msgstr "WILLKOMMEN IN DER FAMILIE"

msgctxt "woh_dec:83"
msgid "let the real JURI in"
msgstr "Lerne die echte JURI kennen."

msgctxt "woh_dec:84"
msgid "STEEL BOX"
msgstr "MESSER GEGEN STAHL"

msgctxt "woh_dec:85"
msgid "break the blade"
msgstr "Zerbrich die Klinge."

msgctxt "woh_dec:86"
msgid "CAN YOU TRUST THEM?"
msgstr "KANNST DU IHNEN VERTRAUEN?"

msgctxt "woh_dec:87"
msgid "hire two allies in one playthrough and win"
msgstr "Heuere in einem Spieldurchgang zwei Begleitungen an und gewinne."

msgctxt "woh_dec:88"
msgid "(H)EXPERIMENTAL THERAPY"
msgstr "(H)EXPERIMENTELLE MEDIZIN"

msgctxt "woh_dec:89"
msgid "complete the [MIMI'S LITTLE PROJECT] challenge"
msgstr "Schließe die Herausforderung [MIMIS PROJEKT] ab."

msgctxt "woh_dec:90"
msgid "CATCH ME IF YOU CAN"
msgstr "FANG MICH, WENN DU KANNST"

msgctxt "woh_dec:91"
msgid "handcuff the ultimate opportunist"
msgstr "Lege dem ultimativen Opportunisten Handschellen an."

