msgstr "AN EINEM SCHEIDEWEG"

#. Parte de «TIRED» (woh_nana:539).
msgctxt "woh_nana:546"
msgid ""
"+5% DOOM\n"
"\n"
"to remove this curse:\n"
"(use): -3 STAMINA\n"
"(discard): -3 REASON"
msgstr ""
"+5 % VERDERBEN\n"
"\n"
"Um diesen Fluch zu entfernen:\n"
"(verwenden): -3 AUSDAUER\n"
"-3 VERNUNFT"

#. Parte de «TIRED» (woh_nana:539).
