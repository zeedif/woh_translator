msgid "PRAY"
msgstr "BETEN"

msgctxt "woh_comb:46"
msgid ""
"regain 1 STAMINA\n"
"COST: 2 REASON"
msgstr ""
"Regeneriert 1 AUSDAUER.\n"
"KOSTEN: 2 VERNUNFT"

msgctxt "woh_comb:47"
msgid "MEDITATE"
msgstr "MEDITIEREN"

msgctxt "woh_comb:48"
