msgstr " – GEFAHRENSTUFE"

msgctxt "woh_addy:216"
msgid ""
"YOU CAN'T INVESTIGATE\n"
"YOUR HOME"
msgstr ""
"DU KANNST DEIN ZUHAUSE\n"
"NICHT UNTERSUCHEN"

