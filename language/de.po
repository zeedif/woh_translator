"(ablegen): Du verlierst 3 AUSDAUER."

msgctxt "woh_ichi:24"
msgid "<<is that paint?>>"
msgstr "„Ist das Farbe?“"

msgctxt "woh_ichi:25"
msgid "EIMI"
msgstr "EIMI"

