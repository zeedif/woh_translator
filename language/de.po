"(discard): +4% DOOM"
msgstr ""
"-2 GESCHICKLICHKEIT\n"
"(ablegen): +4 % VERDERBEN"

msgctxt "woh_dec:18"
msgid "<<they can't find the body>>"
msgstr "„Die Leiche ist verschwunden.“"

