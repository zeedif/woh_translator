msgid "EXTRA MATH DISPLAYED: ON/OFF"
msgstr "ZUSÄTZLICHE WERTE ANZEIGEN: EIN/AUS"

msgctxt "woh_halo:92"
msgid "EXTRA INFORMATION DISPLAYED: ON/OFF"
msgstr "ZUSÄTZLICHE INFO ANZEIGEN: EIN/AUS"

