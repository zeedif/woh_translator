msgstr "UNHEIMLICHER NACHBAR: EIN/AUS"

msgctxt "woh_halo:85"
msgid "CHECK FOR CONNECTED GAMEPADS: ON/OFF"
msgstr "NACH CONTROLLERN SUCHEN: EIN/AUS"

