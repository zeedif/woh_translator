msgid "[PERCEPTION-based]"
msgstr "[Basiert auf WAHRNEHMUNG]"

msgctxt "woh_comb:51"
msgid ""
"learn a new spell or gain experience\n"
"COST: 1% DOOM"
msgstr ""
"Du lernst einen neuen Zauber oder erhältst Erfahrung.\n"
"KOSTEN: 1 % VERDERBEN"

msgctxt "woh_comb:52"
msgid "FIRE WEAPON"
msgstr "WAFFE ABFEUERN"

