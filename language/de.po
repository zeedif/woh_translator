msgstr "[SCHWERES WERKZEUG]: -1 STÄRKE"

msgctxt "woh_small:507"
msgid "BRONZE CRUCIFIX"
msgstr "BRONZE-KRUZIFIX"

msgctxt "woh_small:508"
msgid ""
"(equip): allows you to fight GHOST enemies normally\n"
"(use): break it in half"
msgstr ""
"(anlegen): Du kannst GEISTER normal bekämpfen.\n"
"(verwenden): Entzweibrechen."

msgctxt "woh_small:509"
msgid "SKELETON KEY"
msgstr "SKELETTSCHLÜSSEL"

msgctxt "woh_small:510"
msgid ""
"(use): open a random remaining LIGHTHOUSE padlock\n"
"COST: 15% DOOM"
msgstr ""
"(verwenden): Öffnet ein zufälliges versperrtes Schloss im LEUCHTTURM.\n"
"KOSTEN: 15 % VERDERBEN"

msgctxt "woh_small:511"
msgid "HANDCUFFS"
msgstr "HANDSCHELLEN"

msgctxt "woh_small:512"
msgid ""
"(while in inventory): lower HUMAN enemy's POWER by 5\n"
"(use): defeat a HUMAN enemy with 12 or less HEALTH remaining"
msgstr ""
"(wenn im Inventar): Verringert die KRAFT von MENSCHEN um 5.\n"
"(verwenden): Besiegt einen MENSCHEN mit 12 oder weniger LEBEN."

msgctxt "woh_small:513"
msgid "You subdue the weakened enemy!"
msgstr "Du bezwingst den geschwächten Gegner!"

msgctxt "woh_small:514"
msgid "RUSTY SICKLE"
msgstr "ROSTIGE SICHEL"

