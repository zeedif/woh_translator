msgstr "LEICHENSTAUB"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:297"
msgid ""
"(use): +20 EXP\n"
"-2 LUCK"
msgstr ""
"(verwenden): +20 ERF\n"
"-2 GLÜCK"

