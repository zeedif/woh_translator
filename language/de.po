msgid ""
"-AURA OF AZAL-HOTH-\n"
"\n"
"lower DOOM by 10% by completing a mystery\n"
"[PASSIVE]"
msgstr ""
"-AZAL-HOTHS AURA-\n"
"\n"
"Wenn du einen Fall abschließt, wird das VERDERBEN um 10 % verringert.\n"
"[PASSIV]"

msgctxt "woh_small:498"
msgid ""
"\n"
"\n"
"retrieve more pages when you level up"
msgstr ""
"\n"
"\n"
"Bei Stufenaufstiegen erhältst du weitere Seiten."

msgctxt "woh_small:499"
