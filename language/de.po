msgid "completing a mystery regains 1 REASON"
msgstr "Du regenerierst 1 VERNUNFT, wenn du einen Fall abschließt."

msgctxt "woh_ichi:27"
msgid "<<thanks for saving me>>"
msgstr "„Danke. Du hast mich gerettet.“"

msgctxt "woh_ichi:28"
msgid "[gallery curator]"
msgstr "[Galeriekuratorin]"

