msgstr "+5 % VERDERBEN"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_nana:518"
msgid "SALT-DRIED EYES"
msgstr "SALZVERKRUSTETE AUGEN"

#. Descripción de «SALT-DRIED EYES» (woh_nana:518).
msgctxt "woh_nana:519"
msgid ""
"[your eyes burn and crust over with a thin layer of salt, making the world blur]\n"
"-1 PERCEPTION"
msgstr ""
"[Deine Augen brennen und sind von einer dünnen Schicht Salz überzogen, die die Welt verschwimmen lässt]\n"
"-1 WAHRNEHMUNG"

#. Opción de «SALT-DRIED EYES» (woh_nana:518). Opciones: <<is it an infection?>> · HOLLOWED VEIN.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:520"
msgid "<<is it an infection?>>"
msgstr "„Ist es eine Infektion?“"

#. Opción de «SALT-DRIED EYES» (woh_nana:518). Opciones: <<is it an infection?>> · HOLLOWED VEIN.
msgctxt "woh_nana:521"
msgid "HOLLOWED VEIN"
msgstr "AUSGEHÖHLTE VENE"

#. Parte de «SALT-DRIED EYES» (woh_nana:518).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:522"
msgid ""
"[a vein on your arm collapses inward, forming a thin channel that feels >>empty<<, as if the blood avoids flowing through it]\n"
"-2 MAX STAMINA"
msgstr ""
"[Eine Vene in deinem Arm fällt in sich zusammen und formt einen dünnen Kanal, der sich „leer“ anfühlt, als würde das Blut vermeiden, hindurchzufließen]\n"
"-2 MAX. AUSDAUER"

#. Parte de «SALT-DRIED EYES» (woh_nana:518).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:523"
msgid "<<it doesn't hurt>>"
msgstr "„Es tut nicht weh.“"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_nana:524"
msgid "WEIRD BRUISE"
msgstr "SELTSAMER BLUTERGUSS"

#. Descripción de «WEIRD BRUISE» (woh_nana:524).
msgctxt "woh_nana:525"
msgid ""
"[the dark bruise on your ribs feels strangely soft, as if the bone beneath is dissolving]\n"
"-1 STAMINA"
msgstr ""
"[Der dunkle Bluterguss an deinen Rippen fühlt sich seltsam weich an, als würde sich der Knochen darunter auflösen]\n"
"-1 AUSDAUER"

#. Opción de «WEIRD BRUISE» (woh_nana:524). Opciones: <<something's growing>> · MISALIGNED VISION.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:526"
msgid "<<something's growing>>"
msgstr "„Etwas wächst.“"

#. Opción de «WEIRD BRUISE» (woh_nana:524). Opciones: <<something's growing>> · MISALIGNED VISION.
msgctxt "woh_nana:527"
msgid "MISALIGNED VISION"
msgstr "FEHLSICHTIGKEIT"

#. Parte de «WEIRD BRUISE» (woh_nana:524).
msgctxt "woh_nana:528"
msgid "PREPARE YOUR ATTACK and ATTACK BOOST combat actions take longer"
msgstr "Die Kampfaktionen ANGRIFF VORBEREITEN und ANGRIFF FOKUSSIEREN dauern länger"

#. Parte de «WEIRD BRUISE» (woh_nana:524).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:529"
msgid "<<nauseating double-image>>"
msgstr "„Übelkeit erregendes Doppelbild.“"

msgctxt "woh_nana:530"
msgid "BITE MARKS"
msgstr "BISSABDRÜCKE"

msgctxt "woh_nana:531"
msgid "every enemy attack adds -1 STAMINA penalty"
msgstr "Jeder gegnerische Angriff fügt -1 AUSDAUER zu"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:532"
msgid "<<it hurts like hell>>"
msgstr "„Es tut höllisch weh.“"

msgctxt "woh_nana:533"
msgid "MELANCHOLIA"
msgstr "MELANCHOLIE"

msgctxt "woh_nana:534"
