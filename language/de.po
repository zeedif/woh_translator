msgctxt "woh_comb:42"
msgid ""
"[one-time use only]\n"
"[needs STAMINA or REASON to be lower than 3]"
msgstr ""
"[Einmalige Verwendung]\n"
"[Deine AUSDAUER oder VERNUNFT müssen niedriger als 3 sein.]"

msgctxt "woh_comb:43"
msgid "DESPERATE STRUGGLE"
msgstr "VERZWEIFELTE ANSTRENGUNG"

msgctxt "woh_comb:44"
msgid ""
"[one-time use]\n"
"\n"
"doubles all damage dealt during this turn"
msgstr ""
"[Einmalige Verwendung]\n"
"\n"
"Verdoppelt in diesem Zug allen verursachten Schaden."

