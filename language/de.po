msgstr "Bereit für ein Abenteuer"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:685"
msgid "[friendly neighbor][IMPORTANT]"
msgstr "[Wohnt gleich nebenan.][WICHTIG]"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:686"
msgid "KYOKO"
msgstr "KYOKO"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:687"
msgid ""
"+5% DOOM\n"
"+1 extra DAMAGE"
msgstr ""
"+5 % VERDERBEN\n"
"+1 zusätzlicher SCHADEN"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:688"
msgid "the forest wants her dead"
msgstr "Der Wald will sie tot sehen."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:689"
msgid "[missing hiker]"
msgstr "[Vermisste Wanderin]"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:690"
msgid "AIKO'S FRIEND"
msgstr "AIKOS FREUNDIN"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:691"
msgid "allows one additional INVENTORY slot"
msgstr "Bietet dir einen zusätzlichen Platz im INVENTAR."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:692"
msgid "carrying an empty bag"
msgstr "Trägt eine leere Tasche."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:693"
msgid "[she's always had my back]"
msgstr "[Sie war immer für mich da.]"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:694"
msgid "HIROYUKI MIZUTANI"
msgstr "HIROYUKI MIZUTANI"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:695"
msgid "completing a mystery regains 1 STAMINA"
msgstr "Du regenerierst 1 AUSDAUER, wenn du einen Fall abschließt."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:696"
msgid "truth seeker"
msgstr "Wahrheitssuchender."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:697"
msgid "[mysterious janitor]"
msgstr "[Mysteriöser Hausmeister]"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:698"
msgid ""
"\n"
"[HIROYUKI]: +1 STAMINA"
msgstr ""
"\n"
"[HIROYUKI]: +1 AUSDAUER"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:699"
msgid "JACOB'S GOLONKA"
msgstr "JACOBS GOLONKA"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:700"
msgid ""
"(use): +1 STAMINA, +1 MAX STAMINA\n"
"+2% DOOM"
msgstr ""
"(verwenden): +1 AUSDAUER, +1 MAX. AUSDAUER\n"
"+2 % VERDERBEN"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:701"
msgid "acquired taste"
msgstr "Nicht jedermanns Geschmack."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:702"
msgid "MYSTERY YAKITORI"
msgstr "YAKITORI (SUSPEKT)"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:703"
msgid "(use): +4 REASON, -1 STAMINA"
msgstr "(verwenden): +4 VERNUNFT, -1 AUSDAUER"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:704"
msgid "unknown meat"
msgstr "Fleisch unbekannter Herkunft."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:705"
msgid "RYUICHI sells you important information..."
msgstr "RYUICHI verkauft dir wichtige Informationen …"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:706"
msgid "REIKO"
msgstr "REIKO"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:707"
msgid "completing a mystery grants 1 FUNDS"
msgstr "Du erhältst 1 GELD, wenn du einen Fall abschließt."

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_small:708"
msgid "<<it will be fine, trust me>>"
msgstr "„Vertrau mir, alles wird gut.“"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:709"
msgid "[naive socialite]"
msgstr "[Naive Prominente]"

#. Objetos: etiquetas, estadísticas, descripciones y mensajes de uso.
msgctxt "woh_small:710"
msgid ""
"\n"
"[REIKO]: +1 FUNDS"
msgstr ""
"\n"
"[REIKO]: +1 GELD"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:0"
msgid "[RITUAL]"
msgstr "[RITUAL]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:1"
msgid ""
"--SPELL--\n"
"\n"
"\n"
msgstr ""
"--ZAUBER--\n"
"\n"
"\n"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:2"
msgid "[SUPPORT]"
msgstr "[UNTERSTÜTZUNG]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:3"
msgid "[HEALING]"
msgstr "[HEILUNG]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:4"
msgid "[COMBAT]"
msgstr "[KAMPF]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:5"
msgid "[OFFENSIVE]"
msgstr "[OFFENSIV]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:6"
msgid "[DEFENSIVE]"
msgstr "[DEFENSIV]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:7"
msgid "[SEAL]"
msgstr "[SIEGEL]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:8"
msgid "[INVESTIGATION]"
msgstr "[ERMITTLUNG]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:9"
msgid "You've already defeated this enemy."
msgstr "Du hast diesen Gegner bereits besiegt."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:10"
msgid "This contract won't work on this enemy."
msgstr "Dieser Vertrag hat bei diesem Gegner keine Wirkung."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:11"
msgid "This spell can only be cast when investigating a location."
msgstr "Du kannst diesen Zauber nur wirken, wenn du einen Ort untersuchst."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:12"
msgid "This spell targets HUMAN enemies only."
msgstr "Dieser Zauber wirkt nur gegen MENSCHEN."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:13"
msgid "This spell targets ELDRITCH enemies only."
msgstr "Dieser Zauber wirkt nur gegen UNWELTLICHE Gegner."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:14"
msgid "Occult signs attract unknown power!"
msgstr "Die okkulten Zeichen ziehen eine unbekannte Macht an!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:15"
msgid "It's too much for your mind! (-1 REASON)"
msgstr "Das ist für deinen Verstand zu viel! (-1 VERNUNFT)"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:16"
msgid "CURRENT SPELL LIMIT"
msgstr "AKTUELLES ZAUBERLIMIT"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:17"
msgid "MIND DRAIN"
msgstr "HIRNSCHWUND"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:18"
msgid ""
"deals 5 damage\n"
"regain 2 REASON\n"
"[COST: -1 MAX REASON]"
msgstr ""
"Verursacht 5 Schaden.\n"
"Du regenerierst 2 VERNUNFT\n"
"[KOSTEN: -1 MAX. VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:19"
msgid "You reach out your hand in an occult gesture, draining ENEMY's mind!"
msgstr "Du machst eine okkulte Geste und attackierst den Verstand des GEGNERS!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:20"
msgid "REGENERATION"
msgstr "REGENERATION"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:21"
msgid ""
"regain 4 STAMINA\n"
"[COST: 2 REASON]"
msgstr ""
"Regeneriert 4 AUSDAUER.\n"
"[KOSTEN: 2 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:22"
msgid "You can feel your wounds slowly closing!"
msgstr "Deine Wunden schließen sich langsam!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:23"
msgid "SKIN REMOVAL"
msgstr "HAUT ABSCHABEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:24"
msgid ""
"deals 6 damage\n"
"[COST: 3 REASON]"
msgstr ""
"Verursacht 6 SCHADEN\n"
"[KOSTEN: 3 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:25"
msgid "The skin of your enemy starts falling off in big patches!"
msgstr "Die Haut deines Gegners fällt ab!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:26"
msgid "MULTIPLY WOUND"
msgstr "WUNDE VERVIELFACHEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:27"
msgid ""
"deals damage to an enemy, which increases the lower your STAMINA is\n"
"[COST: 2 STAMINA]"
msgstr ""
"Fügt einem Gegner mehr Schaden zu, je niedriger deine AUSDAUER ist.\n"
"[KOSTEN: 2 AUSDAUER]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:28"
msgid "The wounds of your enemy explode with gore!"
msgstr "Die Wunden deines Gegners platzen auf!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:29"
msgid "K'NPHA RITUAL"
msgstr "K’NPHAS RITUAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:30"
msgid ""
"when your allies die, a random STAT gets raised by 1\n"
"[COST: 2 REASON]"
msgstr ""
"Wenn eine Begleitung stirbt, erhöht sich ein zufälliger WERT um 1.\n"
"[KOSTEN: 2 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:31"
msgid "Part of your ally's essence stays with you!"
msgstr "Ein Teil der Essenz deiner Begleitung bleibt bei dir!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:32"
msgid ""
"K'NPHA RITUAL\n"
"[allies -> stats]"
msgstr ""
"K’NPHAS RITUAL\n"
"[Begleitung -> Wert]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:33"
msgid "INVISIBILITY"
msgstr "UNSICHTBARKEIT"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:34"
msgid ""
"until the end of the current mystery, there is no DOOM penalty for escaping from combat\n"
"[COST: 4 REASON]"
msgstr ""
"Bis zum Ende des aktuellen Falles steigt das VERDERBEN nicht, wenn du aus einem Kampf fliehst.\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:35"
msgid "You shift into the shadow realm!"
msgstr "Du trittst ins Reich der Schatten ein!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:36"
msgid "You are already invisible!"
msgstr "Du bist bereits unsichtbar!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:37"
msgid "ABOLISH"
msgstr "NEUTRALISIEREN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:38"
msgid ""
"lowers ELDRITCH enemy DAMAGE by 1\n"
"[COST: 3 STAMINA]"
msgstr ""
"Verringert den SCHADEN von UNWELTLICHEN Gegnern um 1.\n"
"[KOSTEN: 3 AUSDAUER]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:39"
msgid "A magic barrier appears, absorbing the damage!"
msgstr "Eine magische Barriere erscheint und absorbiert den Schaden!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:40"
msgid "Additional barriers won't help!"
msgstr "Weitere Barrieren nützen dir nichts!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:41"
msgid "ABSORB"
msgstr "ABSORBIEREN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:42"
msgid ""
"deals 3 damage, gain 2 STAMINA\n"
"[COST: 4 REASON]"
msgstr ""
"Verursacht 3 Schaden und regeneriert 2 AUSDAUER.\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:43"
msgid "You suck the life force out of your enemy!"
msgstr "Du entziehst deinem Gegner die Lebenskraft!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:44"
msgid "THIRD EYE"
msgstr "DRITTES AUGE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:45"
msgid ""
"+1 KNOWLEDGE and PERCEPTION until the end of the mystery\n"
"[effect doesn't stack]\n"
"[COST: 3 REASON]"
msgstr ""
"+1 WISSEN und WAHRNEHMUNG bis zum Ende des Falles.\n"
"[Effekt nicht stapelbar]\n"
"[KOSTEN: 3 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:46"
msgid "You can feel your inner eye open!"
msgstr "Dein inneres Auge öffnet sich!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:47"
msgid "You wouldn't want a fourth eye, would you?"
msgstr "Du willst doch bestimmt kein viertes Auge, oder?"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:48"
msgid "ITHOTU FLAME"
msgstr "FLAMME VON ITHOTU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:49"
msgid ""
"deals 8 damage\n"
"+2% DOOM\n"
"[COST: 1 REASON]\n"
"[COST: 1 STAMINA]"
msgstr ""
"Verursacht 8 Schaden.\n"
"+2 % VERDERBEN\n"
"[KOSTEN: 1 VERNUNFT]\n"
"[KOSTEN: 1 AUSDAUER]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:50"
msgid "A column of fire engulfs the enemy!"
msgstr "Eine Flammensäule hüllt den Gegner ein!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:51"
msgid "SEAL OF SAVVESH"
msgstr "SIEGEL VON SAVVESH"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:52"
msgid ""
"+1 STRENGTH\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 STÄRKE\n"
"[Wird bei Verwendung abgelegt.]\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:53"
msgid "A new seal appears on your skin!"
msgstr "Auf deiner Haut erscheint ein neues Siegel!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:54"
msgid "SEAL OF BRAM'EL"
msgstr "SIEGEL VON BRAM’EL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:55"
msgid ""
"+1 KNOWLEDGE\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 WISSEN\n"
"[Wird bei Verwendung abgelegt.]\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:56"
msgid "THREAD OF FATE"
msgstr "SCHICKSALSFADEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:57"
msgid ""
"defeat target HUMAN enemy\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"Besiegt den anvisierten MENSCHEN.\n"
"[Wird bei Verwendung abgelegt.]\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:58"
msgid "Enemy falls to the ground, dead."
msgstr "Der Gegner fällt tot zu Boden."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:59"
msgid "ANCESTRAL STRENGTH"
msgstr "STÄRKE DER AHNEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:60"
msgid ""
"+1 DAMAGE\n"
"[COST: 4 REASON]"
msgstr ""
"+1 SCHADEN\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:61"
msgid "Someone is guiding your moves..."
msgstr "Jemand leitet dich an …"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:62"
msgid ""
"ANCESTRAL STRENGTH\n"
"[+1 DAMAGE]"
msgstr ""
"STÄRKE DER AHNEN\n"
"[+1 SCHADEN]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:63"
msgid "ENTHRALLMENT"
msgstr "UNTERWERFUNG"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:64"
msgid ""
"gain an additional follower\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"Du erhältst eine zusätzliche Begleitung.\n"
"[Wird bei Verwendung abgelegt.]\n"
"[KOSTEN: 4 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:65"
msgid "A new person follows your lead..."
msgstr "Jemand Neues folgt deinen Anweisungen …"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:66"
msgid "AWAKEN"
msgstr "ERWACHEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:67"
msgid ""
"gain a permanent boost of two randomly selected stats\n"
"[COST: 10% DOOM]"
msgstr ""
"Zwei zufällige Werte werden dauerhaft erhöht.\n"
"[KOSTEN: 10 % VERDERBEN]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:68"
msgid "You've attracted the attention of something evil..."
msgstr "Du hast die Aufmerksamkeit von etwas Bösem erregt …"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:69"
msgid "BINDING AGONY"
msgstr "FESSELNDE AGONIE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:70"
msgid ""
"target enemy's damage is lowered by 1\n"
"[COST: 3 REASON]"
msgstr ""
"Der Schaden des anvisierten Gegners wird um 1 verringert.\n"
"[KOSTEN: 3 VERNUNFT]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:71"
msgid "BINDING AGONY makes their movement slower!"
msgstr "FESSELNDE AGONIE verlangsamt den Gegner!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:72"
msgid "WITNESS CURSE"
msgstr "FLUCH DES ZEUGEN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:73"
msgid ""
"converts all combat STAMINA damage taken into extra DOOM\n"
"[COST: 2 REASON]"
msgstr ""
"Wandelt allen in Kämpfen erlittenen AUSDAUER-Schaden in zusätzliches VERDERBEN um.\n"
"[KOSTEN: 2 VERNUNFT]"

