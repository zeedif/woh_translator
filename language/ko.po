msgid "Could it be?.. There's still some hope! (-4% DOOM)"
msgstr "설마?... 아직 희망은 있다! (파멸 -4%)"

msgctxt "woh_small:192"
msgid "forbidden knowledge"
msgstr "금단의 지식"

msgctxt "woh_small:193"
msgid "RITUAL DAGGER"
msgstr "의식용 단도"

msgctxt "woh_small:194"
msgid "[small chance of recovering REASON after defeating an enemy]"
