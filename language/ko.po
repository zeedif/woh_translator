msgstr "[모든 미스터리와 조우할 확률이 동등해진다]"

msgctxt "woh_ui:133"
msgid "[when leveling up, the game will only draw generic and character-exclusive perk cards]"
msgstr "[레벨업 시, 일반 혹은 캐릭터 특화 특성 카드만 제공된다]"

msgctxt "woh_ui:134"
msgid "[when leveling up, the game will draw random unlocked perk cards]"
msgstr "[레벨업 시, 해금된 특성 카드가 무작위로 제공된다]"

msgctxt "woh_ui:135"
