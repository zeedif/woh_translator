msgstr "[이번 플레이에서 발견한 아이템의 가격과 수치를 무작위로 정하지 않는다]"

msgctxt "woh_ui:130"
msgid "[randomize the price and statistics of item you find and buy this playthrough]"
msgstr "[이번 플레이에서 발견한 아이템의 가격과 수치를 무작위로 정한다]"

