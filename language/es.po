msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "¡Sacaste un objeto del almacén!"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "¡No hay suficiente espacio para un objeto!"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "ALMACÉN"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "OBJETOS ALMACENADOS"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "¡No hay suficiente espacio! ¡Objeto añadido al almacén!"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "Para subir de nivel, pulsa el botón parpadeante."

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "¡No tienes suficiente experiencia!"

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "HABLAR CON LA ESTUDIANTE"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "INSTALAR UN TELESCOPIO"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "REGRESAR"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "No tienes un telescopio."

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "La estudiante murmura algo para sí misma."

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "Tal vez sea mejor dejarla sola."

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr ""
"El agua fría te ayuda a organizar tus pensamientos.\n"
"(+1 de CORDURA)"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr ""
"El agua caliente te ayuda con tu dolor muscular.\n"
"(+1 de VIGOR)"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"Clavar un muñeco de paja en este árbol te concederá tu deseo...\n"
"\n"
"a cambio de un precio, claro está."

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[Puedes clavar dos muñecos de paja más aquí]"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[Puedes clavar un muñeco de paja más aquí]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"No deberías haber vuelto aquí.\n"
"(+1% de CAOS)"

msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "ÁRBOL DE LA BRUJA"

msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "Según las leyendas, las raíces de este árbol llegan hasta la tumba de una bruja ahorcada..."

msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr ""
"Notaste una cartera escondida debajo de una rama caída.\n"
"(+2 de EFECTIVO)"

msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "La bruja enterrada cobra su cuota..."

msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "¡Tu mente se llena de cantos prohibidos!"

msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr ""
"¡De repente te sientes mucho mejor!\n"
"(+2 de VIGOR)"

msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr "Pedir fuerza [+2 de VIGOR]"

msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr "Pedir conocimiento [+HECHIZO]"

msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr "Pedir riqueza [+2 de EFECTIVO]"

msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr "Es una mala idea [Irse]"

#, fuzzy
msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"Te detiene una joven oficial de policía.\n"
"\n"
"\"¿Cómo podemos ayudarte?\""

msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "COMISARÍA"

msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "Los oficiales en la comisaría están ocupados trabajando en varios casos extraños..."

msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "Solicitar más patrullas policiales"

msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "Quejarse de las patrullas policiales"

msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr "Compartir información [-11 de EXP / +1 de DINERO]"

msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "Salir de la comisaría"

msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"El oficial te agradece y promete más patrullas policiales.\n"
"(Nivel de amenaza reducido)"

msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "El oficial se disculpa y dice que no tienen unidades de patrulla disponibles."

msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr "El detective te agradece por la información y te da una recompensa. (-11 de EXP / +1 de EFECTIVO)"

msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "El detective te agradece por la información, pero dice que no es suficiente para una recompensa."

msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"¡Finalmente lograste entrar en el faro maldito!\n"
"\n"
"Tu instinto te dice dos cosas: que quien sea (o lo que sea) responsable de los extraños eventos, debe estar en el piso más alto de este lugar y que deberías huir de este lugar tan lejos y rápido como puedas. Temes que no haya vuelta atrás una vez que empieces a subir estas escaleras..."

msgctxt "woh_addy:41"
msgid "access storage"
msgstr "Acceder al almacén"

msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "Descansar un poco [+2% de CAOS]"

msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "Empezar a subir"

msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr ""
"Descansaste un poco.\n"
"(+1 de CORDURA / +1 de VIGOR)"

msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "FARO (PLANTA BAJA)"

msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr "A medida que la niebla antinatural se disipa lentamente, te sientes aliviado y te desplomas en el suelo..."

msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"Las nubes oscuras se arremolinan alrededor del faro.\n"
"¿Llegaste demasiado tarde?"

msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "EL MONUMENTO"

msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "Olvidada por todos, la ENTIDAD EXTERIOR espera pacientemente a aquellos que la necesitan..."

msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr "Irse sin un sacrificio [Enfurecer a la ENTIDAD EXTERIOR]"

msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "Te cortas la mano y llenas el recipiente con tu sangre..."

msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "Puedes sentir que tus recuerdos más queridos te abandonan..."

msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "Quemas el dinero en el recipiente..."

msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "Enfureciste a la ENTIDAD EXTERIOR..."

msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "Negociar con una ENTIDAD EXTERIOR es arriesgado, pero ¿quizás pueda posponer el caos inminente?"

msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "Alimentar a la ENTIDAD EXTERIOR con tu sangre"

msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr "Entregar a la ENTIDAD EXTERIOR tus recuerdos más preciados"

msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "Ofrecer un regalo material"

msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "Aún tienes algo de tiempo antes de que te llamen a la oficina del médico."

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "ÁREA DE RECEPCIÓN"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "Esperas pacientemente en el área de recepción."

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "Muchos enfermos esperan ser examinados por el personal del hospital sobrecargado de trabajo."

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "Entrar en la OFICINA DEL MÉDICO [+2% de CAOS]"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "Ir al PASILLO A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr "Entrar en la FARMACIA [+3% de CAOS]"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "Una enfermera apresurada pasa rápidamente a tu lado."

msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "OFICINA DEL MÉDICO"

msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "El departamento de emergencias está lleno de gente como resultado de las cosas extrañas que suceden en la ciudad."

msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"Finalmente, te llamaron a la oficina del médico.\n"
"\n"
"“Así que... ¿cómo puedo ayudarte hoy?”"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "SALIR"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[ACCIONES ADICIONALES DISPONIBLES EN LAS TARJETAS DE LESIÓN]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "Aprovechaste la oportunidad y robaste una botella de pastillas."

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "No deberías arriesgarte a robar otra botella."

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "Sientes como el cráneo está observando todos tus movimientos."

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "PASILLO A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "Te adentras más por el pasillo..."

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "Regresar al ÁREA DE RECEPCIÓN"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "Tomar el ASCENSOR"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "Entrar a la MORGUE"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "No es momento de perder el tiempo aquí."

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "La puerta de la morgue está cerrada."

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "PASILLO B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "El piso superior está inquietantemente silencioso..."

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "Revisar la SALA DE PACIENTES"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "No deberías molestar a los pacientes en recuperación."

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "DESCANSANDO EN CASA"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "Definitivamente se siente bien estar de vuelta en casa."

msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "VIGOR/CORDURA"

msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "El tiempo pasa volando, te preparas para salir y continuar tu larga investigación."

msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "CAOS"

msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "VIGOR/CORDURA"

msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"Espera... ¿Qué es eso?\n"
"(ALGO MALIGNO SABE DÓNDE VIVES)"

msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "Tomaste una pequeña siesta en tu cama."

msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "Vendaste las lesiones recientes."

msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "Tomaste una larga ducha caliente..."

msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "Tragaste unos analgésicos."

msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "Llamaste a tu mejor amigo y hablaste de cosas sin importancia."

msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "Te sentaste en un sofá y leíste tu libro favorito."

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "CORREDOR DEL APARTAMENTO"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "Golpeaste la puerta de tu amigo y esperaste..."

msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr "“Hey torpe, estoy contigo. ¿Por qué vamos de vuelta a mi casa?”"

msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr "“Heyyy... Estoy muy ocupado hoy. ¿Te parece si quedamos en otro momento?”"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"Um, KANA no está en casa.\n"
"Deberías volver más tarde..."

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "Ir de compras toma tiempo precioso. (+4% de CAOS)"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "Um... ¿Dónde está ese perro?"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "COMPRANDO OBJETOS"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "SALIR SIN COMPRAR NADA"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "Necesitas TARJETA DE YAKUZA"

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "OBJETOS DISPONIBLES"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "PRECIO"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "EFECTIVO"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "Un objeto con descuento aleatorio."

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "REABASTECER"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "Cambiar objetos (+3% de CAOS)"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "Compraste un objeto nuevo."

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "No tienes suficiente dinero."

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "¡Guau!"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "-OBJETO EN DESCUENTO-"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "Al salir, te detuviste en las máquinas expendedoras. (+2% de CAOS)"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "COMPRAR OBJETOS"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"Entrar [Cuesta CAOS]\n"
"Cambia EFECTIVO por OBJETOS"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"Entrar [Cuesta CAOS]\n"
"Recupera VIGOR y CORDURA"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "DESCANSAR"

msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "MÁQUINA EXPENDEDORA"

msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"Al entrar en la GUARIDA ILEGAL, reconociste de inmediato a la chica que te atacó y dejó caer la receta médica.\n"
"Arrojaste la medicina costosa sobre la mesa antes de acercarte.\n"
"\n"
"“¿E-es ese el medicamento para mi abuela?...” Sus ojos se iluminaron.\n"
"“Pensé que se había agotado para siempre... pero ¿por qué me ayudarías?”"

msgctxt "woh_addy:126"
msgid "explain what's currently happening"
msgstr "Explicar lo que está sucediendo"

msgctxt "woh_addy:127"
msgid "<<If what you're saying is true, I'll help you!>>"
msgstr "“Si lo que dices es cierto, ¡te ayudaré!”"

msgctxt "woh_addy:128"
msgid "<<...name's MIKU, by the way.>>"
msgstr "“...me llamo MIKU, por cierto.”"

msgctxt "woh_addy:129"
msgid "LEAVE"
msgstr "IRSE"

msgctxt "woh_addy:130"
msgid "WAIT (+2% DOOM)"
msgstr "ESPERAR (+2% de CAOS)"

msgctxt "woh_addy:131"
msgid "LATEST GOSSIP"
msgstr "CHISMES RECIENTES"

msgctxt "woh_addy:132"
msgid "ASK TO JOIN YOU"
msgstr "PEDIR QUE TE ACOMPAÑE"

msgctxt "woh_addy:133"
msgid "OBSERVE"
msgstr "OBSERVAR"

msgctxt "woh_addy:134"
msgid "SHARE A CREEPY STORY [-5 EXP]"
msgstr "COMPARTIR UNA HISTORIA TENEBROSA [-5 de EXP]"

msgctxt "woh_addy:135"
msgid "FORCE TO HELP YOU"
msgstr "FORZAR QUE TE AYUDE"

msgctxt "woh_addy:136"
msgid ""
"GOSSIP - Learn both random and case-related news.\n"
"ASK - Recruitment test based on CHARISMA (repeatable).\n"
"FORCE - Recruitment test based on equipment, STRENGTH and current DOOM"
msgstr ""
"CHISME - Aprende noticias aleatorias y relacionadas con el caso.\n"
"PEDIR - Prueba de reclutamiento basada en CARISMA (repetible).\n"
"FORZAR - Prueba de reclutamiento basada en equipamiento, FUERZA y CAOS actual."

msgctxt "woh_addy:137"
msgid "<<Sorry, I don't have time for games.>>"
msgstr "“Lo siento, no tengo tiempo para juegos.”"

msgctxt "woh_addy:138"
msgid "<<Give me a break!>>"
msgstr "“¡Dame un respiro!”"

msgctxt "woh_addy:139"
msgid "<<You were always sucha a kidder!>>"
msgstr "“¡Siempre fuiste un bromista!”"

msgctxt "woh_addy:140"
msgid "<<I will help you!>>"
msgstr "“¡Te ayudaré!”"

msgctxt "woh_addy:141"
msgid "<<It sounds strange... but I believe you!>>"
msgstr "“Suena extraño... pero ¡te creo!”"

msgctxt "woh_addy:142"
msgid "<<Did you hear? There's a cliff nearby with strangely shaped holes...>>"
msgstr "“¿Te enteraste? Hay un acantilado cerca con agujeros de formas extrañas...”"

msgctxt "woh_addy:143"
msgid "<<Have you heard about this computer program that...>>"
msgstr "“¿Has oído sobre este programa de computadora que...”"

msgctxt "woh_addy:144"
msgid "<<She hasn't come to school since last week...>>"
msgstr "“Ella no ha venido a la escuela desde la semana pasada...”"

msgctxt "woh_addy:145"
msgid "<<How did you do on your English exam?>>"
msgstr "“¿Cómo te fue en tu examen de inglés?”"

msgctxt "woh_addy:146"
msgid "<<If OOO didn't make those drawings, then who did?>>"
msgstr "“Si OOO no hizo esos dibujos, entonces ¿quién los hizo?”"

msgctxt "woh_addy:147"
msgid "<<It's been so hard to get any sleep lately.>>"
msgstr "“Últimamente ha sido muy difícil dormir.”"

msgctxt "woh_addy:148"
msgid "<<I keep hearing a wailing sound coming from the 3rd stall in the girls' bathroom.>>"
msgstr "“Sigo escuchando un lamento proveniente del tercer cubículo en el baño de las chicas.”"

msgctxt "woh_addy:149"
msgid "<<...he hasn't been the same since he came back.>>"
msgstr "“..no ha sido el mismo desde que volvió.”"

msgctxt "woh_addy:150"
msgid "<<Recently, the tap water in my entire neighborhood started tasting weird. Almost like...>>"
msgstr "“Recientemente, el agua del grifo en todo mi vecindario empezó a saber extraño. Casi como...”"

msgctxt "woh_addy:151"
msgid "<<...yesterday, she told me she saw it again.>>"
msgstr "“...ayer, ella me dijo que lo vio de nuevo.”"

msgctxt "woh_addy:152"
msgid "notices you and smiles."
msgstr "Te nota y sonríe."

msgctxt "woh_addy:153"
msgid "waves at you."
msgstr "Te saluda."

msgctxt "woh_addy:154"
msgid "<<Have you heard about this computer program that...>>"
msgstr "“¿Has oído sobre este programa de computadora que...”"

msgctxt "woh_addy:155"
msgid "<<She hasn't come to school since last week...>>"
msgstr "“Ella no ha venido a la escuela desde la semana pasada...”"

msgctxt "woh_addy:156"
msgid "<<How did you do on your English exam?>>"
msgstr "“¿Cómo te fue en tu examen de inglés?”"

msgctxt "woh_addy:157"
msgid "<<If OOO didn't make those drawings, then who did?>>"
msgstr "“Si OOO no hizo esos dibujos, entonces ¿quién los hizo?”"

msgctxt "woh_addy:158"
msgid "<<It's been so hard to get any sleep lately.>>"
msgstr "“Últimamente ha sido muy difícil dormir.”"

msgctxt "woh_addy:159"
msgid "is taking their pen apart and putting it back together over and over."
msgstr "Está desarmando su bolígrafo y volviéndolo a armar una y otra vez."

msgctxt "woh_addy:160"
msgid "is waiting for the class to begin."
msgstr "Está esperando que comience la clase."

msgctxt "woh_addy:161"
msgid "is staring at the clouds. They look like heads."
msgstr "Está mirando las nubes. Parecen cabezas."

msgctxt "woh_addy:162"
msgid "is reading a horror manga about spirals."
msgstr "Está leyendo un manga de horror sobre espirales."

msgctxt "woh_addy:163"
msgid "They seem relaxed."
msgstr "Parece relajado."

msgctxt "woh_addy:164"
msgid "They look fine."
msgstr "Parece estar bien."

msgctxt "woh_addy:165"
msgid "They look nervous."
msgstr "Parece nervioso."

msgctxt "woh_addy:166"
msgid "There is something _off_about them."
msgstr "Hay algo _extraño_ en él."

msgctxt "woh_addy:167"
msgid "They are trembling with fear."
msgstr "Está temblando de miedo."

msgctxt "woh_addy:168"
msgid "You don't know any good stories to share."
msgstr "No conoces ninguna buena historia para compartir."

msgctxt "woh_addy:169"
msgid ""
"seems visibly shaken by your story.\n"
"<<I-it's just a story, right?...>>"
msgstr ""
"Parece visiblemente afectado por tu historia.\n"
"\n"
"“E-es solo una historia, ¿verdad?...”"

msgctxt "woh_addy:170"
msgid "combined INTIMIDATION value"
msgstr "Valor de INTIMIDACIÓN combinado"

msgctxt "woh_addy:171"
msgid ""
"Student, threatened by your weapon, agrees to help you.\n"
"Don't expect them to stay loyal though."
msgstr ""
"El estudiante, amenazado por tu arma, acepta ayudarte.\n"
"No esperes que se mantenga leal."

msgctxt "woh_addy:172"
msgid ""
"Student shoves you away and escapes, screaming for help.\n"
"(+5% DOOM)"
msgstr ""
"El estudiante te empuja y escapa, gritando por ayuda.\n"
"(+5% de CAOS)"

msgctxt "woh_addy:173"
msgid "The burned down school building is empty."
msgstr "La escuela quemada está vacía."

msgctxt "woh_addy:174"
msgid "Many of the books you can find here were donated after the accident at the university building."
msgstr "Muchos de los libros que puedes encontrar aquí fueron donados tras el accidente en la universidad."

msgctxt "woh_addy:175"
msgid "LIBRARY"
msgstr "BIBLIOTECA"

msgctxt "woh_addy:176"
msgid "You feel the gaze of a librarian..."
msgstr "Sientes la mirada de una bibliotecaria..."

msgctxt "woh_addy:177"
msgid ""
"study old tomes\n"
"[+SPELL; +3% DOOM]"
msgstr "Estudiar tomos antiguos [+HECHIZO / +3% de CAOS]"

msgctxt "woh_addy:178"
msgid ""
"make notes\n"
"[+5 EXP; +2% DOOM]"
msgstr "Tomar notas [+5 de EXP / +2% de CAOS]"

msgctxt "woh_addy:179"
msgid "You carry out a few books to the main reading room..."
msgstr "Llevaste unos cuantos libros a la sala de lectura..."

msgctxt "woh_addy:180"
msgid ""
"You decide to make some notes about subjects that could be relevant in this case.\n"
"\n"
"Hopefully all your work won't go to waste.\n"
"[+5 EXPERIENCE]"
msgstr ""
"Decidiste hacer algunas notas sobre temas que podrían ser relevantes en este caso.\n"
"\n"
"Esperemos que todo tu trabajo no haya sido en vano. (+5 de EXP)"

msgctxt "woh_addy:181"
msgid "You carry out a dusty tome to the main reading room..."
msgstr "Sacaste un libro polvoriento a la sala de lectura..."

msgctxt "woh_addy:182"
msgid "return the book and go back"
msgstr "Regresar el libro y volver"

msgctxt "woh_addy:183"
msgid "return the books and exit the library"
msgstr "Devolver los libros y salir de la biblioteca"

msgctxt "woh_addy:184"
msgid ""
"Interpreting the old, incomplete translations is a tedious task.\n"
"\n"
"Finally, you find the fragment you were looking for.\n"
"[+NEW SPELL]"
msgstr ""
"Interpretar las antiguas traducciones incompletas es una tarea tediosa.\n"
"\n"
"Finalmente, encontraste el fragmento que estabas buscando. (+NUEVO HECHIZO)"

msgctxt "woh_addy:185"
msgid "[NEW ACHIEVEMENT UNLOCKED!]"
msgstr "[¡NUEVO LOGRO DESBLOQUEADO!]"

msgctxt "woh_addy:186"
msgid "The nurse treats"
msgstr "La enfermera curó"

msgctxt "woh_addy:187"
msgid ""
"<<Sorrrry dearr, a patient is herre. I'll call you back...>>\n"
"says the nurse as she's eyeing you up.\n"
"\n"
"<<How can I help you today?>>\n"
"\n"
"[ALL YOUR MINOR INJURIES ARE TREATED]"
msgstr ""
"“Perdóóóón queriido, hay un paciente aquííí. Te llamaré después...”\n"
"dice la enfermera mientras te observa.\n"
"\n"
"“¿Cómo puedo ayudarte hoy?”\n"
"\n"
"(TODAS TUS LESIONES MENORES SON CURADAS)"

msgctxt "woh_addy:188"
msgid "SCHOOL NURSE"
msgstr "ENFERMERA ESCOLAR"

msgctxt "woh_addy:189"
msgid "Younger students are afraid of her... why?"
msgstr "Los estudiantes más jóvenes le temen... ¿por qué?"

msgctxt "woh_addy:190"
msgid "The air here is noticeably colder... (+1% DOOM)"
msgstr "El aire aquí es notablemente más frío... (+1% de CAOS)"

msgctxt "woh_addy:191"
msgid "<<The history of this region is just... fascinating. Why don't you discover it for yourself?>>"
msgstr "“La historia de esta región es simplemente... fascinante. ¿Por qué no la descubres por tu cuenta?”"

msgctxt "woh_addy:192"
msgid "HISTORY CLUB"
msgstr "CLUB DE HISTORIA"

msgctxt "woh_addy:193"
msgid "Why would this popular student join this weird club?"
msgstr "¿Por qué este estudiante popular se uniría a este club extraño?"

msgctxt "woh_addy:194"
msgid "YOU ARE ALREADY THERE"
msgstr "YA ESTÁS AHÍ"

msgctxt "woh_addy:195"
