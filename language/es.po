msgctxt "woh_chal:177"
msgid "To advance this mystery, use the ENTER additional action while at the hospital to find your friend..."
msgstr "Para avanzar en este misterio, usa la acción adicional ENTRAR mientras estés en el hospital para encontrar a tu amigo..."

msgctxt "woh_chal:178"
msgid "To advance this mystery, investigate the circled location. As you progress, the location and the rules may change."
msgstr "Para avanzar en este misterio, investiga la ubicación señalada. A medida que progreses, la ubicación y las reglas pueden cambiar."

msgctxt "woh_chara:0"
msgid "eng"
msgstr "esp"

msgctxt "woh_chara:1"
msgid "WORLD OF HORROR"
msgstr "MUNDO DE HORROR"

msgctxt "woh_chara:2"
msgid "<<At the beginning, no one had any idea what we were up against.>>"
msgstr "“Al comienzo, nadie tenía idea de a qué nos enfrentábamos.”"

msgctxt "woh_chara:3"
msgid "[NO EFFECT]"
msgstr "[SIN EFECTO]"

msgctxt "woh_chara:4"
msgid "MEDICAL HISTORY"
msgstr "HISTORIAL MÉDICO"

msgctxt "woh_chara:5"
msgid "<<Brittle bones run in your family and you've spent each summer in a cast.>>"
msgstr "“Huesos frágiles son hereditarios en tu familia y has pasado cada verano enyesado.”"

msgctxt "woh_chara:6"
msgid "[you start with extra EXP and BANDAGES but an INJURY may occur whenever the player takes damage in combat]"
msgstr "[Empiezas con EXP extra y VENDAS, pero puede ocurrir una LESIÓN cada vez que el jugador reciba daño en combate]"

msgctxt "woh_chara:7"
msgid "HUNTED BY THE CULT"
msgstr "PERSEGUIDO POR EL CULTO"

msgctxt "woh_chara:8"
msgid "<<You've managed to run from them once, but the cult is tireless...>>"
msgstr "“Lograste huir de ellos una vez, pero el culto no descansa...”"

msgctxt "woh_chara:9"
msgid "[solving mysteries reduces more DOOM but you get more unique combat encounters]"
msgstr "[Resolver misterios reduce más el CAOS, pero tendrás más encuentros de combate únicos]"

msgctxt "woh_chara:10"
msgid "THE SEVENTH CURSE"
msgstr "LA SÉPTIMA MALDICIÓN"

msgctxt "woh_chara:11"
msgid "<<Your family was cursed. Everyone around you will die...>>"
msgstr "“Tu familia está maldita. Todos a tu alrededor morirán...”"

msgctxt "woh_chara:12"
msgid "[you start the playthrough with more FUNDS but can't have any HUMAN allies]"
msgstr "[Empiezas la partida con más EFECTIVO, pero no puedes tener aliados HUMANOS]"

msgctxt "woh_chara:13"
msgid "ILL-FATED"
msgstr "DESAFORTUNADO"

msgctxt "woh_chara:14"
msgid "<<You were born under a bad moon...>>"
msgstr "“Naciste bajo una luna maldita...”"

msgctxt "woh_chara:15"
msgid "[all event skill checks automatically fail]"
msgstr "[Todos los chequeos de habilidades en eventos fallan automáticamente]"

msgctxt "woh_chara:16"
msgid "KNIGHT-ERRANT"
msgstr "CABALLERO ERRANTE"

msgctxt "woh_chara:17"
msgid "<<Only I can save our town...>>"
msgstr "“Solo yo puedo salvar nuestra ciudad...”"

msgctxt "woh_chara:18"
msgid "[receive a major penalty each time you complete a mystery with a sub-A ending]"
msgstr "[Recibes una gran penalización cada vez que completes un misterio con un final sub-A]"

msgctxt "woh_chara:19"
msgid "SCARS"
msgstr "CICATRICES"

msgctxt "woh_chara:20"
msgid "<<I've made it through hell and back, you won't break me now.>>"
msgstr "“He pasado por el infierno y regresado, no me doblegarás ahora.”"

msgctxt "woh_chara:21"
msgid "[lowers incoming damage by 1, drastically lowers MAX STAMINA and REASON]"
msgstr "[Reduce el daño recibido en 1, reduce drásticamente el VIGOR y la CORDURA MÁXIMAS]"

msgctxt "woh_chara:22"
msgid "CURIOUS BIRTHMARK"
msgstr "MARCA DE NACIMIENTO CURIOSA"

msgctxt "woh_chara:23"
msgid "<<Doctor, if it looks 'fine', please explain to me, why is it changing its shape?>>"
msgstr "“Doctor, si está 'bien', por favor explíqueme, ¿por qué está cambiando de forma?”"

msgctxt "woh_chara:24"
msgid "[any damage taken in combat can cause a CURSE]"
msgstr "[Cualquier daño recibido en combate puede causar una MALDICIÓN]"

msgctxt "woh_chara:25"
msgid "ELDRITCH PARASITE"
msgstr "PARÁSITO ÉLDRICO"

msgctxt "woh_chara:26"
msgid "<<Something is... growing inside me.>>"
msgstr "“Algo está... creciendo dentro de mí.”"

msgctxt "woh_chara:27"
msgid "[you start with extra STAMINA and REASON but can't regain them]"
msgstr "[Empiezas con VIGOR y CORDURA extra pero no puedes recuperarlas]"

msgctxt "woh_chara:28"
msgid "FATALIST"
msgstr "FATALISTA"

msgctxt "woh_chara:29"
msgid "<<It's... pointless, I can't change my fate...>>"
msgstr "“Es... inútil, no puedo cambiar mi destino...”"

msgctxt "woh_chara:30"
msgid "[you must solve the mysteries in the order they appear on the board]"
msgstr "[Debes resolver los misterios en el orden en que aparecen en la pizarra]"

