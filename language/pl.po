msgid "<<your equipment looks battered and fragile...>>"
msgstr "<<Twój ekwipunek wygląda na zniszczony i kruchy...>>"

msgctxt "woh_nana:488"
msgid "To complete: discard an item"
msgstr "Aby ukończyć: odrzuć przedmiot"

msgctxt "woh_nana:489"
msgid "CONSPIRACY OF BLOOD"
msgstr "SPISEK KRWI"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:490"
msgid "<<they injected you with something when you were a kid...>>"
msgstr "<<wstrzyknięto ci coś, gdy byłeś dzieckiem...>>"

msgctxt "woh_nana:491"
msgid "To complete: visit a doctor"
msgstr "Aby ukończyć: udaj się do lekarza"

msgctxt "woh_nana:492"
msgid "CONSPIRACY OF TRUST"
msgstr "SPISEK ZAUFANIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:493"
msgid "<<you can't trust anyone...>>"
msgstr "<<nie możesz ufać nikomu...>>"

msgctxt "woh_nana:494"
msgid "To complete: let one ally go or have no allies at the end of a mystery"
msgstr "Aby ukończyć: pozwól odejść jednemu sojusznikowi lub nie miej żadnych sojuszników na końcu tajemnicy"

msgctxt "woh_nana:495"
msgid "CONSPIRACY OF TIME"
msgstr "SPISEK CZASU"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:496"
msgid "<<they want you to waste time on meaningless stuff...>>"
msgstr "<<chcą, żebyś tracił czas na bezsensowne rzeczy...>>"

msgctxt "woh_nana:497"
msgid "To complete: don't finish a sidequest"
msgstr "Aby ukończyć: nie kończ zadania pobocznego"

msgctxt "woh_nana:498"
msgid "CONSPIRACY OF FEAR"
msgstr "SPISEK STRACHU"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:499"
msgid "<<you can't let anyone stop you...>>"
msgstr "<<nie możesz pozwolić, by ktokolwiek cię powstrzymał...>>"

msgctxt "woh_nana:500"
msgid "To complete: escape from combat"
msgstr "Aby ukończyć: ucieknij z walki"

msgctxt "woh_nana:501"
msgid "CONSPIRACY OF GREED"
msgstr "SPISEK CHCIWOŚCI"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:502"
msgid "<<you must prepare yourself for the worst...>>"
msgstr "<<musisz przygotować się na najgorsze...>>"

msgctxt "woh_nana:503"
msgid "To complete: buy an item"
msgstr "Aby ukończyć: kup przedmiot"

msgctxt "woh_nana:504"
msgid "CONSPIRACY OF RUMORS"
msgstr "SPISEK PLOTEK"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:505"
msgid "<<they know something you don't...>>"
msgstr "<<oni wiedzą coś, czego ty nie wiesz...>>"

msgctxt "woh_nana:506"
msgid "To complete: ask for gossip"
msgstr "Aby ukończyć: zapytaj o plotki"

