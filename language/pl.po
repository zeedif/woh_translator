msgstr "-2 WYTRZYMAŁOŚć po rozwiązaniu każdej zagadki"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:538"
msgid "<<it can't be...>>"
msgstr "<<To niemożliwe...>>"

