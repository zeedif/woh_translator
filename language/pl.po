msgstr "każdy atak wroga dodaje -1 do WYTRZYMAŁOŚCI"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:532"
msgid "<<it hurts like hell>>"
msgstr "<<boli jak diabli>>"

msgctxt "woh_nana:533"
msgid "MELANCHOLIA"
msgstr "MELANCHOLIA"

msgctxt "woh_nana:534"
msgid "-2 REASON after completing each mystery"
msgstr "-2 do ROZSĄDKU po rozwiązaniu każdej zagadki"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_nana:535"
msgid "<<it's hopeless!>>"
msgstr "<<to beznadziejne!>>"

msgctxt "woh_nana:536"
msgid "PRIMAL FEAR"
msgstr "PIERWOTNY STRACH"

msgctxt "woh_nana:537"
