msgctxt "woh_dec:15"
msgid "<<...he's not real...>>"
msgstr "<<...on nie jest prawdziwy...>>"

msgctxt "woh_dec:16"
msgid "FLASHBACKS"
msgstr "RETROSPEKCJE"

msgctxt "woh_dec:17"
msgid ""
"-2 DEXTERITY\n"
"(discard): +4% DOOM"
msgstr ""
"-2 ZRĘCZNOŚĆ\n"
"(odrzuć): +4% ZAGŁADA"

