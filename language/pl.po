msgid "[+ITEM]"
msgstr "[+PRZEDMIOT]"

msgctxt "woh_chal:149"
msgid "[+MEDICAL KIT]"
msgstr "[+ZESTAW MEDYCZNY]"

msgctxt "woh_chal:150"
msgid "[+SPELL]"
msgstr "[+ZAKLĘCIE]"

