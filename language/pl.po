msgid "SKIP SUITCASE SCREEN: ON/OFF"
msgstr "POMIŃ EKRAN Z WALIZKĄ: WŁ./WYŁ."

msgctxt "woh_halo:83"
msgid ""
"SKIP CARD PACK SCREEN: ON/OFF\n"
"(all packs enabled)"
msgstr ""
"POMIŃ EKRAN Z PACZKAMI KART: WŁ./WYŁ.\n"
