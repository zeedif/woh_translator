msgid "MULTIPLY WOUND"
msgstr "ZWIELOKROTNIENIE RAN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:27"
msgid ""
"deals damage to an enemy, which increases the lower your STAMINA is\n"
"[COST: 2 STAMINA]"
msgstr ""
"zadaje wrogowi obrażenia, które zwiększają się, im niższa jest twoja KONDYCJA\n"
"[KOSZT: 2 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:28"
msgid "The wounds of your enemy explode with gore!"
msgstr "Rany przeciwnika buchają krwawymi fontannami!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:29"
msgid "K'NPHA RITUAL"
msgstr "RYTUAŁ K'NPHA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:30"
msgid ""
"when your allies die, a random STAT gets raised by 1\n"
"[COST: 2 REASON]"
msgstr ""
"kiedy twoi sprzymierzeńcy umierają, losowa CECHA zostaje podniesiona o 1\n"
"[KOSZT: 2 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:31"
msgid "Part of your ally's essence stays with you!"
msgstr "Część esencji twojego sprzymierzeńca zostaje z tobą!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:32"
msgid ""
"K'NPHA RITUAL\n"
"[allies -> stats]"
msgstr ""
"RYTUAŁ K'NPHA\n"
"[sprzymierzeńcy -> cechy]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:33"
msgid "INVISIBILITY"
msgstr "NIEWIDZIALNOŚĆ"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:34"
msgid ""
"until the end of the current mystery, there is no DOOM penalty for escaping from combat\n"
"[COST: 4 REASON]"
msgstr ""
"do końca bieżącej tajemnicy, ucieczka z walki nie podnosi ZAGŁADY\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:35"
msgid "You shift into the shadow realm!"
msgstr "Przechodzisz do strefy cienia!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:36"
msgid "You are already invisible!"
msgstr "Znajdujesz się już w strefie cienia!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:37"
msgid "ABOLISH"
msgstr "ZNIESIENIE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:38"
msgid ""
"lowers ELDRITCH enemy DAMAGE by 1\n"
"[COST: 3 STAMINA]"
msgstr ""
"obniża obrażenia UPIORNEGO wroga o 1\n"
"[KOSZT: 3 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:39"
msgid "A magic barrier appears, absorbing the damage!"
msgstr "Magiczna bariera pochłaniająca obrażenia pojawia się między wami!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:40"
msgid "Additional barriers won't help!"
msgstr "Kolejne bariery nie będą już pomocne!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:41"
msgid "ABSORB"
msgstr "POCHŁONIĘCIE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:42"
msgid ""
"deals 3 damage, gain 2 STAMINA\n"
"[COST: 4 REASON]"
msgstr ""
"zadaje 3 obrażenia, zyskujesz 2 KONDYCJI\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:43"
msgid "You suck the life force out of your enemy!"
msgstr "Wysysasz siły życiowe ze swojego wroga!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:44"
msgid "THIRD EYE"
msgstr "TRZECIE OKO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:45"
msgid ""
"+1 KNOWLEDGE and PERCEPTION until the end of the mystery\n"
"[effect doesn't stack]\n"
"[COST: 3 REASON]"
msgstr ""
"+1 do WIEDZY i PERCEPCJI do końca tajemnicy\n"
"[efekt nie kumuluje się]\n"
"[KOSZT: 3 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:46"
msgid "You can feel your inner eye open!"
msgstr "Czujesz, jak twoje wewnętrzne oko się otwiera!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:47"
msgid "You wouldn't want a fourth eye, would you?"
msgstr "Nie chciałbyś mieć czwartego oka, prawda?"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:48"
msgid "ITHOTU FLAME"
msgstr "PŁOMIEŃ ITHOTU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:49"
msgid ""
"deals 8 damage\n"
"+2% DOOM\n"
"[COST: 1 REASON]\n"
"[COST: 1 STAMINA]"
msgstr ""
"zadaje 8 obrażeń\n"
"+2% ZAGŁADY\n"
"[KOSZT: 1 ROZSĄEK]\n"
"[KOSZT: 1 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:50"
msgid "A column of fire engulfs the enemy!"
msgstr "Kolumna żywego ognia pochłania wroga!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:51"
msgid "SEAL OF SAVVESH"
msgstr "PIECZĘĆ SAVVESHA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:52"
msgid ""
"+1 STRENGTH\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 SIŁA\n"
"[odrzuć po użyciu]\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:53"
msgid "A new seal appears on your skin!"
msgstr "Na twojej skórze pojawia się nowa pieczęć!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:54"
msgid "SEAL OF BRAM'EL"
msgstr "PIECZĘĆ BRAM'ELA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:55"
msgid ""
"+1 KNOWLEDGE\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 WIEDZA\n"
"[odrzuć przy użyciu]\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:56"
msgid "THREAD OF FATE"
msgstr "NIĆ PRZEZNACZENIA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:57"
msgid ""
"defeat target HUMAN enemy\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"pokonaj wybranego LUDZKIEGO wroga\n"
"[odrzuć przy użyciu]\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:58"
msgid "Enemy falls to the ground, dead."
msgstr "Wróg pada na ziemię, martwy."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:59"
msgid "ANCESTRAL STRENGTH"
msgstr "PRADAWNA POTĘGA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:60"
msgid ""
"+1 DAMAGE\n"
"[COST: 4 REASON]"
msgstr ""
"+1 do zadawanych OBRAŻEŃ\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:61"
msgid "Someone is guiding your moves..."
msgstr "Ktoś prowadzi twoje uderzenia..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:62"
msgid ""
"ANCESTRAL STRENGTH\n"
"[+1 DAMAGE]"
msgstr ""
"PRADAWNA POTĘGA\n"
"[+1 do OBRAŻEŃ]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:63"
msgid "ENTHRALLMENT"
msgstr "ENFROLMACJA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:64"
msgid ""
"gain an additional follower\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"zyskaj dodatkowego sprzymierzeńca\n"
"[odrzuć po użyciu]\n"
"[KOSZT: 4 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:65"
msgid "A new person follows your lead..."
msgstr "Nowy sprzymierzeńca rusza twoim śladem..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:66"
msgid "AWAKEN"
msgstr "PRZEBUDZENIE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:67"
msgid ""
"gain a permanent boost of two randomly selected stats\n"
"[COST: 10% DOOM]"
msgstr ""
"zyskujesz stałe wzmocnienie dwóch losowo wybranych cech\n"
"[KOSZT: 10% ZAGŁADY]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:68"
msgid "You've attracted the attention of something evil..."
msgstr "Zwrócono uwagę czegoś piekielnego..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:69"
msgid "BINDING AGONY"
msgstr "WIĘŻĄCA AGONIA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:70"
msgid ""
"target enemy's damage is lowered by 1\n"
"[COST: 3 REASON]"
msgstr ""
"obrażenia zadawane przez przeciwnika zostają zmniejszone o 1\n"
"[KOSZT: 3 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:71"
msgid "BINDING AGONY makes their movement slower!"
msgstr "WIĘŻĄCA AGONIA sprawia, że poruszają się wolniej!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:72"
msgid "WITNESS CURSE"
msgstr "PRZEKLEŃSTWO ŚWIADECTWA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:73"
msgid ""
"converts all combat STAMINA damage taken into extra DOOM\n"
"[COST: 2 REASON]"
msgstr ""
"zamienia wszystkie otrzymane w walce obrażenia KONDYCJI na dodatkową ZAGŁADĘ\n"
"[KOSZT: 2 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:74"
msgid ""
"WITNESS CURSE\n"
"[- STAMINA -> + DOOM]"
msgstr ""
"PRZEKLEŃSTWO ŚWIADECTWA\n"
"[- KONDYCJA-> + ZAGŁADA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:75"
msgid "SHADOW SHROUD"
msgstr "CIENISTY CAŁUN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:76"
msgid ""
"for the duration of this mystery, ignore location's THREAT level\n"
"[COST: 3 REASON]"
msgstr ""
"na czas trwania tej tajemnicy poziom ZAGROŻENIA lokacji będzie ignorowany\n"
"[KOSZT: 3 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:77"
msgid "You feel more in tune with the weird..."
msgstr "Ponura aura przepływa przez twoje ciało..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:78"
msgid "MEND"
msgstr "UZDROWIENIE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:79"
msgid ""
"gain 1 REASON\n"
"[COST: 2 STAMINA]"
msgstr ""
"ZYSKUJESZ 1 ROZSĄDEK\n"
"[KOSZT: 2 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:80"
msgid "You regain some of the lost REASON."
msgstr "Odzyskujesz część utraconego ROZSĄDKU."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:81"
msgid "VOID"
msgstr "PUSTKA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «VOID» (woh_spell:81).
msgctxt "woh_spell:82"
msgid ""
"ignore the current event and instantly investigate a random OTHERWORLD location\n"
"[one time use only]\n"
"[COST: 3 REASON]"
msgstr ""
"zignoruj bieżące wydarzenie i natychmiast zbadaj losową lokalizację w INNYM ŚWIECIE\n"
"[jednorazowe użycie]\n"
"[KOSZT: 3 ROZSĄDEK]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:83"
msgid "CAUTERIZE"
msgstr "KAUTERYZACJA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:84"
msgid ""
"+2 STAMINA\n"
"[one time use only]"
msgstr ""
"+2 KONDYCJA\n"
"[tylko jednorazowe użycie]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «VOID» (woh_spell:81).
msgctxt "woh_spell:85"
msgid "The torn flesh closes, stopping the bleeding."
msgstr "Rozdarte ciało zasklepia się, tamując krwawienie."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:86"
msgid "MEMORY EXTRACT"
msgstr "WYCIĄGNIĘCIE PAMIĘCI"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:87"
msgid ""
"+2 REASON\n"
"[COST: 10 EXP]"
msgstr ""
"+2 ROZSĄDEK\n"
"[KOSZT: 10 DŚW]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:88"
msgid "Traumatic memories leave your mind..."
msgstr "Traumatyczne wspomnienia odpływają z twojego umysłu..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:89"
msgid "This spell requires more EXPERIENCE."
msgstr "To zaklęcie wymaga więcej DOŚWIADCZENIA."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:90"
msgid "ASHEN CONTRACT"
msgstr "SPOPIELONY KONTRAKT"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:91"
msgid ""
"immediately kills any non-eldritch enemy\n"
"[one time use only]\n"
"[COST: 7% DOOM]"
msgstr ""
"natychmiast zabija każdego nie-UPIORNEGO wroga\n"
"[jednorazowe użycie]\n"
"[KOSZT: 7% ZAGŁADY]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:92"
msgid "It is done."
msgstr "Wykonano."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:93"
msgid "MIDASU TOUCH"
msgstr "DOTYK MIDASU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:94"
msgid ""
"+1 FUNDS\n"
"[COST: 2 STAMINA]"
msgstr ""
"+1 FUNDUSZE\n"
"[KOSZT: 2 KONDYCJI]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:95"
msgid "Your fingernail turns silver, you rip it off!"
msgstr "Jeden z twoich paznokci staje się srebrny, a ty go zrywasz!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:96"
msgid "Your tooth turns to gold, you twist it off!"
msgstr "Jeden z twoich zębów zamienia się w złoto, wyrywasz go!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:97"
msgid "FLESH REGROWTH"
msgstr "ODRASTANIE MIĘSA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:98"
msgid ""
"+3 STAMINA\n"
"-2 MAX STAMINA"
msgstr ""
"+3 KONDYCJI\n"
"-2 MAKSYMALNEJ KONDYCJI"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:99"
msgid "Your veins extend and seal the ripped flesh!"
msgstr "Twoje żyły rozciągają się i pieczętują rozszarpane ciało!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:100"
msgid "EXPEL EVIL"
msgstr "WYPĘDZENIE ZŁA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:101"
msgid ""
"-6% DOOM\n"
"[one time use only]\n"
"[COST: 2 STAMINA]"
msgstr ""
"-6% ZAGŁADY\n"
"[jednorazowe użycie]\n"
"[KOSZT: 2 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:102"
msgid "You cough up blood and... s-something else..."
msgstr "Odkrztuszasz krwią i... czymś jeszcze..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:103"
msgid "GROW TEETH"
msgstr "ROZROST ZĘBÓW"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:104"
msgid ""
"adds a new combat action, [BITE], until the end of this mystery\n"
"[COST: 2 STAMINA]"
msgstr ""
"dodaje nową akcję bojową, [GRYŹ], do końca tej tajemnicy\n"
"[KOSZT: 2 KONDYCJA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:105"
msgid "You cough up blood and... something else..."
msgstr "Odkrztuszasz krwią i... czymś jeszcze..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:106"
msgid "You won't fit more teeth in your mouth."
msgstr "Nie zmieścisz w ustach już więcej zębów."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:107"
msgid "BRAIN WORMS"
msgstr "ROBAKI MÓZGOWE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:108"
msgid ""
"-2% DOOM\n"
"[one time use only]\n"
"[COST: 2 STAMINA]\n"
"[forgetting this SPELL costs 2 REASON]"
msgstr ""
"-2% ZAGŁADY\n"
"[jednorazowe użycie]\n"
"[KOSZT: 2 KONDYCJA]\n"
"[zapomnienie tego zaklęcia kosztuje 2 ROZSĄDKU]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «BRAIN WORMS» (woh_spell:107). Opciones: [DELVED TOO DEEP].
msgctxt "woh_spell:109"
