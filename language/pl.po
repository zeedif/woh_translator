msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "Odzyskujesz przemiot ze schowka!"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "Zbyt mało miejsca na przedmiot"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "SCHOWEK"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "SKŁADOWANE PRZEDMIOTY"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "Zbyt mało miejsca! Przedmiot dodany do schowka!"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "By zdobyć nowy poziom, naciśnij migający przycisk."

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "Nie masz wystarczająco dużo doświadczenia."

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "POROZMAWIAJ ZE STUDENTKĄ"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "ROZSTAW TELESKOP"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "POWRÓT"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "Nie masz teleskopu."

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "Studentka coś do siebie mamrocze."

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "Powinieneś raczej zostawić ją w spokoju."

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr "Zimna woda pomaga Ci zorganizować myśli (+1 ROZSĄDEK)"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr "Gorąca woda koi obolałe mięśnie (+1 KONDYCJA)"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"Przybicie słomianej lalki do drzewa spełni Twoje życzenie...\n"
"\n"
"nie za darmo, oczywiście."

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[możesz tutaj przybić jeszcze dwie słomiane lalki}"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[możesz tutaj przybić jeszcze jedną słomianą lalkę]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"Nie powinieneś/powinnaś tu więcej przychodzić.\n"
"(+ZAGŁADA)"

msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "DRZEWO WIEDŹMY"

msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "Legenda głosi że korzenie drzewa ciągną się do grobu zlinczowanej wiedźmy..."

msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr "Zauważasz portfel ukryty pod gałęziami.(+2 FUNDUSZE)"

msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "Pogrzebana wiedźma odbiera swą zapłatę..."

msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "Twą głowę wypełniają zapomniane pieśni!"

msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr "Nagle czujesz się zdecydowanie lepiej! (+2 KONDYCJA)"

msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr ""
"życzenie siły\n"
"[+2 KONDYCJA]"

msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr ""
"życzenie wiedzy\n"
"[+ZAKLĘCIE]"

msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr ""
"życzenie fortuny\n"
"[+2 FUNDUSZE]"

msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr ""
"to zły pomysł\n"
"[wyjdź]"

msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"Zatrzymuje cię młoda policjantka.\n"
"\n"
"<<Jak możemy Ci pomóc?>>"

msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "KOMENDA POLICJI"

msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "Policjanci na komendzie są zajęci pracą nad różnymi dziwnymi sprawami..."

msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "Poproś o więcej policyjnych patroli."

msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "Narzekaj na patrole policyjne"

msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr ""
"podziel się informacjami\n"
"(11 DOŚWIADCZENIE-> 1 FUNDUSZE)"

msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "Wyjdź z komendy."

msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"Funkcjonariusz dziękuje Ci i obiecuje więcej patroli policyjnych.\n"
"[Poziom Zagrożenia zmniejszony]"

msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "Funkcjonariusz przeprasza i mówi że nie mają już więcej wolnych patroli."

msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr ""
"Detektyw dziękuje Ci za informację i daje Ci nagrodę.\n"
"[-11 DOŚW/+1 FUNDUSZE]"

msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "Detektyw dziękuje za informację ale mówi że to zbyt mało by otrzymać nagrodę."

msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"W końcu docierasz do środka przeklętej latarni morskiej!\n"
"\n"
"Twoje przeczucie mówi Ci dwie rzeczy: ktokolwiek (lub cokolwiek) stoi za tymi dziwnymi wydarzenami, musi być na ostatnim piętrze i że należy uciekać tak daleko i szybko jak się da. Boisz się że nie będzie już powrotu gdy zaczniesz się wspinać po schodach..."

msgctxt "woh_addy:41"
msgid "access storage"
msgstr "schowek na przedmioty"

msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "odpocznij chwilę (+2% ZAGŁADA)"

msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "zacznij się wspinać"

msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr "Chwila na odpoczynek. (+1 ROZSĄDEK oraz KONDYCJA)"

msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "LATARNIA MORSKA (PARTER)"

msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr "Gdy nadnaturalna mgła się podnosi czujesz lekkość i upadasz na podłogę.."

msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"Czarne chmury wiją się wokół latarni morskiej.\n"
"Czy jest już za późno?"

msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "MONUMENT"

msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "Zapomiany przez wszystkich, BYT Z POZA ŚWIATA czeka cierpliwie na tych, którzy go potrzebują..."

msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr ""
"wyjdź bez składania ofiary \n"
"[rozgniewa BYT Z POZA ŚWIATA]"

msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "Nacinasz swą dłoń i napełniasz misę swoją krwią..."

msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "Czujesz jak najcenniejsze ze wspomnień Cię opuszczają..."

msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "Spalasz pieniądze w misie..."

msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "Rozgniewałeś/Rozgniewałaś BYT Z POZA ŚWIATA..."

msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "Targowanie się z BYTEM Z POZA ŚWIATA jest ryzykowne jednak może zahamuje nadciągającą zagładę?"

msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "nakarm BYT Z POZA ŚWIATA swoją krwią"

msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr "oddaj BYTOWI Z POZA ŚWIATA swoje najcenniejsze wspomnienia"

msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "zostaw materialny podarunek"

msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "Nadal masz nieco czasu zanim poproszą Cię do gabinetu."

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "RECEPCJA"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "Czekasz cierpliwie w recepcji."

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "Wielu chorych czeka na bycie przebadanym przez przepracowany personel szpitala."

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "wejdź do GABINETU DOKTORA (+2% ZAGŁADY)"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "przemieść się do KORYTARZA A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr ""
"wejdź do APTEKI\n"
"(+3% ZAGŁADY)"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "Pielęgniarka mija Cię w pośpiechu."

msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "GABINET DOKTORA"

msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "Oddział ratunkowy jest zatłoczony, co jest bezpośrednim wynikiem dziwnych rzeczy które dzieją się w mieście."

msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"Nareszcie poproszono Cię do gabinetu doktora.\n"
"\n"
"<< Tak więc... w czym problem?>>"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "WYJŚCIE"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[DODATKOWE DZIAŁANIA DOSTĘPNE NA KARTACH OBRAŻEŃ]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "Wykorzystujesz okazję i kradniesz opakowanie tabletek."

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "Lepiej nie ryzykować kradzieży kolejnego opakowania."

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "Czaszka szczerzy się do Ciebie ponuro."

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "KORYTARZ A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "Ruszasz dalej korytarzem..."

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "powrót do RECEPCJI"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "weź WINDĘ"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "wejdź do KOSTNICY"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "Co tutaj robisz?"

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "Drzwi do kostnicy są zamknięte."

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "KORYTARZ B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "Jest tu przerażająco cicho w porównaniu do pierwszego piętra..."

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "sprawdź SALĘ CHORYCH"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "Mądrzej będzie nie zawracać głowy pacjentom, którzy wracają do zdrowia."

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "ODPOCZYNEK W DOMU"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "Naprawdę świetnie wrócić do domu."

msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "KONDYCJA/ROZSĄDEK"

msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "Czas mija szybko, pora kontynuować śledztwo."

msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "ZAGŁADA"

msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "KONDYCJA/ROZSĄDEK"

msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"Czekaj... co to było?\n"
"[COŚ ZŁEGO WIE GDZIE MIESZKASZ]"

msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "Ucinasz szybką drzemkę na łóżku."

msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "Bandażujesz świeże rany."

msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "Bierzesz długi gorący prysznic."

msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "Połykasz środki przeciwbólowe."

msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "Dzwonisz do najlepszego przyjaciela porozmawiać o bzdurach."

msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "Siadasz na kanapie i czytasz ulubioną książkę."

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "KORYTARZ APARTAMENTU"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "Pukasz do drzwi przyjaciela i czekasz..."

msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr "<<Hej głąbie, jestem z Tobą. Czego chcesz z mojego mieszkania?>>"

msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr ""
"<<Hejjj... mam teraz urwanie głowy.\n"
"Wyskoczymy gdzieś następnym razem, ok?>>"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"Hmm, KANY nie ma w domu.\n"
"\n"
"Musisz sprawdzić później..."

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "Wizyta w sklepie zabiera cenny czas. (+4% ZAGŁADY)"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "Huh...gdzie się podział ten pies?"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "ZAKUP PRZEDMIOTÓW"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "WYJDŹ BEZ KUPOWANIA NICZEGO"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "wymaga KARTY YAKUZY"

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "DOSTĘPNE PRZEDMIOTY"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "CENA"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "FUNDUSZE"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "Losowy przedmiot z wyprzedaży. "

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "UZUPEŁNIENIE ZAPASÓW"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "nowy asortyment (+3% ZAGŁADA)"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "Zakupiono nowy przedmiot."

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "Nie masz wystarczająco pieniędzy."

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "Hau!-"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "-WYPRZEDAŻ-"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "Wychodząc, zatrzymujesz się przy automatach z napojami. (+2% ZAGŁADY)"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "ZAKUP PRZEDMIOTÓW"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"[wejście kosztuje ZAGŁADĘ]\n"
"[fundusze-> przedmioty]"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"[wejście kosztuje ZAGŁADĘ]\n"
"[odzyskaj zdrowie]"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "ODPOCZYNEK"

msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "AUTOMAT Z NAPOJAMI"

msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"Wchodząc do NIELEGALNEJ MELINY, odrazu rozponajesz dziewczynę która Cię zaatakowała i upuściła receptę.\n"
"Rzucasz drogi lek na stół zanim się zbliżysz.\n"
"\n"
"<<Cz-czy to lek dla mojej babci?...>> Jej oczy zabłysły.\n"
"<<Myślałam że zaginą na zawsze..ale dlaczego chcesz mi pomóc?>>"

msgctxt "woh_addy:126"
msgid "explain what's currently happening"
msgstr "wytłumacz co się teraz dzieje"

msgctxt "woh_addy:127"
msgid "<<If what you're saying is true, I'll help you!>>"
msgstr "<<jeżeli to co mówisz jest prawdą, pomogę Ci!>>"

msgctxt "woh_addy:128"
msgid "<<...name's MIKU, by the way.>>"
msgstr "<<...mam na imię MIKU, tak ogólnie.>>"

msgctxt "woh_addy:129"
msgid "LEAVE"
msgstr "WYJDŹ"

msgctxt "woh_addy:130"
msgid "WAIT (+2% DOOM)"
msgstr "ZACZEKAJ (+2 ZAGŁADA)"

msgctxt "woh_addy:131"
msgid "LATEST GOSSIP"
msgstr "OSTATNIE PLOTKI"

msgctxt "woh_addy:132"
msgid "ASK TO JOIN YOU"
msgstr "POPROŚ O DOŁĄCZENIE DO CIEBIE"

msgctxt "woh_addy:133"
msgid "OBSERVE"
msgstr "OBSERWUJ"

msgctxt "woh_addy:134"
msgid "SHARE A CREEPY STORY [-5 EXP]"
msgstr "PODZIEL SIĘ STRASZNĄ OPOWIEŚCIĄ [-5 DOŚW]"

msgctxt "woh_addy:135"
msgid "FORCE TO HELP YOU"
msgstr "ZMUŚ DO POMOCY "

msgctxt "woh_addy:136"
msgid ""
"GOSSIP - Learn both random and case-related news.\n"
"ASK - Recruitment test based on CHARISMA (repeatable).\n"
"FORCE - Recruitment test based on equipment, STRENGTH and current DOOM"
msgstr ""
"PLOTKI - Poznaj zarówno losowe jak i związane ze sprawą informacje.\n"
"ZAPYTAJ- Test werbunku oparty na CHARYZMIE(powtarzalne).\n"
"SIŁOWO- Test werbunku oparty na wyposażeniu, SILE oraz obecnej ZAGŁADZIE"

msgctxt "woh_addy:137"
msgid "<<Sorry, I don't have time for games.>>"
msgstr "<<Wybacz ale nie mam czasu na gierki.>>"

msgctxt "woh_addy:138"
msgid "<<Give me a break!>>"
msgstr "<<Daj mi spokój!>>"

msgctxt "woh_addy:139"
msgid "<<You were always sucha a kidder!>>"
msgstr "<<Zawsze byłeś/byłaś żartownisiem>>"

msgctxt "woh_addy:140"
msgid "<<I will help you!>>"
msgstr "<<Pomogę Ci!>>"

msgctxt "woh_addy:141"
msgid "<<It sounds strange... but I believe you!>>"
msgstr "<<To brzmi dziwnie...ale Ci wieżę!>>"

msgctxt "woh_addy:142"
msgid "<<Did you hear? There's a cliff nearby with strangely shaped holes...>>"
msgstr "<<Doszły Cię słuchy? W pobliżu jest klif z dziwnie ukształtowanymi otworami...>>"

msgctxt "woh_addy:143"
msgid "<<Have you heard about this computer program that...>>"
msgstr "<<Słyszeliście o tym dziwnym programie komputerowym, który...>>"

