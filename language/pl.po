msgid "You feel the gaze of a librarian..."
msgstr "Czujesz wzrok bibliotekarza."

msgctxt "woh_addy:177"
msgid ""
"study old tomes\n"
"[+SPELL; +3% DOOM]"
msgstr ""
"studiuj stare tomy\n"
"[+ZAKLĘCIE;+3% ZAGŁADA]"

