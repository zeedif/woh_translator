msgctxt "woh_halo:0"
msgid "PREPARING FOR INVESTIGATION"
msgstr "PRZYGOTOWANIE DO ŚLEDZTWA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:1"
msgid "<<Is there even anything useful left?>>"
msgstr "<<Czy zostało jeszcze coś użytecznego?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:2"
msgid "PREPARE"
msgstr "PRZYGOTOWANIA"

#. Descripción de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:3"
msgid "Looking carefully, you can find character-unique items to help you."
msgstr "Rozglądając się uważnie, może znajdziesz wyjątkowy dla swojej postaci przedmiot."

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:4"
msgid ""
"[costs DOOM to enter]\n"
"[unique items]"
msgstr ""
"[kosztuje ZAGŁADĘ, aby wejść]\n"
"[unikalne przedmioty]"

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:5"
msgid "KIRIE'S BAG"
msgstr "TORBA KIRIE"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:6"
msgid "(while in inventory): forgetting SPELLS lowers REASON by 1-2 and increases DOOM by 1%, gain a random SPELL"
msgstr "(gdy w ekwipunku): zapomnienie CZARÓW obniża ROZSĄDEK o 1-2 i zwiększa ZAGŁADĘ o 1% ale zyskujesz losowy CZAR."

#. Parte de «PREPARE» (woh_halo:2).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:7"
msgid "<<I've been collecting these notes for quite some time now.>>"
msgstr "<<Zbierałam te notatki już od dłuższego czasu.>>"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:8"
msgid "An unseen force guides your hand to the bag..."
msgstr "Niewidzialna siła kieruje twoją rękę do torby..."

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:9"
msgid "full of knowledge"
msgstr "pełna wiedzy"

msgctxt "woh_halo:10"
msgid "AIKO'S PLUSH TOY"
msgstr "PLUSZOWA ZABAWKA AIKO"

msgctxt "woh_halo:11"
msgid ""
"-1 incoming combat damage\n"
"-2 PERCEPTION; -2 LUCK"
msgstr ""
"-1 nadchodzące obrażenia bojowe\n"
"-2 PERCEPCJA; -2 SZCZĘŚCIE"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:12"
msgid "<<they are not real they are not real they are not real>>"
msgstr "<<Oni nie są prawdziwi, oni nie są prawdziwi, oni nie są prawdziwi>>."

msgctxt "woh_halo:13"
msgid "only friend"
msgstr "mój jedyny przyjaciel"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:14"
msgid "CIGARETTE CASE"
msgstr "PAPIEROŚNICA"

#. Descripción de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:15"
msgid "(while in inventory): 15% of regaining one CIGARETTE after investigating a location"
msgstr "(gdy w ekwipunku): 15% szansy na odzyskanie jednego papierosa po zbadaniu lokacji"

#. Opción de «CIGARETTE CASE» (woh_halo:14). Opciones: <<This will stay in my family forever.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:16"
msgid "<<This will stay in my family forever.>>"
msgstr "<<Niech to pozostanie w mojej rodzinie na zawsze.>>"

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:17"
msgid "You smoke an old cigarette from your CIGARETTE CASE..."
msgstr "Wypalasz starego papierosa z papierośnicy..."

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:18"
msgid "grandpa's"
msgstr "należała do dziadka"

msgctxt "woh_halo:19"
msgid "VANITY MIRROR"
msgstr "LUSTERKO KOSMETYCZNE"

msgctxt "woh_halo:20"
msgid "reveals extra information about event choices"
msgstr "(gdy w ekwipunku): ujawnia dodatkowe informacje o wybranych wydarzeniach"

msgctxt "woh_halo:21"
msgid "You can catch glimpses of the future in this tiny mirror..."
msgstr "Możesz dostrzec przebłyski przyszłości w tym małym lusterku..."

msgctxt "woh_halo:22"
msgid "The VANITY MIRROR will start working next event."
msgstr "LUSTERKO KOSMETYCZNE zacznie działać od następnego wydarzenia."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:23"
msgid "<<I'm so pretty-->>"
msgstr "<<Jestem taka ładna-->>"

msgctxt "woh_halo:24"
msgid "FILM ROLL"
msgstr "ROLKA FILMOWA"

msgctxt "woh_halo:25"
msgid "(use): -1 FUNDS; +10 EXPERIENCE"
msgstr "(użycie): -1 FUNDUSZE; +10 DOŚWIADCZENIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:26"
msgid "<<I can only develop this at a trusted place>>"
msgstr "<<Mogę to wywołać tylko w zaufanym miejscu>>."

msgctxt "woh_halo:27"
msgid "You develop the FILM ROLL containing crucial evidence!"
msgstr "Wywołujesz ROLKĘ FILMOWĄ zawierającą kluczowe dowody!"

msgctxt "woh_halo:28"
msgid "You can't afford that!"
msgstr "Nie stać cię na to!"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:29"
msgid "<<contains evidence ...I think>>"
msgstr "<<Zawiera dowody ... prawdopodobnie.>>"

msgctxt "woh_halo:30"
msgid "ANATOMY BOOK"
msgstr "PODRĘCZNIK DO ANATOMII"

msgctxt "woh_halo:31"
msgid "(use): -2 STAMINA; +8 EXP"
msgstr "(użyj): -2 KONDYCJA; +8 DOŚWIADCZENIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:32"
msgid "<<I can learn so much studying my own body...>>"
msgstr "<<Mogłabym nauczyć się tak wiele studiując własne ciało...>>"

msgctxt "woh_halo:33"
msgid "Slicing your body open, you learn new things about anatomy..."
msgstr "Krojąc własne ciało, dowiadujesz się wielu nowych rzeczy o anatomii..."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:34"
msgid "<<I'm ill?>>"
msgstr "<<Czy jestem chora?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:35"
msgid "GUITAR"
msgstr "GITARA"

#. Descripción de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:36"
msgid "(while in inventory): resting regains more REASON, increases DOOM"
msgstr "(gdy w ekwipunku): odpoczynek przywraca więcej ROZSĄDKU ale zwiększa ZAGŁADĘ"

#. Opción de «GUITAR» (woh_halo:35). Opciones: <<I worked all summer to buy this guitar.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:37"
msgid "<<I worked all summer to buy this guitar.>>"
msgstr "<< Pracowałam całe lato, aby ją kupić. >>"

#. Parte de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:38"
msgid "Your loud guitar practice can be heard across the whole building."
msgstr "Twoje głośne ćwiczenia na gitarze słychać w całym budynku."

msgctxt "woh_halo:39"
msgid "HELL YEAH"
msgstr "HELL YEAH"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:40"
msgid "BLESSED SHELL"
msgstr "BŁOGOSŁAWIONY POCISK"

#. Descripción de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:41"
msgid "(use in combat): (+1 AMMO / +5% DOOM); +10 SHOOT DAMAGE for the duration of this combat"
msgstr "(podczas walki): (+1 AMUNICJA/ +5% ZAGŁADA); +10 OBRAŻEŃ od STRZAŁÓW na czas trwania tej walki."

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:42"
msgid "<<I've loaded it with mom's silver jewelry...>>"
msgstr "<<Załadowałem ją srebrną biżuterią mamy...>>."

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:43"
msgid "<<...sorry mom.>>"
msgstr "<<...przepraszam mamo.>>"

#. Parte de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:44"
msgid "You can't use this outside of combat."
msgstr "Nie możesz tego używać poza walką."

#. Parte de «BLESSED SHELL» (woh_halo:40).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:45"
msgid "<<Should I?...>>"
msgstr "<<Czy powinnam?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:46"
msgid "MARKED BIBLE"
msgstr "NAZNACZONA BIBLIA"

#. Descripción de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:47"
msgid "(while in inventory): resting regains extra REASON/STAMINA, depending on character's FAITH level"
msgstr "(gdy w ekwipunku): odpoczynek przywraca dodatkowy ROZSĄDEK/KONDYCJĘ, w zależności od poziomu WIARY postaci."

#. Opción de «MARKED BIBLE» (woh_halo:46). Opciones: <<I don't remember certain parts of it, is this real?>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:48"
msgid "<<I don't remember certain parts of it, is this real?>>"
msgstr "<<Nie pamiętam niektórych fragmentów, czy są prawdziwe?>>"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:49"
msgid "Reading the MARKED BIBLE, you find your inner peace. (+1 REASON)"
msgstr "Czytając NAZNACZONĄ BIBLIĘ, odnajdujesz wewnętrzny spokój. (+1 ROZSĄDEK)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:50"
msgid "MARKED BIBLE fills you with determination. (+1 STAMINA)"
msgstr "NAZNACZONA BIBLIA napełnia cię determinacją. (+1 KONDYCJA)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:51"
msgid "dies irae"
msgstr "dies irae"

msgctxt "woh_halo:52"
msgid "AYAKA'S CHALK"
msgstr "KREDA AYAKI"

msgctxt "woh_halo:53"
msgid "+2 DAMAGE against GHOST enemies"
msgstr "+2 OBRAŻENIA przeciwko wrogom typu DUCH"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:54"
msgid "<<They died because of me...>>"
msgstr "<< Oni zginęli przeze mnie...>>."

msgctxt "woh_halo:55"
msgid "used in rituals"
msgstr "używana w rytuałach"

msgctxt "woh_halo:56"
msgid "BOOK STRAP"
msgstr "PASEK DO KSIĄZEK"

msgctxt "woh_halo:57"
msgid "faster combat actions for each BOOK item in the inventory"
msgstr "szybsze akcje bojowe za każdą KSIĄŻKĘ w ekwipunku"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:58"
msgid "<<That's not the only book I've taken.>>"
msgstr "<<To nie jedyna książka, którą zabrałem.>>"

msgctxt "woh_halo:59"
msgid "made of leather"
msgstr "wykonany ze skóry"

msgctxt "woh_halo:60"
msgid "CHECK BOOK"
msgstr "KSIĄŻECZKA CZEKOWA"

msgctxt "woh_halo:61"
msgid "(use): +3 FUNDS; +4% DOOM"
msgstr "(użycie): +3 FUNDUSZE; +6% ZAGŁADY"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:62"
msgid "<<Using this will make me easier to track down...>>"
msgstr "<<Użycie tego sprawi, że łatwiej będzie mnie wytropić...>>."

msgctxt "woh_halo:63"
msgid "You've used your CHECK BOOK."
msgstr "Używasz swojej KSIĄŻECZKI CZEKOWEJ."

msgctxt "woh_halo:64"
msgid "family's fortune"
msgstr "rodzinny majątek"

msgctxt "woh_halo:65"
msgid "BASEBALL"
msgstr "PIŁKA BASEBALLOWA"

msgctxt "woh_halo:66"
msgid "(use in combat): lower the ENEMY's power down to 0"
msgstr "(podczas walki)): obniża moc przeciwnika do 0"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:67"
msgid "<<I'm not the best pitcher but it must be enough.>>"
msgstr "<<Nie jestem najlepszym miotaczem, ale to musi wystarczyć.>>"

msgctxt "woh_halo:68"
msgid "You throw the BASEBALL at your enemy!"
msgstr "Rzucasz PIŁKĄ BASEBALLOWĄ w przeciwnika!"

msgctxt "woh_halo:69"
msgid "only one I got"
msgstr "jedyna, którą mam"

msgctxt "woh_halo:70"
msgid "FAVORITE SNACKS"
msgstr "ULUBIONE PRZEKĄSKI"

msgctxt "woh_halo:71"
msgid "(use): +3 REASON and STAMINA"
msgstr "(użyj): +3 ROZSĄDEK i KONDYCJA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:72"
msgid "<<I heard they are going to stop the production of these because they are too damn tasty!-->>"
msgstr "<<Podobno zamierzają wstrzymać produkcję tych przekąsek, ponieważ są zbyt smaczne!>>"

msgctxt "woh_halo:73"
msgid "You eat your FAVORITE SNACKS."
msgstr "Zajadasz się swoimi ULUBIONYMI PRZEKĄSKAMI."

msgctxt "woh_halo:74"
msgid "yum yum"
msgstr "mniam mniam"

msgctxt "woh_halo:75"
msgid "You rummage through your belongings trying to find anything that will help you."
msgstr "Grzebiesz w swoich rzeczach, próbując znaleźć cokolwiek, co mogłoby ci pomóc."

msgctxt "woh_halo:76"
msgid "You finally pick up"
msgstr "W końcu podnosisz"

msgctxt "woh_halo:77"
msgid ""
"Hopefully, it will be enough.\n"
"(+5% DOOM)"
msgstr ""
"Miejmy nadzieję, że to wystarczy.\n"
"(+5% ZAGŁADA)"

msgctxt "woh_halo:78"
msgid ""
"You don't find anything except some loose change laying around.\n"
"(+1 FUNDS / +2% DOOM)"
msgstr ""
"Nie znajdujesz nic poza kilkoma luźno leżącymi drobniakami.\n"
"(+1 FUNDUSZE/ +2% ZAGŁADA)"

msgctxt "woh_halo:79"
msgid "It's dangerous here, your STAMINA penalty increased!"
msgstr "Tu jest niebezpiecznie, kara do KONDYCJI wzrosła!"

msgctxt "woh_halo:80"
msgid "It's dangerous here, your REASON penalty increased!"
msgstr "Tu jest niebezpiecznie, kara do ROZSĄDKU wzrosła!"

msgctxt "woh_halo:81"
msgid ""
"\n"
"[DOOM EFFIGY]: DOOM lowered"
msgstr ""
"\n"
"[FATALNA KUKŁA]: obniżenie ZAGŁADY"

msgctxt "woh_halo:82"
msgid "SKIP SUITCASE SCREEN: ON/OFF"
msgstr "POMIŃ EKRAN Z WALIZKĄ: WŁ./WYŁ."

msgctxt "woh_halo:83"
msgid ""
"SKIP CARD PACK SCREEN: ON/OFF\n"
"(all packs enabled)"
msgstr ""
"POMIŃ EKRAN Z PACZKAMI KART: WŁ./WYŁ.\n"
"(wszystkie pakiety włączone)"

msgctxt "woh_halo:84"
msgid "CREEPY NEIGHBOR: ON/OFF"
msgstr "PODEJRZANY SĄSIAD: WŁ./WYŁ."

msgctxt "woh_halo:85"
msgid "CHECK FOR CONNECTED GAMEPADS: ON/OFF"
msgstr "SPRAWDŹ PODŁĄCZONE PADY: WŁ./WYŁ."

msgctxt "woh_halo:86"
msgid "WAVY EFFECT: ON/OFF"
msgstr "EFEKT FALI: WŁ./WYŁ."

msgctxt "woh_halo:87"
msgid "SKIP PLAYTHROUGH INTRO"
msgstr "POMIŃ WPROWADZENIE DO ROZGRYWKI"

msgctxt "woh_halo:88"
msgid "SKIP MYSTERY TUTORIAL"
msgstr "POMIŃ SAMOUCZEK DO TAJEMNIC"

msgctxt "woh_halo:89"
msgid "MOUSE TRAIL: ON/OFF"
msgstr "SMUGA ZA MYSZKĄ: WŁ./WYŁ."

msgctxt "woh_halo:90"
msgid "SKIP PALETTE CUSTOMIZATION"
msgstr "POMIŃ DOSTOSOWYWANIE PALETY"

msgctxt "woh_halo:91"
msgid "EXTRA MATH DISPLAYED: ON/OFF"
msgstr "WYŚWIETLANIE DODATKOWEJ MATEMATYKI: WŁ./WYŁ."

msgctxt "woh_halo:92"
msgid "EXTRA INFORMATION DISPLAYED: ON/OFF"
msgstr "WYŚWIETLANIE DODATKOWYCH INFORMACJI: WŁ./WYŁ."

msgctxt "woh_halo:93"
msgid "HOME"
msgstr "DOM"

msgctxt "woh_halo:94"
msgid "DOWNTOWN"
msgstr "ŚRÓDMIEŚCIE"

msgctxt "woh_halo:95"
msgid "SCHOOL"
msgstr "SZKOŁĘ"

msgctxt "woh_halo:96"
msgid "HOSPITAL"
msgstr "SZPITAL"

msgctxt "woh_halo:97"
msgid "SEASIDE"
msgstr "WYBRZEŻE"

msgctxt "woh_halo:98"
msgid "FOREST"
msgstr "LAS"

msgctxt "woh_halo:99"
msgid "MANSION"
msgstr "POSIADŁOŚĆ"

msgctxt "woh_halo:100"
msgid "VILLAGE"
msgstr "WIOSKĘ"

msgctxt "woh_halo:101"
msgid "APARTMENTS"
msgstr "APARTAMENT"

msgctxt "woh_halo:102"
msgid "TIME PASSED"
msgstr "UPŁYW CZASU"

msgctxt "woh_halo:103"
msgid "SEED"
msgstr "KOD"

msgctxt "woh_halo:104"
msgid "LEVEL"
msgstr "POZIOM"

msgctxt "woh_halo:105"
msgid "IMPENDING DOOM"
msgstr "ZBLIŻAJĄCA SIĘ ZAGŁADA"

msgctxt "woh_halo:106"
msgid "select OLD GOD"
msgstr "wybierz BÓSTWO"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:107"
msgid "AVAILABLE PERKS"
msgstr "DOSTĘPNE ULEPSZENIA"

#. Descripción de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:108"
msgid ""
"You've advanced to the next experience level.\n"
"Choose one perk and one stat upgrade.\n"
"\n"
"[CHOSEN:"
msgstr ""
"Awansowano na kolejny poziom doświadczenia!\n"
"Możesz wybrać jedno ulepszenie i jedną cechę postaci.\n"
"\n"
"[WYBRANO:"

#. Opción de «AVAILABLE PERKS» (woh_halo:107). Opciones: (select perk and stat) · REROLL PERKS · +4% DOOM.
msgctxt "woh_halo:109"
msgid "(select perk and stat)"
msgstr "(wybierz ulepszenie i cechę)"

#. Opción de «AVAILABLE PERKS» (woh_halo:107). Opciones: (select perk and stat) · REROLL PERKS · +4% DOOM.
msgctxt "woh_halo:110"
msgid "REROLL PERKS"
msgstr "LOSUJ NOWE ULEPSZENIA"

#. Opción de «AVAILABLE PERKS» (woh_halo:107). Opciones: (select perk and stat) · REROLL PERKS · +4% DOOM.
msgctxt "woh_halo:111"
msgid "+4% DOOM"
msgstr "+4% ZAGŁADY"

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:112"
msgid "The group must be there somewhere..."
msgstr "Ta grupa musi gdzieś tam być..."

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:113"
msgid "[click a square to explore it]"
msgstr "[kliknij na kwadrat, aby go zbadać]"

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:114"
msgid "The key to the study must be there somewhere..."
msgstr "Klucz do gabinetu musi gdzieś tam być..."

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:115"
msgid "[click a mansion's room to explore it]"
msgstr "[kliknij na pokój w posiadłości, aby go zbadać]"

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:116"
msgid "Where is that gardener?..."
msgstr "Gdzie jest ten ogrodnik?"

#. Parte de «AVAILABLE PERKS» (woh_halo:107).
msgctxt "woh_halo:117"
msgid "[extra damage against HUMAN and MONSTER enemies]"
msgstr "[dodatkowe obrażenia przeciwko wrogom typu CZŁOWIEK i POTWÓR]"

msgctxt "woh_home:0"
msgid "TURN ON"
msgstr "WŁĄCZ TELEWIZOR"

msgctxt "woh_home:1"
msgid "TURN OFF"
msgstr "WYŁĄCZ TELEWIZOR"

msgctxt "woh_home:2"
msgid "TV is turned off."
msgstr "Telewizor jest wyłączony."

msgctxt "woh_home:3"
msgid "You don't have any VHS cassettes to watch."
msgstr "Nie masz żadnych kaset VHS do obejrzenia."

msgctxt "woh_home:4"
msgid "(...) Local police are helpless as more and more victims turn up in the downtown area with their throats slashed. (...)"
msgstr "(...) Lokalna policja jest bezradna, gdy w centrum miasta pojawia się coraz więcej ofiar z poderżniętymi gardłami. (...)"

msgctxt "woh_home:5"
msgid "(...) demolition of an old inner-city shrine has resulted in an array of unfortunate accidents and, most recently, the death of six people suspected of arson. (...)"
msgstr "(...) Rozbiórka starej świątyni w centrum miasta spowodowała szereg nieszczęśliwych wypadków, w tym śmierć sześciu osób podejrzanych o podpalenie. (...)"

msgctxt "woh_home:6"
msgid "(...) we are shocked by what she did. Her voice was always so calm... (...)"
msgstr "(...) jesteśmy w szoku po tym, co zrobiła. Jej głos był zawsze taki spokojny... (...)"

msgctxt "woh_home:7"
msgid "(...) the TV host is gutting a big octopus. At least that's what she claims... but there are way too many tentacles (...)"
msgstr "(...) prezenterka telewizyjna patroszy z uśmiechem wielką ośmiornicę. Tylko czemu jest tam tyle macek? (...)"

msgctxt "woh_home:8"
msgid "(...) local dentist has been found guilty of implanting dog teeth on their human patients - motive is currently unknown. (...)"
msgstr "(...) lokalny dentysta został uznany za winnego implantowania psich zębów swoim pacjentom - motyw nie jest obecnie znany. (...)"

msgctxt "woh_home:9"
msgid "(...) a minor earthquake in the seaside region has revealed an entrance to a partially flooded cavern system. Local scientists believe some of the corridors could be man-made. (...)"
msgstr "(...) niewielkie trzęsienie ziemi w regionie nadmorskim ujawniło wejście do częściowo zalanego systemu jaskiń. Miejscowi naukowcy uważają, że niektóre z korytarzy mogą być dziełem człowieka. (...)"

msgctxt "woh_home:10"
msgid "You can't get any signal from the outside world. What is happening?"
msgstr "Nie można uzyskać żadnego sygnału ze świata zewnętrznego. Co się dzieje?"

msgctxt "woh_home:11"
msgid "(...) Some of our readers report a strange tall man, dressed in white, taking the metro after dark, apparently stalking lone passengers. Please take care and avoid traveling alone. (...)"
msgstr "(...) Niektórzy z naszych widzów zgłaszają dziwnego, wysokiego mężczyznę ubranego na biało, który jeździ metrem po zmroku i najwyraźniej prześladuje samotnych pasażerów. Prosimy o ostrożność i unikanie samotnych podróży. (...)"

msgctxt "woh_home:12"
msgid "(...) once a year, a ramen shop appears where there was once an alleyway - the ramen sold inside is made from its former patrons but can cure any health problem. (...)"
msgstr "(...) raz do roku w miejscu, gdzie kiedyś była alejka, pojawia się sklep z makaronem - ramen sprzedawany w środku jest robiony z jego byłych klientów, ale może pomóc wyleczyć każdą chorobę. (...)"

msgctxt "woh_home:13"
msgid "(...) the search for a missing person continues in the forest surrounding SHIOKAWA. If you have any information, please contact the police department (...)"
msgstr "(...) trwają poszukiwania zaginionej osoby w lesie otaczającym SHIOKAWĘ. Osoby posiadające jakiekolwiek informacje proszone są o kontakt z policją (...)"

msgctxt "woh_home:14"
msgid "you don't see anything weird"
msgstr "nie widzisz nic podejrzanego"

msgctxt "woh_home:15"
msgid "what's that?"
msgstr "co to jest?"

msgctxt "woh_home:16"
msgid "p-probably just my imagination...."
msgstr "p-prawdopodobnie tylko moja wyobraźnia...."

msgctxt "woh_home:17"
msgid "someone is standing in the shadow, watching your door..."
msgstr "Ktoś stoi w cieniu, obserwując twoje drzwi..."

msgctxt "woh_home:18"
msgid "ENDLESS MODE"
msgstr "TRYB NIEKOŃCZĄCY SIĘ"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:19"
msgid "CHOOSE A MYSTERY TO INVESTIGATE"
msgstr "WYBIERZ TAJEMNICĘ DO ROZWIĄZANIA"

#. Descripción de «CHOOSE A MYSTERY TO INVESTIGATE» (woh_home:19).
msgctxt "woh_home:20"
msgid ""
"Inexplicable and morbid events have been plaguing your town for some time now.\n"
"\n"
"You've marked down five of them, hoping that there is something connecting them.\n"
"\n"
"You can tackle these 5 MYSTERIES in any order you want. Beware, your decisions will haunt you and influence yet unsolved MYSTERIES."
msgstr ""
"Niewytłumaczalne i mroczne zjawiska nękają Twoje miasto już od jakiegoś czasu.\n"
"\n"
"Wybierasz pięć z nich, mając nadzieję, że coś je ze sobą łączy.\n"
"\n"
"Możesz zająć się tymi 5 TAJEMNICAMI w dowolnej kolejności. Uważaj, bo twoje decyzje będą cię prześladować i będą miały wpływ na pozostałe, jeszcze nierozwiązane TAJEMNICE."

#. Opción de «CHOOSE A MYSTERY TO INVESTIGATE» (woh_home:19). Opciones: REROLL MYSTERIES · ENDINGS DISCOVERED.
msgctxt "woh_home:21"
msgid "REROLL MYSTERIES"
msgstr "LOSUJ INNE TAJEMNICE"

#. Opción de «CHOOSE A MYSTERY TO INVESTIGATE» (woh_home:19). Opciones: REROLL MYSTERIES · ENDINGS DISCOVERED.
msgctxt "woh_home:22"
msgid "ENDINGS DISCOVERED"
msgstr "ODKRYTE ZAKOŃCZENIA"

#. Parte de «CHOOSE A MYSTERY TO INVESTIGATE» (woh_home:19).
msgctxt "woh_home:23"
msgid "w-what's inside?..."
msgstr "c-co jest w środku?..."

msgctxt "woh_home:24"
msgid "TAKE THE KEY"
msgstr "WEŹ KLUCZ"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:25"
msgid "THEY KNOW"
msgstr "ONI WIEDZĄ"

#. Descripción de «THEY KNOW» (woh_home:25).
msgctxt "woh_home:26"
msgid ""
"Inside your mailbox, you find a small key.\n"
"\n"
"What is it doing in there?"
msgstr ""
"W skrzynce pocztowej leży mały klucz.\n"
"\n"
"Co on tu robi?"

#. Parte de «THEY KNOW» (woh_home:25).
msgctxt "woh_home:27"
msgid "S-someone has crammed your mailbox full of animal entrails..."
msgstr "Ktoś zapchał Twoją skrzynkę zwierzęcymi wnętrznościami..."

#. Parte de «THEY KNOW» (woh_home:25).
msgctxt "woh_home:28"
msgid ""
"You check your mailbox...\n"
"\n"
"It's empty."
msgstr ""
"Sprawdzasz skrzynkę pocztową...\n"
"\n"
"Jest pusta."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:29"
msgid "MAILBOX"
msgstr "SKRZYNKA POCZTOWA"

#. Descripción de «MAILBOX» (woh_home:29).
msgctxt "woh_home:30"
msgid ""
"They still didn't fix the water problem. It is black and oily and glistening.\n"
"No way you're going to wash yourself in that!"
msgstr ""
"Nadal nie rozwiązali problemu z wodą. Wciąż jest czarna, oleista i lśniąca.\n"
"Nie ma mowy, żeby się w niej umyć!"

#. Parte de «MAILBOX» (woh_home:29).
msgctxt "woh_home:31"
msgid ""
"The shower will help you calm down and do wonders for your sore muscles.\n"
"What temperature should you set it to?"
msgstr "Szybki prysznic pomoże ci się uspokoić i zdziała cuda dla twoich obolałych mięśni. Jaką temperaturę wybrać?"

#. Parte de «MAILBOX» (woh_home:29).
msgctxt "woh_home:32"
msgid "You scrub yourself, but you'll never be clean again."
msgstr "Szorujesz ciało, ale już nigdy nie będziesz czuć się czysto."

#. Parte de «MAILBOX» (woh_home:29).
msgctxt "woh_home:33"
msgid "COLD WATER (extra REASON regained)"
msgstr "ZIMNA WODA (odzyskanie dodatkowego ROZSĄDKU)"

#. Parte de «MAILBOX» (woh_home:29).
msgctxt "woh_home:34"
msgid "WARM WATER (small EXP boost)"
msgstr "CIEPŁA WODA (niewielki bonus do DOŚWIADCZENIA)"

#. Parte de «MAILBOX» (woh_home:29).
msgctxt "woh_home:35"
msgid "HOT WATER (extra STAMINA regained)"
msgstr "GORĄCA WODA (odzyskanie dodatkowej KONDYCJI)"

msgctxt "woh_home:36"
msgid "USE BOTTLED WATER"
msgstr "UŻYJ WODY Z BUTELKI"

msgctxt "woh_home:37"
msgid "fill EMPTY BOTTLE with water"
msgstr "napełnij PUSTĄ BUTELKĘ wodą"

msgctxt "woh_home:38"
msgid "(this action requires 'EMPTY BOTTLE' item)"
msgstr "(ta akcja wymaga przedmiotu \"PUSTA BUTELKA\")"

msgctxt "woh_home:39"
msgid "You've filled one bottle already."
msgstr "Napełniono już jedną butelkę."

msgctxt "woh_home:40"
msgid "YOUR HOME"
msgstr "TWÓJ DOM"

msgctxt "woh_home:41"
msgid "LIGHTHOUSE"
msgstr "LATARNIA MORSKA"

msgctxt "woh_home:42"
msgid "REST A BIT"
msgstr "ODPOCZNIJ TROCHĘ"

msgctxt "woh_home:43"
msgid "TAKE A PEEK THROUGH PEEPHOLE"
msgstr "ZERKNIJ PRZEZ WIZJER"

msgctxt "woh_home:44"
msgid "BACK IN YOUR HOME, YOU THINK OF YOUR NEXT MOVE."
msgstr "PO POWROCIE DO DOMU ZASTANAWIASZ SIĘ NAD KOLEJNYM KROKIEM."

msgctxt "woh_home:45"
msgid "YOU ARE NOT CURRENTLY INVESTIGATING ANY WEIRD MYSTERY. RECENT NEWSPAPER CLIPPINGS AND NOTES COLLECTED IN THE NEXT ROOM SHOULD POINT YOU IN THE RIGHT DIRECTION."
msgstr "NIE PROWADZISZ OBECNIE ŚLEDZTWA W SPRAWIE ŻADNEJ DZIWNEJ TAJEMNICY. OSTATNIE WYCINKI Z GAZET I NOTATKI ZEBRANE W SĄSIEDNIM POKOJU POWINNY NAKIEROWAĆ CIĘ NA WŁAŚCIWY TROP."

msgctxt "woh_home:46"
msgid "LIGHT SWITCH"
msgstr "WŁĄCZNIK ŚWIATŁA"

msgctxt "woh_home:47"
msgid "WATCH TV"
msgstr "OBEJRZYJ TV"

msgctxt "woh_home:48"
msgid "TAKE A BATH"
msgstr "WEŹ KĄPIEL"

msgctxt "woh_home:49"
msgid "CHANGE CLOTHES"
msgstr "ZMIANA ODZIEŻY"

msgctxt "woh_home:50"
msgid "START A NEW MYSTERY"
msgstr "ROZPOCZNIJ NOWĄ TAJEMNICĘ"

msgctxt "woh_home:51"
msgid "MOVE THE CURTAIN"
msgstr "PRZESUŃ ZASŁONĘ"

msgctxt "woh_home:52"
msgid "OPEN DRAWER"
msgstr "OTWÓRZ SZUFLADĘ"

msgctxt "woh_home:53"
msgid "CLOSE DRAWER"
msgstr "ZAMKNIJ SZUFLADĘ"

msgctxt "woh_home:54"
msgid "CHOOSE AN ACTION"
msgstr "WYBIERZ AKCJĘ"

msgctxt "woh_home:55"
msgid "You've already taken a bath."
msgstr "Wzięto już kąpiel."

msgctxt "woh_home:56"
msgid "Weird, nothing happens."
msgstr "Dziwne, nic się nie dzieje."

msgctxt "woh_home:57"
msgid "Inside a figurine you find some money. (+1 FUNDS)"
msgstr "W figurce znajdujesz trochę pieniędzy. (+1 FUNDUSZE)"

msgctxt "woh_home:58"
msgid "You stand before a mirror, wondering which outfit to wear."
msgstr "Stajesz przed lustrem i zastanawiasz się, w co się ubrać."

msgctxt "woh_home:59"
msgid "Looking good."
msgstr "Dobrze wyglądasz."

msgctxt "woh_home:60"
msgid "Another day begins..."
msgstr "Kolejny dzień się zaczyna..."

msgctxt "woh_home:61"
msgid "Is it going to rain?"
msgstr "Czyżby zanosiło się na deszcz?"

msgctxt "woh_home:62"
msgid "You can't see anything."
msgstr "Niczego nie widać."

msgctxt "woh_home:63"
msgid "Ominous black clouds circle the lighthouse..."
msgstr "Złowieszczo czarne chmury okrążają latarnię morską..."

msgctxt "woh_home:64"
msgid "The ghost-gray mist envelops the whole town."
msgstr "Upiorno-szara mgła spowija całe miasto."

msgctxt "woh_home:65"
msgid "It has been raining since morning."
msgstr "Od samego rana pada deszcz."

msgctxt "woh_home:66"
msgid "It's a nice day outside."
msgstr "Za oknem jest ładny dzień."

msgctxt "woh_home:67"
msgid "It's dark already."
msgstr "Zrobiło się już ciemno."

msgctxt "woh_home:68"
msgid "GET BACK TO THE TOWN SCREEN"
msgstr "POWRÓT DO EKRANU MIASTA"

msgctxt "woh_home:69"
msgid "(complete at least one mystery to save progress)"
msgstr "(ukończ co najmniej jedną tajemnicę, aby zapisać postęp)"

msgctxt "woh_home:70"
msgid "SAVE PROGRESS AND EXIT THE GAME"
msgstr "ZAPISZ POSTĘP I WYJDŹ Z GRY"

msgctxt "woh_home:71"
msgid "(you can't save in ENDLESS mode)"
msgstr "(nie można zapisać w trybie NIESKOŃCZONYM)"

msgctxt "woh_home:72"
msgid "You could leave something to charge here."
msgstr "Możesz zostawić tutaj coś do naładowania."

msgctxt "woh_home:73"
msgid "CUSTOM MYSTERIES"
msgstr "DODATKOWE TAJEMNICE"

msgctxt "woh_home:74"
msgid "saving/loading is temporarily disabled"
msgstr "zapisywanie/wczytywanie jest chwilowo wyłączone"

msgctxt "woh_home:75"
msgid "No custom mysteries found."
msgstr "Nie znaleziono dodatkowych zagadek."

msgctxt "woh_home:76"
msgid "by"
msgstr "autorstwa"

msgctxt "woh_home:77"
msgid "Length:"
msgstr "Długość:"

msgctxt "woh_home:78"
msgid "replaces mystery"
msgstr "zastępuje tajemnicę"

msgctxt "woh_home:79"
msgid "(outfit locked)"
msgstr "(strój zablokowany)"

msgctxt "woh_home:80"
msgid "GO BACK"
msgstr "WRÓĆ"

msgctxt "woh_home:81"
msgid "That's a nice movie poster."
msgstr "Fajny plakat filmowy."

msgctxt "woh_home:82"
msgid "CLASSIC MODE - OLD GODS are awakening! Your only chance of survival is solving five different mysteries. The end of the world is at hand!"
msgstr ""
"TRYB KLASYCZNY - STARSZE BÓSTWA się budzą!\n"
"Twoją jedyną szansą na przetrwanie będzie rozwikłanie pięciu różnych tajemnic.\n"
"\n"
"Koniec świata się zbliża!"

msgctxt "woh_home:83"
msgid "ENDLESS MODE - It's hopeless! You can't stop the OLD GODS. In this mode, there are no mysteries to solve - earn points by surviving an endless stream of encounters."
msgstr "TRYB NIESKOŃCZONY- Sytuacja jest już całkowicie beznadziejna! Nie da się powstrzymać STARSZYCH BÓSTW. W tym trybie nie ma żadnych tajemnic do rozwikłania - zdobywaj punkty, przetrwawszy niekończący się strumień wydarzeń."

msgctxt "woh_home:84"
msgid ""
"SCENARIO MODE - Short adventures set during the events of classic mode.\n"
"[coming in the future!]"
msgstr "TRYB SCENARIUSZOWY - Krótkie przygody osadzone w czasie wydarzeń z trybu klasycznego."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:85"
msgid "ENDLESS MODE"
msgstr "TRYB NIESKOŃCZONY"

#. Descripción de «ENDLESS MODE» (woh_home:85).
msgctxt "woh_home:86"
msgid ""
"The game begins with a ritual. You can choose which OLD GOD will be summoned.\n"
"\n"
"This selection will influence encounters and add unique events to your playthrough."
msgstr "Każda rozgrywka rozpoczyna się rytuałem. Możesz wybrać, które STARSZE BÓSTWO zostanie przywołane. Wybór ten będzie miał wpływ na przebieg potyczek i doda unikalne wydarzenia do rozgrywki."

#. Parte de «ENDLESS MODE» (woh_home:85).
msgctxt "woh_home:87"
msgid "select the OLD GOD to view them, and select them again to confirm your choice"
msgstr "Wybierz STARSZE BÓSTWO, aby je odkryć, a następnie wybierz je ponownie, aby potwierdzić swój wybór."

#. Parte de «ENDLESS MODE» (woh_home:85).
msgctxt "woh_home:88"
msgid "somewhere, a group of people gathers, trying to awaken their master..."
msgstr "Grupa osób zbiera się w sekretnym miejscu, próbując obudzić swojego mistrza..."

#. Parte de «ENDLESS MODE» (woh_home:85).
msgctxt "woh_home:89"
msgid "(additional modes will unlock as you progress)"
msgstr "(dodatkowe tryby zostaną odblokowane w miarę postępów)"

msgctxt "woh_home:90"
msgid "OLD GOD'S RULE"
msgstr "NOWA ZASADA"

msgctxt "woh_home:91"
msgid "(character-exclusive perk cards only)"
msgstr "(tylko karty ulepszeń danej postaci)"

msgctxt "woh_home:92"
msgid "(all unlocked perk cards)"
msgstr "(wszystkie odblokowane karty ulepszeń)"

msgctxt "woh_home:93"
msgid "(randomized item statistics)"
msgstr "(losowe statystyki przedmiotów)"

msgctxt "woh_home:94"
msgid "BACKSTORY"
msgstr "PRZESZŁOŚĆ POSTACI"

msgctxt "woh_home:95"
msgid "---CTHAC-ATORASU, THE SPIDER GOD---"
msgstr "---CTHAC-ATORASU, PAJĘCZY BÓG---"

msgctxt "woh_home:96"
msgid ""
"The terrible spider god, CTHAC-ATORASU is once again awakening from its slumber...\n"
"Blinded by its impossible-to-satisfy hunger, it has started to tear down the walls of its cocoon prison."
msgstr ""
"Straszliwy bóg pająków, CTHAC-ATORASU, po raz kolejny wybudza się ze swego snu... \n"
"Zaślepiony niemożliwym do zaspokojenia głodem, zaczyna burzyć ściany swego kokonowego więzienia."

msgctxt "woh_home:97"
msgid "ETERNAL WEB: You can't run from combat"
msgstr "SIEĆ WIECZNOŚCI: Nie można uciec przed walką"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:98"
msgid "THE ETERNAL WEB"
msgstr "SIEĆ WIECZNOŚCI"

#. Descripción de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:99"
msgid ""
"CTHAC-ATORASU is once again awakening from its slumber...\n"
"\n"
"Blinded by its impossible-to-satisfy hunger, it has started to tear down the walls of its cocoon prison.\n"
"\n"
"Stop it before it devours us all."
msgstr ""
"CTHAC-ATORASU po raz kolejny wybudza się ze swego snu...\n"
"\n"
"Zaślepiony niemożliwym do zaspokojenia głodem, zaczyna burzyć ściany swego kokonowego więzienia.\n"
"\n"
"Powstrzymaj go, zanim pożre nas wszystkich."

#. Opción de «THE ETERNAL WEB» (woh_home:98). Opciones: [you can't escape from combat encounters] · CTHAC-ATORASU · ---YGOTHAEG, THE IRRESISTIBLE GAZE---.
msgctxt "woh_home:100"
msgid "[you can't escape from combat encounters]"
msgstr "[nie można uciec przed walką]"

#. Opción de «THE ETERNAL WEB» (woh_home:98). Opciones: [you can't escape from combat encounters] · CTHAC-ATORASU · ---YGOTHAEG, THE IRRESISTIBLE GAZE---.
msgctxt "woh_home:101"
msgid "CTHAC-ATORASU"
msgstr "CTHAC-ATORASU"

#. Opción de «THE ETERNAL WEB» (woh_home:98). Opciones: [you can't escape from combat encounters] · CTHAC-ATORASU · ---YGOTHAEG, THE IRRESISTIBLE GAZE---.
msgctxt "woh_home:102"
msgid "---YGOTHAEG, THE IRRESISTIBLE GAZE---"
msgstr "---YGOTHAEG, SPOJRZENIE, KTÓREMU NIE MOŻNA SIĘ OPRZEĆ---"

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:103"
msgid ""
"The nuclear tests in the Pacific region have awakened something evil in the depths of Mariana Trench.\n"
"YGOTHAEG is now slowly emerging, ready to once again rule the coastlines."
msgstr ""
"Próby nuklearne w regionie Pacyfiku przebudziły coś niegodziwego w głębinach Rowu Mariańskiego. \n"
"YGOTHAEG wyłania się powoli, gotowy, by ponownie rządzić wybrzeżami."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:104"
msgid "GAZE OF YGOTHAEG: follow the commands or suffer its wrath"
msgstr "SPOJRZENIE YGOTHAEGA: postępuj zgodnie z rozkazami lub doświadcz jego gniewu"

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:105"
msgid "Don't investigate DOWNTOWN, FOREST and MANSION or suffer its wrath."
msgstr "Nie badaj ŚRÓDMIEŚCIA, LASU i POSIADŁOŚCI, albo poniesiesz jego gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:106"
msgid "Don't investigate APARTMENTS, SCHOOL and VILLAGE or suffer its wrath."
msgstr "Nie badaj APARTAMENTÓW, SZKOŁY i WIOSKI, bo dosięgnie cię gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:107"
msgid "Don't investigate HOSPITAL, FOREST and VILLAGE or suffer its wrath."
msgstr "Nie badaj SZPITALA, LASU i WIOSKI, bo dosięgnie cię gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:108"
msgid "Don't investigate DOWNTOWN, MANSION and HOSPITAL or suffer its wrath."
msgstr "Nie badaj ŚRÓDMIEŚCIA, POSIADŁOŚCI i SZPITALA, bo dosięgnie cię gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:109"
msgid "Don't investigate SCHOOL, SEASIDE and APARTMENTS or suffer its wrath."
msgstr "Nie badaj SZKOŁY, WYBRZEŻA i APARTAMENTÓW, bo dosięgnie cię gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:110"
msgid "Don't investigate FOREST and SCHOOL or suffer its wrath."
msgstr "Nie badaj LASU i SZKOŁY, bo dosięgnie cię gniew."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:111"
msgid "Don't investigate HOSPITAL and MANSION or suffer its wrath."
msgstr "Nie badaj SZPITALA i POSIADŁOŚCI, bo doznasz jego gniewu."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:112"
msgid "Don't blink or suffer its wrath."
msgstr "Nie mrugaj, bo doznasz jego gniewu."

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:113"
msgid "You won't cheat YGOTHAEG that easily... (+1% DOOM)"
msgstr "YGOTHAEGA nie da się tak łatwo oszukać... (+1% ZAGŁADA)"

#. Parte de «THE ETERNAL WEB» (woh_home:98).
msgctxt "woh_home:114"
msgid "YGOTHAEG is getting furious... (+2% DOOM)"
msgstr "YGOTHAEG wpada w furię... (+2% ZAGŁADA)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:115"
msgid "IRRESISTIBLE GAZE"
msgstr "SPOJRZENIE, KTÓREMU NIE MOŻNA SIĘ OPRZEĆ"

#. Descripción de «IRRESISTIBLE GAZE» (woh_home:115).
msgctxt "woh_home:116"
msgid "The nuclear tests in the Pacific region have awakened something evil in the depths of the Mariana Trench. YGOTHAEG is now slowly emerging, ready to once again rule the coastlines."
msgstr "Próby nuklearne w regionie Pacyfiku przebudziły coś niegodziwego w głębinach Rowu Mariańskiego. YGOTHAEG wyłania się powoli, gotowy, by ponownie rządzić wybrzeżami."

#. Opción de «IRRESISTIBLE GAZE» (woh_home:115). Opciones: [follow the commands or suffer its wrath] · YGOTHAEG · ---GOIZO, THE THING FORSAKEN BY GOD---.
msgctxt "woh_home:117"
msgid "[follow the commands or suffer its wrath]"
msgstr "[podążaj za poleceniami, albo ściągniesz na siebie jego gniew]"

#. Opción de «IRRESISTIBLE GAZE» (woh_home:115). Opciones: [follow the commands or suffer its wrath] · YGOTHAEG · ---GOIZO, THE THING FORSAKEN BY GOD---.
msgctxt "woh_home:118"
msgid "YGOTHAEG"
msgstr "YGOTHAEG"

#. Opción de «IRRESISTIBLE GAZE» (woh_home:115). Opciones: [follow the commands or suffer its wrath] · YGOTHAEG · ---GOIZO, THE THING FORSAKEN BY GOD---.
msgctxt "woh_home:119"
msgid "---GOIZO, THE THING FORSAKEN BY GOD---"
msgstr "---GOIZO, RZECZ PORZUCONA PRZEZ BOGA---"

#. Parte de «IRRESISTIBLE GAZE» (woh_home:115).
msgctxt "woh_home:120"
msgid "Banished to the other dimension a long time ago, GOIZO has found a way to use mirrors to ensnare and teleport its prey straight through reflective glass. The glimpses behind your reflections are just the beginning of a real nightmare."
msgstr "Wygnane do innego wymiaru dawno temu, GOIZO znalazło sposób na użycie luster, by usidlić i przeteleportować swoją ofiarę prosto przez odbijające światło szkło. Przebłyski zza twoich odbić to dopiero początek prawdziwego koszmaru."

#. Parte de «IRRESISTIBLE GAZE» (woh_home:115).
msgctxt "woh_home:121"
msgid "MIRROR HORROR: Resting increases DOOM penalty"
msgstr "LUSTRZANA GROZA: Odpoczynek zwiększa karę ZAGŁADY"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:122"
msgid "THE THING FORSAKEN BY GOD"
msgstr "RZECZ PORZUCONA PRZEZ BOGA"

#. Descripción de «THE THING FORSAKEN BY GOD» (woh_home:122).
msgctxt "woh_home:123"
msgid ""
"Banished to the other dimension a long time ago, GOIZO has found a way to use mirrors to ensnare and teleport its prey straight through reflective glass.\n"
"\n"
"The glimpses behind your reflections are just the beginning of a real nightmare."
msgstr "Wygnane do innego wymiaru dawno temu, GOIZO znalazło sposób na użycie luster, by usidlić i przeteleportować swoją ofiarę prosto przez odbijające światło szkło."

#. Opción de «THE THING FORSAKEN BY GOD» (woh_home:122). Opciones: [resting at home raises DOOM] · GOIZO · ---ATH-YOLAZSTH, THE TOWERING EYE---.
msgctxt "woh_home:124"
msgid "[resting at home raises DOOM]"
msgstr "[odpoczynek zwiększa karę ZAGŁADY]"

#. Opción de «THE THING FORSAKEN BY GOD» (woh_home:122). Opciones: [resting at home raises DOOM] · GOIZO · ---ATH-YOLAZSTH, THE TOWERING EYE---.
msgctxt "woh_home:125"
msgid "GOIZO"
msgstr "GOIZO"

#. Opción de «THE THING FORSAKEN BY GOD» (woh_home:122). Opciones: [resting at home raises DOOM] · GOIZO · ---ATH-YOLAZSTH, THE TOWERING EYE---.
msgctxt "woh_home:126"
msgid "---ATH-YOLAZSTH, THE TOWERING EYE---"
msgstr "-ATH-YOLAZSTH, GÓRUJĄCE OKO---"

#. Parte de «THE THING FORSAKEN BY GOD» (woh_home:122).
msgctxt "woh_home:127"
msgid "The Mad God favors astronomers and magicians, granting them its gift of power that unknowingly brings ATH-YOLAZSTH's bloated body closer and closer to Earth."
msgstr "Szalone BÓSTWO faworyzuje astronomów i magów, obdarzając ich swoim darem mocy, który nieświadomie przybliża rozdęte ciało ATH-YOLAZSTHA do Ziemi."

#. Parte de «THE THING FORSAKEN BY GOD» (woh_home:122).
msgctxt "woh_home:128"
msgid "COSMIC GIFT: Casting spells costing REASON, increases DOOM instead."
msgstr "KOSMICZNY DAR: Rzucanie zaklęć kosztujących ROZSĄDEK, zamiast tego zwiększa ZAGŁADĘ."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:129"
msgid "THE MISSING STARS"
msgstr "ZAGINIONE GWIAZDY"

#. Descripción de «THE MISSING STARS» (woh_home:129).
msgctxt "woh_home:130"
msgid ""
"The media has been reporting about various people with seemingly supernatural skills.\n"
"\n"
"Could it have any connection with the news about stars disappearing from the night sky?"
msgstr "Media donoszą o ludziach z pozornie nadprzyrodzonymi umiejętnościami. Czy może mieć to jakiś związek z doniesieniami o gwiazdach które znikają z nocnego nieba?"

#. Opción de «THE MISSING STARS» (woh_home:129). Opciones: [casting spells raises DOOM instead of its normal cost] · ATH-YOLAZSTH · ---ITHOTU, THE DEVOURING FIRE---.
msgctxt "woh_home:131"
msgid "[casting spells raises DOOM instead of its normal cost]"
msgstr "[rzucanie zaklęć podnosi ZAGŁADĘ zamiast normalnego kosztu ROZSĄDKU]."

#. Opción de «THE MISSING STARS» (woh_home:129). Opciones: [casting spells raises DOOM instead of its normal cost] · ATH-YOLAZSTH · ---ITHOTU, THE DEVOURING FIRE---.
msgctxt "woh_home:132"
msgid "ATH-YOLAZSTH"
msgstr "ATH-YOLAZSTH"

#. Opción de «THE MISSING STARS» (woh_home:129). Opciones: [casting spells raises DOOM instead of its normal cost] · ATH-YOLAZSTH · ---ITHOTU, THE DEVOURING FIRE---.
msgctxt "woh_home:133"
msgid "---ITHOTU, THE DEVOURING FIRE---"
msgstr "---ITHOTU, POŻERAJĄCY OGIEŃ---"

#. Parte de «THE MISSING STARS» (woh_home:129).
msgctxt "woh_home:134"
msgid "This supposed cause of destruction of the library of Alexandria, a perfect black marble statue, has been recently discovered and is currently waiting in the museum of OOO for its long-awaited premiere."
msgstr "Domniemana przyczyna zagłady Biblioteki Aleksandryjskiej, idealny posąg z czarnego marmuru, został niedawno ponownie odnaleziony i obecnie czeka w muzeum ◯◯◯ na swoją długo oczekiwaną premierę."

#. Parte de «THE MISSING STARS» (woh_home:129).
msgctxt "woh_home:135"
msgid "ENTROPY: both your damage and your enemies' is increased."
msgstr "ENTROPIA: zarówno ty, jak i wrogowie zadajecie dodatkowe obrażenia."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_home:136"
msgid "ALEXANDRIA, 48 BC"
msgstr "ALEKSANDRIA, 48 P.N.E."

#. Descripción de «ALEXANDRIA, 48 BC» (woh_home:136).
msgctxt "woh_home:137"
msgid "The supposed cause of destruction of the library of Alexandria, a perfect black marble statue, has been recently rediscovered and is currently waiting in the museum of OOO for its long-awaited premiere."
msgstr "Domniemana przyczyna zagłady Biblioteki Aleksandryjskiej, idealny posąg z czarnego marmuru, został niedawno ponownie odnaleziony i obecnie czeka w muzeum ◯◯◯ na swoją długo oczekiwaną premierę."

#. Opción de «ALEXANDRIA, 48 BC» (woh_home:136). Opciones: [both you and enemies deal extra damage] · ITHOTU · ---HERALD OF THE SHATTERED COURT---.
msgctxt "woh_home:138"
msgid "[both you and enemies deal extra damage]"
msgstr "[zarówno ty, jak i wrogowie zadajecie dodatkowe obrażenia]"

