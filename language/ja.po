msgid "resolve this event"
msgstr "イベント終了"

msgctxt "woh_event:1165"
msgid "gain a spell"
msgstr "呪文習得"

msgctxt "woh_event:1166"
msgid ""
"resolve this event\n"
"(cancels the effect)"
msgstr ""
"イベント終了\n"
"(効果消失)"

msgctxt "woh_event:1167"
msgid "prepare for combat"
msgstr "身構える"

msgctxt "woh_event:1168"
msgid "where are you?"
msgstr "どこに行ったのだろう？"

msgctxt "woh_event:1169"
msgid "event continues"
msgstr "イベント続行"

msgctxt "woh_event:1170"
msgid "prepare yourself"
msgstr "身構える"

msgctxt "woh_event:1171"
