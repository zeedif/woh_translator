msgid "The HORROR is slowly getting closer."
msgstr ""
"“恐怖”がじわじわと\n"
"迫ってきている"

msgctxt "woh_san:11"
msgid "It's too late now."
msgstr "もう手遅れだ…"

msgctxt "woh_san:12"
msgid "ELUSIVE"
msgstr "逃げ上手"

msgctxt "woh_san:13"
msgid "-5% DOOM"
msgstr "破滅値-5%"

msgctxt "woh_san:14"
msgid "TEST OF WILL"
msgstr "意地比べ"

msgctxt "woh_san:15"
msgid ""
"+2 KNOWLEDGE\n"
"+2% DOOM"
msgstr ""
"｢賢さ｣+2\n"
"破滅値+2%"

msgctxt "woh_san:16"
msgid "ESCAPEE"
msgstr "逃亡者"

msgctxt "woh_san:17"
msgid ""
"+2 DEXTERITY\n"
"+2% DOOM"
msgstr ""
"｢敏捷性｣+2\n"
"破滅値+2%"

msgctxt "woh_san:18"
msgid "ON THE RUN"
msgstr "忍び寄る魔の手"

msgctxt "woh_san:19"
msgid "until the HORROR catches you, leveling up costs 50 EXPERIENCE less"
msgstr ""
"｢恐怖｣に追いつかれるまで、\n"
"レベルアップに必要な\n"
"EXPが50減少する"

msgctxt "woh_san:20"
msgid "<<it's getting closer>>"
msgstr "<<近づいてきてる…>>"

msgctxt "woh_san:21"
msgid "<<Here's our chance!>>"
msgstr "<<チャンス！>>"

msgctxt "woh_san:22"
msgid "<<Attack the enemy!>>"
msgstr "<<攻撃！>>"

msgctxt "woh_san:23"
msgid "<<We are winning!>>"
msgstr "<<勝てる！>>"

msgctxt "woh_san:24"
msgid "<<Surround the enemy!>>"
msgstr "<<取り囲もう！>>"

msgctxt "woh_san:25"
msgid "ORDER YOUR ALLIES TO ATTACK"
msgstr "仲間に攻撃指示を出す"

msgctxt "woh_san:26"
msgid "FLASH combat action adds a chance to dodge the incoming attack"
msgstr ""
"戦闘アクション｢フラッシュ｣で\n"
"敵からの攻撃回避率が上昇"

msgctxt "woh_san:27"
msgid "looking for an improvised weapon results in two items, instead of one"
msgstr "即席武器を探すとアイテムが２つ手に入る"

msgctxt "woh_san:28"
msgid "fell out of a window!"
msgstr "が窓から転落した…"

msgctxt "woh_san:29"
msgid "was hit by a truck!"
msgstr "はトラックにひかれた…"

msgctxt "woh_san:30"
msgid "tripped and broke their neck!"
msgstr "はつまずいて、首の骨を折ってしまう…"

msgctxt "woh_san:31"
msgid "walked into an empty elevator shaft!"
msgstr "は誰もいないエレベーターシャフトに足を踏み入れた。"

msgctxt "woh_san:32"
msgid "was struck by lighting!"
msgstr "が雷に打たれた！"

msgctxt "woh_san:33"
msgid "suddenly died!"
msgstr "は突然死した…"

