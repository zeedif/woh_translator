msgid "contains two new mysteries"
msgstr "新たな謎を3つ収録"

msgctxt "woh_ni:141"
msgid "partied too hard"
msgstr "どんちゃん騒ぎ"

msgctxt "woh_ni:142"
msgid "FLOODED NAILS"
msgstr "あふれ返る爪"

msgctxt "woh_ni:143"
