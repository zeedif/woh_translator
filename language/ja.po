msgctxt "woh_ichi:1"
msgid ""
"Name: YUMIKO ICHIMURA\n"
"20 / FEMALE \n"
"When her twin brother suddenly disappeared during a family holiday, Yumiko swore to find him, no matter the cost..."
msgstr ""
"市村 由美子\n"
"20歳 / 女\n"
"家族旅行中、突如として双子の兄が\n"
"行方不明になってしまう。\n"
"その時、彼女は誓った。\n"
"兄を見つけ出す、たとえどんな犠牲を\n"
"払ってでも…"

msgctxt "woh_ichi:2"
msgid ""
"+ STRENGTH\n"
"- KNOWLEDGE\n"
"starts with LUCKY BAT"
msgstr ""
"筋力＋\n"
"賢さ－\n"
"｢幸運のバット｣を持った状態で\n"
"スタート"

