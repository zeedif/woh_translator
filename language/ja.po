"戦闘ダメージを追加で受ける\n"
"捨てる: スタミナ-3"

msgctxt "woh_ichi:24"
msgid "<<is that paint?>>"
msgstr "<<あれってペンキ…？>>"

msgctxt "woh_ichi:25"
msgid "EIMI"
msgstr "詠美"

msgctxt "woh_ichi:26"
