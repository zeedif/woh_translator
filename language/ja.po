"[-1 DAMAGE received]"
msgstr "お守りの刺青: 被ダメージ-1"

msgctxt "woh_ichi:22"
msgid "BLOOD FRENZY"
msgstr "血に飢えた狂気"

msgctxt "woh_ichi:23"
msgid ""
"+1 DAMAGE / receive additional combat damage\n"
"(discard): lose 3 STAMINA"
msgstr ""
