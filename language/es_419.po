msgid "BLACKBOARD SHRIEKER"
msgstr ""

#. Descripción de «BLACKBOARD SHRIEKER» (woh_nana:585).
msgctxt "woh_nana:586"
msgid ""
"When you step into an empty classroom, the blackboard begins to screech violently, revealing a thin figure crawling out of it.\n"
"\n"
"Your ears begin to ring…\n"
"no, they begin to bleed."
msgstr ""

#. Parte de «BLACKBOARD SHRIEKER» (woh_nana:585).
msgctxt "woh_nana:587"
msgid "An angry spirit of a bullied student, trapped between chalk lines."
msgstr ""

#. Parte de «BLACKBOARD SHRIEKER» (woh_nana:585).
msgctxt "woh_nana:588"
msgid "BLACKBOARD SHRIEKER screams painfully!"
msgstr ""

#. Parte de «BLACKBOARD SHRIEKER» (woh_nana:585).
msgctxt "woh_nana:589"
msgid "A piece of chalk explodes in your mouth!"
msgstr ""

#. Parte de «BLACKBOARD SHRIEKER» (woh_nana:585).
msgctxt "woh_nana:590"
msgid "Your name appears on the blackboard!"
msgstr ""

