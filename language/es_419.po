msgid ""
"-2 modifier to all skill checks\n"
"---\n"
"STAMINA/REASON penalties increased\n"
"---\n"
"DOOM penalty for investigating this location"
msgstr ""
"-2 de modificadores a todas las revisiones de habilidades\n"
"---\n"
"mayor penalización de VIGOR/CORDURA\n"
"---\n"
"penalización de RUINA por investigar este lugar"

msgctxt "woh_chal:177"
