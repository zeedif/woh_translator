msgid "SAFETY IN NUMBERS"
msgstr "MIENTRAS MÁS SEAN, MEJOR"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
#. Descripción de «SAFETY IN NUMBERS» (woh_perk:310).
msgctxt "woh_perk:311"
msgid ""
"[why did you sign that contract?]\n"
"\n"
"+1 MAX REASON\n"
"(at the end of the mystery): if you don't have at least 2 followers, lose 2 REASON"
msgstr ""
"[¿por qué firmaste ese contrato?\n"
"\n"
"+1 de CORDURA MÁXIMA\n"
"(al finalizar el misterio): si no tienes al menos 2 seguidores, pierdes 2 de CORDURA"

