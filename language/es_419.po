msgstr "1 % por cada MALDICIÓN activa"

msgctxt "woh_ichi:91"
msgid "MISERY PARASITE"
msgstr "PARÁSITO DE MISERIA"

msgctxt "woh_ichi:92"
msgid "MISERY PARASITE grows larger..."
msgstr "PARÁSITO DE MISERIA crece…"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_ichi:93"
msgid "DOOM"
msgstr "RUINA"

#. Descripción de «DOOM» (woh_ichi:93).
msgctxt "woh_ichi:94"
msgid "It was only a matter of time. The MISERY PARASITES took almost everything from you. The last thing they took, after weeks of torture, was your life."
msgstr "Era cosa de tiempo. Los PARÁSITOS DE MISERIA te quitaron casi todo. Lo último que te quitaron, tras semanas de tortura, fue tu vida."

#. Parte de «DOOM» (woh_ichi:93).
msgctxt "woh_ichi:95"
msgid "Once a human being, now you've become one with the God of the Inconceivable Sadness."
msgstr "Alguna vez fuiste un ser humano, ahora eres uno con el dios de la tristeza inimaginable."

#. Parte de «DOOM» (woh_ichi:93).
msgctxt "woh_ichi:96"
msgid "Inconceivable Sadness"
msgstr "Tristeza inimaginable"

#. Parte de «DOOM» (woh_ichi:93).
msgctxt "woh_ichi:97"
msgid "if the mystery ended right now, DOOM would raise by"
msgstr "si el misterio termina ahora, la RUINA aumentará en"

