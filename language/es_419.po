msgctxt "woh_spell:27"
msgid ""
"deals damage to an enemy, which increases the lower your STAMINA is\n"
"[COST: 2 STAMINA]"
msgstr ""
"inflige daño a un enemigo. Mientras menor sea tu VIGOR, mayor será el daño\n"
"[CUESTA: 2 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:28"
msgid "The wounds of your enemy explode with gore!"
msgstr "¡Las heridas de tus enemigos explotan con violencia!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:29"
msgid "K'NPHA RITUAL"
msgstr "RITUAL DE K'NPHA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:30"
msgid ""
"when your allies die, a random STAT gets raised by 1\n"
"[COST: 2 REASON]"
msgstr ""
"cuando uno de tus aliados muere, un ATRIBUTO aleatorio aumenta en 1\n"
"[CUESTA: 2 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:31"
msgid "Part of your ally's essence stays with you!"
msgstr "¡Parte de la esencia de tu aliado se queda contigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:32"
msgid ""
"K'NPHA RITUAL\n"
"[allies -> stats]"
msgstr ""
"RITUAL DE K'NPHA\n"
"[aliados -> atributos]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:33"
msgid "INVISIBILITY"
msgstr "INVISIBILIDAD"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:34"
msgid ""
"until the end of the current mystery, there is no DOOM penalty for escaping from combat\n"
"[COST: 4 REASON]"
msgstr ""
"hasta el final de este misterio no hay penalización de RUINA por huir de los combaates\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:35"
msgid "You shift into the shadow realm!"
msgstr "¡Te desplazas hacia el reino de las sombras!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:36"
msgid "You are already invisible!"
msgstr "¡Ya eres invisible!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:37"
msgid "ABOLISH"
msgstr "ABOLIR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:38"
msgid ""
"lowers ELDRITCH enemy DAMAGE by 1\n"
"[COST: 3 STAMINA]"
msgstr ""
"disminuye en 1 el DAÑO de enemigos ÉLDRICOS\n"
"[CUESTA: 3 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:39"
msgid "A magic barrier appears, absorbing the damage!"
msgstr "¡Aparece una barrera mágica que absorbe el daño!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:40"
msgid "Additional barriers won't help!"
msgstr "¡Más barreras no sirven de nada!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:41"
msgid "ABSORB"
msgstr "ABSORBER"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:42"
msgid ""
"deals 3 damage, gain 2 STAMINA\n"
"[COST: 4 REASON]"
msgstr ""
"inflige 3 de daño, obtienes 2 de VIGOR\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:43"
msgid "You suck the life force out of your enemy!"
msgstr "¡Absorbes la fuerza vital de tu enemigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:44"
msgid "THIRD EYE"
msgstr "TERCER OJO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:45"
msgid ""
"+1 KNOWLEDGE and PERCEPTION until the end of the mystery\n"
"[effect doesn't stack]\n"
"[COST: 3 REASON]"
msgstr ""
"+1 de CONOCIMIENTO y PERCEPCIÓN hasta terminar el misterio\n"
"[efecto no acumulable]\n"
"[CUESTA: 3 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:46"
msgid "You can feel your inner eye open!"
msgstr "¡Sientes que se abre tu ojo interior!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:47"
msgid "You wouldn't want a fourth eye, would you?"
msgstr "No creo que quieras un cuarto ojo."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:48"
msgid "ITHOTU FLAME"
msgstr "LLAMA DE ITHOTU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:49"
msgid ""
"deals 8 damage\n"
"+2% DOOM\n"
"[COST: 1 REASON]\n"
"[COST: 1 STAMINA]"
msgstr ""
"inflige 8 de daño\n"
"+2 % de RUINA\n"
"[CUESTA: 1 de CORDURA]\n"
"[CUESTA: 1 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:50"
msgid "A column of fire engulfs the enemy!"
msgstr "¡Un pilar de fuego envuelve al enemigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:51"
msgid "SEAL OF SAVVESH"
msgstr "SELLO DE SAVVESH"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:52"
msgid ""
"+1 STRENGTH\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 de FUERZA\n"
"[se descarta con el uso]\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:53"
msgid "A new seal appears on your skin!"
msgstr "¡Aparece un sello nuevo en tu piel!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:54"
msgid "SEAL OF BRAM'EL"
msgstr "SELLO DE BRAM'EL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:55"
msgid ""
"+1 KNOWLEDGE\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 de CONOCIMIENTO\n"
"[se descarta con el uso]\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:56"
msgid "THREAD OF FATE"
msgstr "HILO DEL DESTINO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:57"
msgid ""
"defeat target HUMAN enemy\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"derrota un enemigo HUMANO seleccionado\n"
"[se descarta con el uso]\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:58"
msgid "Enemy falls to the ground, dead."
msgstr "El enemigo cae al suelo, muerto."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:59"
msgid "ANCESTRAL STRENGTH"
msgstr "FUERZA ANCESTRAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:60"
msgid ""
"+1 DAMAGE\n"
"[COST: 4 REASON]"
msgstr ""
"+1 de DAÑO\n"
"[CUESTA: 4 de CORDURA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:61"
msgid "Someone is guiding your moves..."
msgstr "Alguien guía tus movimientos…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:62"
msgid ""
"ANCESTRAL STRENGTH\n"
"[+1 DAMAGE]"
msgstr ""
"FUERZA ANCESTRAL\n"
"[+1 de DAÑO]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:63"
msgid "ENTHRALLMENT"
msgstr "ENCANTO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:64"
msgid ""
"gain an additional follower\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"obtén un seguidor extra\n"
"[se descarta con el uso]\n"
"[CUESTA: 4 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:65"
msgid "A new person follows your lead..."
msgstr "Alguien nuevo sigue tus pasos…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:66"
msgid "AWAKEN"
msgstr "DESPERTAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:67"
msgid ""
"gain a permanent boost of two randomly selected stats\n"
"[COST: 10% DOOM]"
msgstr ""
"obtén una potenciación permanente de dos atributos aleatorios\n"
"[CUESTA: 10 % de RUINA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:68"
msgid "You've attracted the attention of something evil..."
msgstr "Llamaste la atención de algo malvado…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:69"
msgid "BINDING AGONY"
msgstr "AGONÍA ATRAPANTE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:70"
msgid ""
"target enemy's damage is lowered by 1\n"
"[COST: 3 REASON]"
msgstr ""
"el daño del enemigo seleccionado baja en 1\n"
"[CUESTA: 3 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:71"
msgid "BINDING AGONY makes their movement slower!"
msgstr "¡AGONÍA ATRAPANTE le ralentiza!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:72"
msgid "WITNESS CURSE"
msgstr "PRESENCIAR MALDICIÓN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:73"
msgid ""
"converts all combat STAMINA damage taken into extra DOOM\n"
"[COST: 2 REASON]"
msgstr ""
"convierte todo el daño de VIGOR en combate en RUINA extra\n"
"[CUESTA: 2 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:74"
msgid ""
"WITNESS CURSE\n"
"[- STAMINA -> + DOOM]"
msgstr ""
"PRESENCIAR MALDICIÓN\n"
"[-VIGOR -> +RUINA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:75"
msgid "SHADOW SHROUD"
msgstr "SUDARIO SOMBRÍO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:76"
msgid ""
"for the duration of this mystery, ignore location's THREAT level\n"
"[COST: 3 REASON]"
msgstr ""
"durante la duración de este misterio, ignora el nivel de AMENAZA de la ubicación\n"
"[CUESTA: 3 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:77"
msgid "You feel more in tune with the weird..."
msgstr "Te sientes más a tono con lo extraño…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:78"
msgid "MEND"
msgstr "CURAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:79"
msgid ""
"gain 1 REASON\n"
"[COST: 2 STAMINA]"
msgstr ""
"obtén 1 de CORDURA\n"
"[CUESTA: 2 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:80"
msgid "You regain some of the lost REASON."
msgstr "Recuperas un poco de la CORDURA perdida."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:81"
msgid "VOID"
msgstr "VACÍO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «VOID» (woh_spell:81).
msgctxt "woh_spell:82"
msgid ""
"ignore the current event and instantly investigate a random OTHERWORLD location\n"
"[one time use only]\n"
"[COST: 3 REASON]"
msgstr ""
"ignora el evento actual e investiga de inmediato una ubicación aleatoria del MÁS ALLÁ\n"
"[uso único]\n"
"[CUESTA: 3 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:83"
msgid "CAUTERIZE"
msgstr "CAUTERIZAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:84"
msgid ""
"+2 STAMINA\n"
"[one time use only]"
msgstr ""
"+2 de VIGOR\n"
"[uso único]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «VOID» (woh_spell:81).
msgctxt "woh_spell:85"
msgid "The torn flesh closes, stopping the bleeding."
msgstr "La carne abierta se cierra y el sangrado se detiene."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:86"
msgid "MEMORY EXTRACT"
msgstr "EXTRACCIÓN DE RECUERDOS"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:87"
msgid ""
"+2 REASON\n"
"[COST: 10 EXP]"
msgstr ""
"+2 de CORDURA\n"
"[CUESTA: 10 de EXP]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:88"
msgid "Traumatic memories leave your mind..."
msgstr "Los recuerdos traumáticos abandonan tu mente…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#, fuzzy
#| msgid "This spells requires more EXPERIENCE."
msgctxt "woh_spell:89"
msgid "This spell requires more EXPERIENCE."
msgstr "Este hechizo requiere más EXPERIENCIA."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:90"
msgid "ASHEN CONTRACT"
msgstr "CONTRATO LÍVIDO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:91"
msgid ""
"immediately kills any non-eldritch enemy\n"
"[one time use only]\n"
"[COST: 7% DOOM]"
msgstr ""
"elimina de inmediato a cualquier enemigo que no sea éldrico\n"
"[uso único]\n"
"[CUESTA: 7 % de RUINA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:92"
msgid "It is done."
msgstr "Hecho."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:93"
msgid "MIDASU TOUCH"
msgstr "TOQUE DE MIDASU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:94"
msgid ""
"+1 FUNDS\n"
"[COST: 2 STAMINA]"
msgstr ""
"+1 de SALDO\n"
"[CUESTA: 2 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:95"
msgid "Your fingernail turns silver, you rip it off!"
msgstr "Tu uña se vuelve de plata, ¡te la sacas!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:96"
msgid "Your tooth turns to gold, you twist it off!"
msgstr "Tu diente se vuelve de oro, ¡te lo sacas!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:97"
msgid "FLESH REGROWTH"
msgstr "REGENERACIÓN DE CARNE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:98"
msgid ""
"+3 STAMINA\n"
"-2 MAX STAMINA"
msgstr ""
"+3 de VIGOR\n"
"-2 de VIGOR MÁXIMO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:99"
msgid "Your veins extend and seal the ripped flesh!"
msgstr "¡Tus venas se extienden y recuperan lo perdido!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:100"
msgid "EXPEL EVIL"
msgstr "EXPULSAR AL MAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:101"
msgid ""
"-6% DOOM\n"
"[one time use only]\n"
"[COST: 2 STAMINA]"
msgstr ""
"-6 % de RUINA\n"
"[uso único]\n"
"[CUESTA: 2 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:102"
msgid "You cough up blood and... s-something else..."
msgstr "Toses sangre y… a-algo más…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:103"
msgid "GROW TEETH"
msgstr "CRECIMIENTO DENTAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:104"
msgid ""
"adds a new combat action, [BITE], until the end of this mystery\n"
"[COST: 2 STAMINA]"
msgstr ""
"hasta terminar este misterio, agrega una acción de combate nueva, [MORDER]\n"
"[CUESTA: 2 de VIGOR]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:105"
msgid "You cough up blood and... something else..."
msgstr "Toses sangre y… algo más…"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:106"
msgid "You won't fit more teeth in your mouth."
msgstr "No caben más dientes en tu boca."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:107"
msgid "BRAIN WORMS"
msgstr "GUSANOS CEREBRALES"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:108"
msgid ""
"-2% DOOM\n"
"[one time use only]\n"
"[COST: 2 STAMINA]\n"
"[forgetting this SPELL costs 2 REASON]"
msgstr ""
"-2 % de RUINA\n"
"[uso único]\n"
"[CUESTA: 2 de VIGOR]\n"
"[olvidar este hechizo cuesta 2 de CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «BRAIN WORMS» (woh_spell:107). Opciones: [DELVED TOO DEEP].
msgctxt "woh_spell:109"
msgid "[DELVED TOO DEEP]"
msgstr "[INDAGAS DEMASIADO]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:110"
msgid "Forcing the worms out of your head isn't pleasant... (-2 REASON)"
msgstr "No es agradable expulsar a los gusanos en tu cabeza… (-2 de CORDURA)"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:111"
msgid "k"
msgstr "k"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:112"
msgid "a"
msgstr "a"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:113"
msgid "n"
msgstr "n"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «BRAIN WORMS» (woh_spell:107).
msgctxt "woh_spell:114"
msgid "a"
msgstr "a"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:115"
msgid "UNEARTHLY SUTURE"
msgstr "SUTURA SOBRENATURAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:116"
msgid ""
