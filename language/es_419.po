msgstr "BOSQUE"

msgctxt "woh_halo:99"
msgid "MANSION"
msgstr "MANSIÓN"

msgctxt "woh_halo:100"
msgid "VILLAGE"
msgstr "ALDEA"

msgctxt "woh_halo:101"
msgid "APARTMENTS"
msgstr "DEPARTAMENTOS"

msgctxt "woh_halo:102"
msgid "TIME PASSED"
