msgstr "Ya te diste un baño."

msgctxt "woh_home:56"
msgid "Weird, nothing happens."
msgstr "Raro, no pasa nada."

msgctxt "woh_home:57"
msgid "Inside a figurine you find some money. (+1 FUNDS)"
msgstr "Dentro de una estatuilla encuentras un poco de dinero. (+1 de SALDO)"

msgctxt "woh_home:58"
msgid "You stand before a mirror, wondering which outfit to wear."
msgstr "Te miras en el espejo, preguntándote que vestir."

msgctxt "woh_home:59"
msgid "Looking good."
msgstr "Te ves bien."

msgctxt "woh_home:60"
msgid "Another day begins..."
msgstr "Empieza otro día…"

msgctxt "woh_home:61"
msgid "Is it going to rain?"
msgstr "¿Irá a llover?"

msgctxt "woh_home:62"
msgid "You can't see anything."
msgstr "No logras ver nada."

msgctxt "woh_home:63"
msgid "Ominous black clouds circle the lighthouse..."
msgstr "Siniestras nubes oscuras rodean el faro…"

msgctxt "woh_home:64"
msgid "The ghost-gray mist envelops the whole town."
msgstr "La niebla gris envuelve toda la ciudad."

msgctxt "woh_home:65"
msgid "It has been raining since morning."
msgstr "Llueve desde la mañana."

msgctxt "woh_home:66"
msgid "It's a nice day outside."
msgstr "Es un hermoso día."

msgctxt "woh_home:67"
msgid "It's dark already."
msgstr "Ya está oscuro."

msgctxt "woh_home:68"
msgid "GET BACK TO THE TOWN SCREEN"
msgstr "VOLVER A LA PANTALLA DE LA CIUDAD"

msgctxt "woh_home:69"
