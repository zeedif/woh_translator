msgid "-1 modifier to all skill checks"
msgstr "-1 de modificadores a todas las revisiones de habilidades"

msgctxt "woh_chal:173"
msgid "[[DANGEROUS]]"
msgstr "[[PELIGROSO]]"

msgctxt "woh_chal:174"
msgid ""
"-1 modifier to all skill checks\n"
"---\n"
"STAMINA/REASON penalties increased"
msgstr ""
"-1 de modificadores a todas las revisiones de habilidades\n"
"---\n"
"mayor penalización de VIGOR/CORDURA"

msgctxt "woh_chal:175"
msgid "[[DOOMED]]"
msgstr "[[RUINA]]"

