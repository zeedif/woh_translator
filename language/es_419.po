msgid "HOME"
msgstr "CASA"

msgctxt "woh_halo:94"
msgid "DOWNTOWN"
msgstr "CENTRO DE LA CIUDAD"

msgctxt "woh_halo:95"
msgid "SCHOOL"
msgstr "ESCUELA"

msgctxt "woh_halo:96"
msgid "HOSPITAL"
msgstr "HOSPITAL"

msgctxt "woh_halo:97"
msgid "SEASIDE"
msgstr "COSTA"

msgctxt "woh_halo:98"
