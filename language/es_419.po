msgctxt "woh_ichi:81"
msgid "THE INCONCEIVABLE SADNESS"
msgstr "LA TRISTEZA INIMAGINABLE"

#. Descripción de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:82"
msgid "The insidious PARASITE swells in size, its tendrils snaking ever deeper into the crevices of your existence..."
msgstr "El pérfido PARÁSITO aumenta su tamaño, sus tentáculos se adentran en las profundidades de tu existencia…"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:83"
msgid "At the end of the mystery, raise the DOOM by:"
msgstr "Aumenta la RUINA al final del misterio en un:"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:84"
msgid "2% for each ALLY"
msgstr "2 % por cada ALIADO"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:85"
msgid "2% for each FUNDS"
msgstr "2 % por cada SALDO"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:86"
msgid "2% for each ITEM in inventory"
msgstr "2 % por cada OBJETO en el inventario"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:87"
msgid "2% for each SPELL learned"
msgstr "2 % por cada HECHIZO aprendido"

#. Parte de «THE INCONCEIVABLE SADNESS» (woh_ichi:81).
msgctxt "woh_ichi:88"
msgid "1% for every 10 EXP (rounded down)"
msgstr "1 % por cada 10 de EXP"

