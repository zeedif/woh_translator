msgstr "(completa al menos un misterio para guardar los avances)"

msgctxt "woh_home:70"
msgid "SAVE PROGRESS AND EXIT THE GAME"
msgstr "GUARDAR Y SALIR DEL JUEGO"

msgctxt "woh_home:71"
