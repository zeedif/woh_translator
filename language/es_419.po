msgstr "INICIAR SECUENCIA"

msgctxt "woh_comb:83"
msgid "CLEAR"
msgstr "BORRAR"

msgctxt "woh_comb:84"
msgid "TURN"
msgstr "¡TURNO"

msgctxt "woh_comb:85"
msgid "BEGINS!"
msgstr "EMPIEZA!"

msgctxt "woh_comb:86"
msgid "OFFENSIVE ACTIONS"
msgstr "ACCIONES OFENSIVAS"

msgctxt "woh_comb:87"
msgid "SUPPORT ACTIONS"
msgstr "ACCIONES DE APOYO"

msgctxt "woh_comb:88"
msgid "DEFENSIVE ACTIONS"
msgstr "ACCIONES DEFENSIVAS"

msgctxt "woh_comb:89"
msgid "SPIRITUAL ACTIONS"
msgstr "ACCIONES ESPIRITUALES"

msgctxt "woh_comb:90"
msgid "current time multiplier"
msgstr "multiplicador de tiempo actual"

msgctxt "woh_comb:91"
msgid ""
"HEALTH - defines the enemy's stamina.\n"
"You win the encounter by getting this to zero."
msgstr ""
"SALUD: define el vigor del enemigo.\n"
"Ganas el encuentro si lo llevas a cero."

msgctxt "woh_comb:92"
msgid "DAMAGE - after each sequence, enemies perform an attack draining your stamina (-STA), reason (-REA) or both (-ALL)."
msgstr "DAÑO: tras cada secuencia, los enemigos atacan y bajan tu vigor (-VIG), cordura (-COR) o ambas (-TODO)"

msgctxt "woh_comb:93"
msgid "POWER - this stat defines your chance to attack the enemy successfully. The higher its POWER, the harder it will be."
msgstr "PODER: este atributo define tus probabilidades de atacar con éxito al enemigo. A mayor PODER, más difícil será."

msgctxt "woh_comb:94"
msgid "ATTACK WITH YOUR WEAPON"
msgstr "ATACA CON TU ARMA"

msgctxt "woh_comb:95"
msgid "[needs an equipped weapon to perform this action]"
msgstr "[esta acción requiere que se equipe un arma]"

msgctxt "woh_comb:96"
