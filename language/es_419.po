msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: es_419\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "¡Tomaste un objeto del depósito!"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "¡Sin espacio para objetos!"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "DEPÓSITO"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "OBJETOS GUARDADOS"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "¡No tienes espacio! ¡Objeto guardado en el depósito!"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "Para subir de nivel, pulsa el botón parpadeante."

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "¡No tienes experiencia suficiente!"

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "HABLAR CON LA ESTUDIANTE"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "INSTALAR UN TELESCOPIO"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "VOLVER"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "No tienes un telescopio."

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "La estudiante murmura algo para sí misma."

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "Tal vez debas dejarla en paz."

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr "El agua helada te ayuda a ordenar tus ideas. (+1 de CORDURA)"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr "El agua caliente alivia tus músculos adoloridos. (+1 de VIGOR)"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"Clavar una muñeca de paja en este árbol te concederá tu deseo…\n"
"\n"
"por un precio, claro está."

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[aquí puedes clavar dos muñecas más]"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[aquí puedes clavar una muñeca más]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"No deberías regresar a este lugar.\n"
"(+1 % de RUINA)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "ÁRBOL DE LA BRUJA"

#. Descripción de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "Las leyendas cuentan que las raíces de este árbol llegan hasta la tumba de una bruja que fue linchada…"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr "Ves una billetera oculta bajo una rama en el suelo. (+2 de SALDO)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "La bruja enterrada cobra su cuota…"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "¡Tu cabeza se llena de cánticos prohibidos!"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr "¡De repente, te sientes mucho mejor! (+2 de VIGOR)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr ""
"pedir vigor\n"
"[+2 de VIGOR]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr ""
"pedir conocimientos\n"
"[+HECHIZO]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr ""
"pedir dinero\n"
"[+2 de SALDO]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr ""
"no es buena idea\n"
"[irse]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"Una joven policía te detiene.\n"
"\n"
"<<¿En qué podemos ayudar?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "COMISARÍA"

#. Descripción de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "Los policías en la comisaría se encuentran ocupados trabajando en varios casos extraños…"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "solicitar más patrullas policiales"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "quejarse de las patrullas policiales"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr ""
"comparte un poco de información\n"
"(11 de EXP -> 1 de SLD)"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "salir de la comisaría"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"El policía te da las gracias y promete que habrá más patrullas.\n"
"[disminuye el nivel de amenaza]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "El policía se disculpa y dice que no les quedan patrullas disponibles."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr ""
"El detective te da las gracias por la información y te entrega una recompensa.\n"
"[-11 de EXP / +1 de SALDO]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "El detective te da las gracias por la información, pero dice que no es suficiente como para una recompensa."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"¡Lograste entrar al faro maldito!\n"
"\n"
"Una corazonada te dice dos cosas: uno, que quien sea (o lo que sea) que esté detrás de los extraños acontecimientos debe estar en el piso más alto de este lugar, y dos, que debes huir de este lugar lo más rápido que puedas. Temes que no haya forma de regresar una vez comiences a subir estas escaleras…"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:41"
msgid "access storage"
msgstr "acceder al depósito"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "descansar un poco (+2 de RUINA)"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "empezar a subir"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr "Descansaste un poco. (+1 de CORDURA y VIGOR)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "FARO (PRIMER PISO)"

#. Descripción de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr "A medida que la anormal niebla lentamente te levanta, sientes alivio y te desplomas…"

#. Parte de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"Nubes oscuras se arremolinan alrededor del faro.\n"
"¿Llegaste demasiado tarde?"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "EL MONUMENTO"

#. Descripción de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "Olvidado por todos. La ENTIDAD EXTERIOR espera pacientemente a aquellos que le necesiten…"

#. Opción de «THE MONUMENT» (woh_addy:48). Opciones: leave without a sacrifice  / [angers the OUTER ENTITY].
msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr ""
"irse sin hacer un sacrificio \n"
"[enfurece a la ENTIDAD EXTERIOR]"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "Te cortas la mano y llenas el cuenco con tu sangre…"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "Sientes cómo te abandonan tus recuerdos más preciados…"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "Quemas el dinero en el cuenco…"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "Enfureciste a la ENTIDAD EXTERIOR…"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "Es algo arriesgado negociar con una ENTIDAD EXTERIOR, pero tal vez pueda retrasar la inminente ruina."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "alimentar a la ENTIDAD EXTERIOR con tu sangre"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr "entregar a la ENTIDAD EXTERIOR tus recuerdos más preciados"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "dejar un regalo material"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "Aún tienes algo de tiempo antes de que te llamen de la oficina."

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "ÁREA DE RECEPCIÓN"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "Esperas pacientemente en el área de recepción."

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "Muchos enfermos esperan a que el atareado personal del hospital los atienda."

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "entrar a la OFICINAL DEL MÉDICO (+2 % de RUINA)"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "ir al CORREDOR A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr ""
"entrar a la FARMACIA\n"
"(+3 % de RUINA)"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "Una enfermera pasa apresurada."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "OFICINA DEL MÉDICO"

#. Descripción de «DOCTOR'S OFFICE» (woh_addy:67).
msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "El área de emergencias está repleto, esto se debe a todas las cosas extrañas que están pasando en tu ciudad."

#. Parte de «DOCTOR'S OFFICE» (woh_addy:67).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"Al fin te llaman de la oficina del médico.\n"
"\n"
"<<Y bueno… ¿en qué puedo ayudarte?>>"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "SALIR"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[EN LAS TARJETAS DE LESIÓN HAY ACCIONES ADICIONALES DISPONIBLES]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "Aprovechas la oportunidad para robar un frasco de pastillas."

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "No deberías arriesgarte robando una botella más."

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "Sientes como si el cráneo mirase cada uno de tus movimientos."

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "CORREDOR A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "Te adentras en el corredor…"

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "regresar al ÁREA DE RECEPCIÓN"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "subir al ASCENSOR"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "entrar a la MORGUE"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "¿Qué haces aquí?"

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "La puerta de la morgue está cerrada."

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "CORREDOR B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "En contraste, el piso superior está inquietantemente silencioso…"

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "revisar la HABITACIÓN DE PACIENTES"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "No deberías molestar a los pacientes en recuperación."

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "DESCANSO EN LA CASA"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "Sí que se siente bien estar de vuelta en casa."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "VIGOR/CORDURA"

#. Descripción de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "El tiempo pasa volando, te preparas para salir y continuar con tu investigación."

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "RUINA"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "VIGOR/CORDURA"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"Momento… ¿qué es eso?\n"
"[ALGO MALVADO SABE DÓNDE VIVES]"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "Tomas una siesta en tu cama."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "Vendas tus heridas."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "Te das una larga ducha caliente."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "Tragas unos analgésicos."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "Llamas a tu mejor amigo y hablan de cosas sin importancia."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "Te sientas en un sofá y lees tu libro favorito."

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "CORREDOR DEL DEPARTAMENTO"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "Golpeas la puerta de tu amigo y esperas…"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr "<<Oye, idiota. Estoy contigo. ¿Por qué vamos de regreso a mi casa?>>"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr "<<Hola… Hoy estoy muy ocupado. Veámonos otro día, ¿ok?>>"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"Oh, Kana no está en casa.\n"
"Será mejor que vuelvas más tarde…"

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "Comprar objetos te quita tiempo valioso. (+4 % de RUINA)"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "Mm… ¿dónde está ese perro?"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "COMPRAR OBJETOS"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "SALIR SIN COMPRAR NADA"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "necesitas: T. DE YAKUZA"

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "OBJETOS DISPONIBLES"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "PRECIO"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "SALDO"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "Un objeto aleatorio con descuento."

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "REPUESTO"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "cambiar objetos (+3 % de RUINA)"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "Compraste un objeto nuevo."

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "No tienes dinero suficiente."

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "¡Guau!"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "-OBJETO EN DESCUENTO-"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "A la salida, te detienes en las máquinas expendedoras. (+2 % de RUINA)"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "COMPRAR OBJETOS"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"[entrar cuesta RUINA]\n"
"[saldo -> objetos]"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"[entrar cuesta RUINA]\n"
"[recupera VIGOR y CORDURA]"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "DESCANSAR"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "MÁQUINA EXPENDEDORA"

#. Descripción de «VENDING MACHINE» (woh_addy:124).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"Al entrar a la GUARIDA ILEGAL, ves de inmediato a la chica que te atacó y dejas caer la prescripción.\n"
"Antes de acercarte, lanzas la costosa medicina en la mesa.\n"
"\n"
"<<E-es el medicamento de mi abuela…?>> su mirada se ilumina.\n"
