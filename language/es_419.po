msgctxt "woh_halo:0"
msgid "PREPARING FOR INVESTIGATION"
msgstr "PREPARANDO LA INVESTIGACIÓN"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:1"
msgid "<<Is there even anything useful left?>>"
msgstr "<<¿Queda algo útil?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:2"
msgid "PREPARE"
msgstr "PREPARAR"

#. Descripción de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:3"
msgid "Looking carefully, you can find character-unique items to help you."
msgstr "Al mirar con más cuidado, ves que hay objetos únicos de personaje que te pueden servir."

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:4"
msgid ""
"[costs DOOM to enter]\n"
"[unique items]"
msgstr ""
"[cuesta RUINA entrar]\n"
"[objetos únicos]"

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:5"
msgid "KIRIE'S BAG"
msgstr "BOLSO DE KIRIE"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:6"
msgid "(while in inventory): forgetting SPELLS lowers REASON by 1-2 and increases DOOM by 1%, gain a random SPELL"
msgstr "En el inventario: olvidar HECHIZOS disminuye la CORDURA en 1-2 y se obtiene un HECHIZO aleatorio."

#. Parte de «PREPARE» (woh_halo:2).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:7"
msgid "<<I've been collecting these notes for quite some time now.>>"
msgstr "<<Desde hace un buen tiempo que estoy recolectando estas notas.>>"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:8"
msgid "An unseen force guides your hand to the bag..."
msgstr "Una fuerza invisible lleva tu mano al bolso…"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:9"
msgid "full of knowledge"
msgstr "rebosa conocimiento"

msgctxt "woh_halo:10"
msgid "AIKO'S PLUSH TOY"
msgstr "PELUCHE DE AIKO"

msgctxt "woh_halo:11"
msgid ""
"-1 incoming combat damage\n"
"-2 PERCEPTION; -2 LUCK"
msgstr ""
"-1 al daño de combate recibido\n"
"-2 de PERCEPCIÓN; -2 de SUERTE"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:12"
msgid "<<they are not real they are not real they are not real>>"
msgstr "<<no son reales no son reales no son reales>>"

msgctxt "woh_halo:13"
msgid "only friend"
msgstr "único amigo"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:14"
msgid "CIGARETTE CASE"
msgstr "CIGARRERA"

#. Descripción de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:15"
msgid "(while in inventory): 15% of regaining one CIGARETTE after investigating a location"
msgstr "15 % de probabilidad de recuperar un CIGARRILLO tras investigar un lugar"

#. Opción de «CIGARETTE CASE» (woh_halo:14). Opciones: <<This will stay in my family forever.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:16"
msgid "<<This will stay in my family forever.>>"
msgstr "<<Estará en mi familia para siempre>>"

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:17"
msgid "You smoke an old cigarette from your CIGARETTE CASE..."
msgstr "Sacas un cigarro de tu CIGARRERA y lo fumas…"

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:18"
msgid "grandpa's"
msgstr "del abuelo"

msgctxt "woh_halo:19"
msgid "VANITY MIRROR"
msgstr "ESPEJO"

msgctxt "woh_halo:20"
msgid "reveals extra information about event choices"
msgstr "revela información extra sobre elecciones en eventos"

msgctxt "woh_halo:21"
msgid "You can catch glimpses of the future in this tiny mirror..."
msgstr "En este pequeño espejo puedes ver guiños del futuro…"

msgctxt "woh_halo:22"
msgid "The VANITY MIRROR will start working next event."
msgstr "El ESPEJO comenzará a funcionar en el siguiente evento."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:23"
msgid "<<I'm so pretty-->>"
msgstr "<<Soy una hermosura…>>"

msgctxt "woh_halo:24"
msgid "FILM ROLL"
msgstr "ROLLO FOTOGRÁFICO"

msgctxt "woh_halo:25"
msgid "(use): -1 FUNDS; +10 EXPERIENCE"
msgstr "(al usar): -1 de SALDO; +10 de EXPERIENCIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:26"
msgid "<<I can only develop this at a trusted place>>"
msgstr "<<Debo revelarlo en un lugar de confianza>>"

msgctxt "woh_halo:27"
msgid "You develop the FILM ROLL containing crucial evidence!"
msgstr "¡Revelas el ROLLO FOTOGRÁFICO que contiene evidencia importante!"

msgctxt "woh_halo:28"
msgid "You can't afford that!"
msgstr "¡No te alcanza el dinero!"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:29"
msgid "<<contains evidence ...I think>>"
msgstr "<<Creo que contiene evidencia…>>"

msgctxt "woh_halo:30"
msgid "ANATOMY BOOK"
msgstr "LIBRO DE ANATOMÍA"

msgctxt "woh_halo:31"
msgid "(use): -2 STAMINA; +8 EXP"
msgstr "(al usar): -2 de VIGOR; +8 de EXPERIENCIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:32"
msgid "<<I can learn so much studying my own body...>>"
msgstr "<<Puedo aprender tanto si estudio mi propio cuerpo…>>"

msgctxt "woh_halo:33"
msgid "Slicing your body open, you learn new things about anatomy..."
msgstr "Si abres tu cuerpo, podrás aprender nuevas cosas de anatomía…"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:34"
msgid "<<I'm ill?>>"
msgstr "<<¿Tendré alguna enfermedad?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:35"
msgid "GUITAR"
msgstr "GUITARRA"

#. Descripción de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:36"
msgid "(while in inventory): resting regains more REASON, increases DOOM"
msgstr "(en el inventario): descansar recupera más CORDURA, aumenta RUINA"

#. Opción de «GUITAR» (woh_halo:35). Opciones: <<I worked all summer to buy this guitar.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:37"
msgid "<<I worked all summer to buy this guitar.>>"
msgstr "<<Trabajé todo el verano para comprar esta guitarra.>>"

#. Parte de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:38"
msgid "Your loud guitar practice can be heard across the whole building."
msgstr "Tus prácticas de guitarra se pueden oír en todo el edificio."

msgctxt "woh_halo:39"
msgid "HELL YEAH"
msgstr "OH, SÍ"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:40"
msgid "BLESSED SHELL"
msgstr "BALA BENDITA"

#. Descripción de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:41"
msgid "(use in combat): (+1 AMMO / +5% DOOM); +10 SHOOT DAMAGE for the duration of this combat"
msgstr "Usar en combate: (+1 de MUNICIÓN / +5 % de RUINA); +10 de DAÑO DE DISPARO durante la duración de este combate"

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:42"
msgid "<<I've loaded it with mom's silver jewelry...>>"
msgstr "<<Está cargada con las joyas de plata de mi mamá…>>"

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:43"
msgid "<<...sorry mom.>>"
msgstr "<<<Lo siento, mamá…>>"

#. Parte de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:44"
msgid "You can't use this outside of combat."
msgstr "No puedes usar esto fuera de combate."

#. Parte de «BLESSED SHELL» (woh_halo:40).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:45"
msgid "<<Should I?...>>"
msgstr "<<¿Debería…?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:46"
msgid "MARKED BIBLE"
msgstr "BIBLIA MARCADA"

#. Descripción de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:47"
msgid "(while in inventory): resting regains extra REASON/STAMINA, depending on character's FAITH level"
msgstr "(en el inventario): descansar otorga CORDURA/VIGOR extra, según el nivel de FE del personaje"

#. Opción de «MARKED BIBLE» (woh_halo:46). Opciones: <<I don't remember certain parts of it, is this real?>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:48"
msgid "<<I don't remember certain parts of it, is this real?>>"
msgstr "<<No recuerdo algunas partes, ¿es real?>>"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:49"
msgid "Reading the MARKED BIBLE, you find your inner peace. (+1 REASON)"
msgstr "Al leer la BIBLIA MARCADA, encuentras tu paz interna. (+1 de CORDURA)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:50"
msgid "MARKED BIBLE fills you with determination. (+1 STAMINA)"
msgstr "La BIBLIA MARCADA te llena de determinación. (+1 de VIGOR)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:51"
msgid "dies irae"
msgstr "dies irae"

msgctxt "woh_halo:52"
msgid "AYAKA'S CHALK"
msgstr "TIZA DE AYAKA"

msgctxt "woh_halo:53"
msgid "+2 DAMAGE against GHOST enemies"
msgstr "+2 de DAÑO contra enemigos FANTASMA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:54"
msgid "<<They died because of me...>>"
msgstr "<<Murieron por mi culpa…>>"

msgctxt "woh_halo:55"
msgid "used in rituals"
msgstr "se usa en rituales"

msgctxt "woh_halo:56"
msgid "BOOK STRAP"
msgstr "CORREA PARA LIBROS"

msgctxt "woh_halo:57"
msgid "faster combat actions for each BOOK item in the inventory"
msgstr "acciones de combate más rápidas para cada LIBRO en el inventario"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:58"
msgid "<<That's not the only book I've taken.>>"
msgstr "<<No es el único libro que me he llevado.>>"

msgctxt "woh_halo:59"
msgid "made of leather"
msgstr "hecha de cuero"

msgctxt "woh_halo:60"
msgid "CHECK BOOK"
msgstr "CHEQUERA"

msgctxt "woh_halo:61"
msgid "(use): +3 FUNDS; +4% DOOM"
msgstr "(al usar): +3 de SALDO; +4 % de RUINA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:62"
msgid "<<Using this will make me easier to track down...>>"
msgstr "<<Usar esto hará que sea más fácil de rastrear…>>"

msgctxt "woh_halo:63"
msgid "You've used your CHECK BOOK."
msgstr "Usaste tu CHEQUERA."

msgctxt "woh_halo:64"
msgid "family's fortune"
msgstr "la fortuna familiar"

msgctxt "woh_halo:65"
msgid "BASEBALL"
msgstr "PELOTA DE BÉISBOL"

msgctxt "woh_halo:66"
msgid "(use in combat): lower the ENEMY's power down to 0"
msgstr "Usar en combate: baja a 0 el PODER del enemigo"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:67"
msgid "<<I'm not the best pitcher but it must be enough.>>"
msgstr "<<No seré la mejor persona lanzando, pero con esto debe bastar.>>"

msgctxt "woh_halo:68"
msgid "You throw the BASEBALL at your enemy!"
msgstr "¡Lanzas la PELOTA a tu enemigo!"

msgctxt "woh_halo:69"
msgid "only one I got"
msgstr "la única que tengo"

msgctxt "woh_halo:70"
msgid "FAVORITE SNACKS"
msgstr "BOCADILLOS FAVORITOS"

msgctxt "woh_halo:71"
msgid "(use): +3 REASON and STAMINA"
msgstr "(al usar): +3 de CORDURA y VIGOR"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:72"
msgid "<<I heard they are going to stop the production of these because they are too damn tasty!-->>"
msgstr "<<¡Oí que van a dejar de producirlos porque son demasiado buenos…!>>"

msgctxt "woh_halo:73"
msgid "You eat your FAVORITE SNACKS."
msgstr "Comes tus BOCADILLOS FAVORITOS"

msgctxt "woh_halo:74"
msgid "yum yum"
msgstr "ñam, ñam"

msgctxt "woh_halo:75"
msgid "You rummage through your belongings trying to find anything that will help you."
msgstr "Revisas entre tus pertenencias para ver si encuentras algo útil."

msgctxt "woh_halo:76"
msgid "You finally pick up"
msgstr "Finalmente, encuentras algo."

msgctxt "woh_halo:77"
msgid ""
"Hopefully, it will be enough.\n"
"(+5% DOOM)"
msgstr ""
"Esperemos que sea suficiente.\n"
"(+5 % de RUINA)"

msgctxt "woh_halo:78"
msgid ""
"You don't find anything except some loose change laying around.\n"
"(+1 FUNDS / +2% DOOM)"
msgstr ""
"No encuentras nada más que un poco de cambio.\n"
"(+1 de SALDO / +2 % de RUINA)"

msgctxt "woh_halo:79"
msgid "It's dangerous here, your STAMINA penalty increased!"
msgstr "Es peligroso aquí, ¡aumentó tu penalización de VIGOR!"

msgctxt "woh_halo:80"
msgid "It's dangerous here, your REASON penalty increased!"
msgstr "Es peligroso aquí, ¡aumentó tu penalización de VIGOR!"

msgctxt "woh_halo:81"
msgid ""
"\n"
"[DOOM EFFIGY]: DOOM lowered"
msgstr ""
"\n"
"[EFIGIE DE RUINA]: Baja la RUINA"

msgctxt "woh_halo:82"
msgid "SKIP SUITCASE SCREEN: ON/OFF"
msgstr "SALTAR PANTALLA DEL MALETÍN: SÍ/NO"

msgctxt "woh_halo:83"
msgid ""
"SKIP CARD PACK SCREEN: ON/OFF\n"
"(all packs enabled)"
msgstr ""
"SALTAR PANTALLA DE P. DE CARTAS: SÍ/NO\n"
"(todos los paquetes activos)"

msgctxt "woh_halo:84"
msgid "CREEPY NEIGHBOR: ON/OFF"
msgstr "VECINO RARO: Sí/NO"

msgctxt "woh_halo:85"
msgid "CHECK FOR CONNECTED GAMEPADS: ON/OFF"
msgstr "COMPROBAR CONTROL CONECTADO: SÍ/NO"

msgctxt "woh_halo:86"
msgid "WAVY EFFECT: ON/OFF"
msgstr "EFECTO DE ONDAS: SÍ/NO"

msgctxt "woh_halo:87"
msgid "SKIP PLAYTHROUGH INTRO"
msgstr "SALTAR INTRO DEL JUEGO"

msgctxt "woh_halo:88"
msgid "SKIP MYSTERY TUTORIAL"
msgstr ""
"SALTAR TUTORIAL DE MISTERIOS\n"
"SÍ/NO"

msgctxt "woh_halo:89"
msgid "MOUSE TRAIL: ON/OFF"
msgstr "RASTRO DEL MOUSE: Sí/NO"

msgctxt "woh_halo:90"
msgid "SKIP PALETTE CUSTOMIZATION"
msgstr "SALTAR PERSONALIZACIÓN DE PALETA"

msgctxt "woh_halo:91"
msgid "EXTRA MATH DISPLAYED: ON/OFF"
msgstr "MOSTRAR MATEMÁTICAS EXTRA: SÍ/NO"

msgctxt "woh_halo:92"
msgid "EXTRA INFORMATION DISPLAYED: ON/OFF"
msgstr "MOSTRAR INFO EXTRA: SÍ/NO"

