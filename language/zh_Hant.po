#. Diálogo o pensamiento entre << >>.
msgctxt "woh_spell:126"
msgid "<<thanks for saving me>>"
msgstr "「謝謝你救了我」"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:127"
msgid "[gallery curator]"
msgstr "[畫廊策展人]"

