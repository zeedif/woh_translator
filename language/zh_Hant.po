msgstr "使你的金錢加倍！"

msgctxt "woh_enm:28"
msgid "What went wrong?!... (+3% DOOM)"
msgstr "是不是做錯了什麼……？（+3% 末日）"

msgctxt "woh_enm:29"
msgid "You don't have enough experience!"
msgstr "你的經驗不足！"

