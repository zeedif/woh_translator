msgstr "家"

msgctxt "woh_halo:94"
msgid "DOWNTOWN"
msgstr "市區"

msgctxt "woh_halo:95"
msgid "SCHOOL"
msgstr "學校"

msgctxt "woh_halo:96"
msgid "HOSPITAL"
msgstr "醫院"

msgctxt "woh_halo:97"
msgid "SEASIDE"
msgstr "海邊"

msgctxt "woh_halo:98"
msgid "FOREST"
msgstr "森林"

msgctxt "woh_halo:99"
msgid "MANSION"
msgstr "豪宅"

msgctxt "woh_halo:100"
msgid "VILLAGE"
msgstr "村子"

msgctxt "woh_halo:101"
msgid "APARTMENTS"
msgstr "公寓"

msgctxt "woh_halo:102"
