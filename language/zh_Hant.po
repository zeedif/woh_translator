msgstr "公寓威脅等級"

msgctxt "woh_addy:215"
msgid "'S THREAT LEVEL"
msgstr "威脅等級"

msgctxt "woh_addy:216"
msgid ""
"YOU CAN'T INVESTIGATE\n"
"YOUR HOME"
msgstr ""
"無法調查\n"
"你家"

msgctxt "woh_addy:217"
msgid "INVESTIGATE"
msgstr "調查"

msgctxt "woh_addy:218"
msgid "This city is changing so fast you can barely recognize it anymore..."
msgstr "你對這座日新月異的城市感到很陌生……"

msgctxt "woh_addy:219"
msgid "[CHOOSE UP TO TWO DIFFERENT ADDITIONAL ACTIONS PER LOCATION FOR THIS PLAYTHROUGH.]"
msgstr "[在本次遊玩中的每個地點，最多選擇兩種不同的額外行動。]"

msgctxt "woh_addy:220"
msgid "[CHOOSE ONE ADDITIONAL ACTION PER LOCATION THAT FITS YOUR TASTE.]"
msgstr "[在每個地點選擇一種符合你喜好的額外行動。]"

msgctxt "woh_addy:221"
msgid "randomize and continue"
msgstr "隨機並繼續"

msgctxt "woh_addy:222"
msgid "SAVE"
msgstr "儲存"

msgctxt "woh_addy:223"
msgid "LOAD"
msgstr "載入"

msgctxt "woh_addy:224"
msgid "confirm and CONTINUE"
msgstr "確認並繼續"

msgctxt "woh_addy:225"
msgid "HOME"
msgstr "家"

msgctxt "woh_addy:226"
