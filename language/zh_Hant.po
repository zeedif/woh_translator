msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: zh_Hant\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "你拿出了儲物箱的物品！"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "沒有空間容納更多物品！"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "儲物箱"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "存放的物品"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "空間不足！將物品放入了儲物箱中！"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "若要提升等級，請按下閃爍中的按鈕。"

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "你的經驗不足！"

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "與學生交談"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "設置望遠鏡"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "返回"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "你沒有望遠鏡。"

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "學生正在喃喃自語。"

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "你最好離她遠一點。"

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr "冷水幫助你釐清了思緒。（+1 理智）"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr "熱水幫助你舒緩了酸痛的肌肉。（+1 體力）"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"將稻草人釘在這棵樹上，就能實現你的願望……\n"
"\n"
"但你得為此付出代價。"

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[你可以在此再釘兩個稻草人]"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[你可以在此再釘一個稻草人]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"你不應該再來這裡。\n"
"（+1% 末日）"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "女巫之樹"

#. Descripción de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "相傳在這棵樹底下，埋葬了一名遭到絞死的女巫……"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr "你在掉落的樹枝下發現一個皮夾。（+2 金錢）"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "葬身地底的女巫將使你受苦……"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "你的腦海湧現出禁忌的咒文！"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr "你感到舒服多了！（+2 體力）"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr ""
"祈求力量\n"
"[+2 體力]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr ""
"祈求知識\n"
"[+ 咒語]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr ""
"祈求金錢\n"
"[+2 金錢]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr ""
"這不是個好主意\n"
"[離開]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"一位年輕的女警攔住你。\n"
"\n"
"「請問您需要什麼樣的協助呢？」"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "警察局"

#. Descripción de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "警察局中的員警忙著處理各式詭異的案件……"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "請求加強巡邏警力"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "抱怨巡邏警員擾民"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr ""
"分享情報\n"
"（11 經驗 -> 1 金錢）"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "離開警察局"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"員警對你致謝並保證會加強巡邏警力。\n"
"[威脅等級降低]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "員警對你致歉並表示已無多餘警力可支援巡邏。"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr ""
"警探感謝你的情報並給予獎勵。\n"
"[-11 經驗/+1 金錢]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "警探雖然感謝你的情報，但表示這還不足以讓你獲得獎勵。"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"你終於進到了受詛咒的燈塔！\n"
"\n"
"直覺告訴你：詭異事件背後的主謀者，就在這棟建築物的頂樓等著你；而且，你該趕快逃離這裡，越遠越好。你害怕自己一旦走上這座樓梯，\n"
"就再也無法回頭了……"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:41"
msgid "access storage"
msgstr "使用儲物箱"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "休息一下（+2% 末日）"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "走上樓梯"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr "你休息了一陣子。（+1 理智與體力）"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "燈塔（一樓）"

#. Descripción de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr ""
"在眼前那團不自然的雲霧消散之後，\n"
"你終於鬆了一口氣，\n"
"整個人直接躺到了地上……"

#. Parte de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"黑色的雲霧仍環繞在燈塔四周。\n"
"難道一切都已經太遲了嗎？"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "遺址"

#. Descripción de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "眾人忘卻的外神，耐心等待著需要祂的人……"

#. Opción de «THE MONUMENT» (woh_addy:48). Opciones: leave without a sacrifice  / [angers the OUTER ENTITY].
msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr ""
"未獻祭便離去\n"
"[觸怒外神]"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "你在手上割出一道傷口，用自己的鮮血盛滿了碗……"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "你感覺得到珍貴的回憶逐漸離你而去……"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "你在碗中燃燒金錢……"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "你觸怒了外神……"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "與外神談判非常危險，但那或許能暫緩末日的到來？"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "將你的鮮血獻予外神"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr ""
"將你珍貴的回憶\n"
"獻予外神"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "留下禮品"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "你在進入診間之前仍有一點時間。"

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "候診室"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "你在候診室耐心地等待著。"

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "醫護人員正忙著為病患看診。"

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "進入診間（+2% 末日）"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "前往走廊 A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr ""
"進入藥局\n"
"（+3% 末日）"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "一位護理師急忙走過你身邊。"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "診間"

#. Descripción de «DOCTOR'S OFFICE» (woh_addy:67).
msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "城鎮中發生的詭異事件導致急診部人滿為患。"

#. Parte de «DOCTOR'S OFFICE» (woh_addy:67).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"終於輪到你看診了。\n"
"\n"
"「你最近身體有哪裡不舒服嗎？」"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "離開"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[傷勢卡上多了可選擇的行動]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "你趁機偷了一瓶藥。"

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "再偷一瓶有點太冒險了。"

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "那顆骷髏頭似乎在觀察你的一舉一動。"

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "走廊 A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "你往走廊深處邁進……"

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "返回候診室"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "搭乘電梯"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "進入停屍間"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "你在這裡做什麼？"

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "停屍間的大門緊閉。"

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "走廊 B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "樓上顯得異常安靜……"

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "查看病房"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "你不該打擾休養中的病患。"

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "在家休息"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "回家的感覺真好。"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "體力/理智"

#. Descripción de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "時光飛逝，你準備好出門，繼續展開那漫長的調查。"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "末日"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "體力/理智"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"等等……那是什麼？\n"
"[惡之根源知曉了你的住處]"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "你在床上小睡了一下。"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "你包紮好了傷口。"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "你洗了很久的熱水澡。"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "你吞了幾顆止痛藥。"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "你用電話和朋友聊了許多無關緊要的事。"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "你坐在沙發上讀你的愛書。"

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "公寓走廊"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "你敲了你朋友家的門……"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr ""
"「白癡喔，\n"
"我就在你旁邊欸。\n"
"回我家是要幹嘛？」"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr "「嗨……我今天真的很忙。我們之後再找個時間出去玩吧。」"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"可奈不在家的樣子……\n"
"之後再過來好了……"

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "購物花了你不少寶貴的時間。（+4% 末日）"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "那隻狗呢……？"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "商店"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "什麼都不買就離開"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "需要物品「極道卡」"

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "可購買物品"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "價格"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "金錢"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "隨機的一件特價品。"

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "補貨"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "更新物品（+3% 末日）"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "你購買了新物品。"

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "你的金錢不足。"

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "汪汪！"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "「特價商品」"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "在離開的路上，你在販賣機前停下了腳步。（+1% 末日）"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "商店"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"[進入會提高末日]\n"
"[金錢 -> 物品]"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"[進入會提高末日]\n"
"[恢復體力與理智]"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "休息"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "飲料販賣機"

#. Descripción de «VENDING MACHINE» (woh_addy:124).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"一進到非法據點，你立刻認出那個攻擊你之後掉了處方箋的女孩。\n"
"\n"
"你在靠近她之前將昂貴的藥物丟到了桌上。\n"
"\n"
"「那、那是我奶奶的藥嗎……？」她眼睛一亮。\n"
"「我還以為永遠找不到那個處方了……\n"
"但你為什麼要幫我？」"

