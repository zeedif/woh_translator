msgstr "焦慮症"

msgctxt "woh_perk:294"
msgid "lose 1 REASON at the start of each enemy encounter"
msgstr "每次戰鬥開始時失去 1 理智"

msgctxt "woh_perk:295"
msgid "<<I'm worried>>"
msgstr "「我好擔心」"

msgctxt "woh_perk:296"
msgid "W-who c-could it be?... (-1 REASON)"
msgstr "是、是誰在那裡……？（-1 理智）"

msgctxt "woh_perk:297"
msgid "IRRATIONAL"
msgstr "神智不清"

msgctxt "woh_perk:298"
msgid "(buying an ITEM): small chance of buying another ITEM instead"
msgstr ""
"（購買物品時）：\n"
"低機率購買另一項物品"

msgctxt "woh_perk:299"
msgid "<< ... >>"
msgstr "「……」"

