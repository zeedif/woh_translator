msgid "AVAILABLE PERKS"
msgstr "可用特长"

msgctxt "woh_halo:108"
msgid ""
"You've advanced to the next experience level.\n"
"Choose one perk and one stat upgrade.\n"
"\n"
"[CHOSEN:"
msgstr ""
"你已升级至下一经验等级。\n"
"选择一项特长与属性升级。\n"
"\n"
"[选择："

msgctxt "woh_halo:109"
msgid "(select perk and stat)"
msgstr "（选择特长与属性）"

msgctxt "woh_halo:110"
msgid "REROLL PERKS"
msgstr "重骰特长"

msgctxt "woh_halo:111"
msgid "+4% DOOM"
msgstr "+4%灾厄"

msgctxt "woh_halo:112"
msgid "The group must be there somewhere..."
msgstr "那群人一定就在某处……"

msgctxt "woh_halo:113"
