msgstr "进入医院"

msgctxt "woh_dec:117"
msgid "shop for items"
msgstr "购买物品"

msgctxt "woh_dec:118"
msgid "rest"
msgstr "休息"

msgctxt "woh_dec:119"
msgid "each combat encounter"
msgstr "每次战斗遭遇"

msgctxt "woh_dec:120"
msgid "MYSTERY MONOGRAPH"
msgstr "谜团专题"

msgctxt "woh_dec:121"
msgid "ENDINGS ENCYCLOPEDIA allows you to revisit all unlocked ending screens."
msgstr "《结局百科》可让你再次查看所有已解锁的结局界面。"

msgctxt "woh_dec:122"
msgid "MYSTERY MONOGRAPH compiles all mystery endings you've seen."
msgstr "《谜团专题》汇集了你已看过的所有谜团结局。"

msgctxt "woh_dec:123"
msgid "ACCESS ROOFTOP"
msgstr "前往屋顶"

msgctxt "woh_dec:124"
msgid "<<I've overheard my parents talking about a horrible accident. They said that the girl's father went mad from grief...>>"
msgstr "<<我无意中听到父母谈论一起可怕的事故。他们说那个女孩的父亲在悲痛之下发疯了……>>"

msgctxt "woh_dec:125"
msgid "<<What's that?>>"
msgstr "<<那是什么？>>"

msgctxt "woh_dec:126"
msgid "The girl whispers"
msgstr "女孩轻声说道"

msgctxt "woh_dec:127"
msgid "[GRAFT BEAR CLAWS TO YOUR TOES]"
msgstr "[将熊爪移植到你的趾头上]"

msgctxt "woh_dec:128"
msgid ""
"new random INJURY each mystery\n"
"+2 KICK damage"
msgstr ""
"每个谜团新增随机伤势\n"
"+2踢踹伤害"

msgctxt "woh_enm:0"
msgid "[MONSTER]"
msgstr "[怪物]"

msgctxt "woh_enm:1"
