msgctxt "woh_comb:83"
msgid "CLEAR"
msgstr "LIMPIAR"

msgctxt "woh_comb:84"
msgid "TURN"
msgstr "TURNO"

msgctxt "woh_comb:85"
msgid "BEGINS!"
msgstr "¡COMIENZA!"

msgctxt "woh_comb:86"
msgid "OFFENSIVE ACTIONS"
