msgctxt "woh_comb:87"
msgid "SUPPORT ACTIONS"
msgstr "ACCIONES DE APOYO"

msgctxt "woh_comb:88"
msgid "DEFENSIVE ACTIONS"
msgstr "ACCIONES DEFENSIVAS"

msgctxt "woh_comb:89"
msgid "SPIRITUAL ACTIONS"
msgstr "ACCIONES ESPIRITUALES"

msgctxt "woh_comb:90"
msgid "current time multiplier"
msgstr "multiplicador de tiempo actual"

msgctxt "woh_comb:91"
msgid ""
"HEALTH - defines the enemy's stamina.\n"
"You win the encounter by getting this to zero."
msgstr ""
"SALUD: determina la resistencia del enemigo.\n"
"Ganas el encuentro cuando este valor llega a cero."

msgctxt "woh_comb:92"
msgid "DAMAGE - after each sequence, enemies perform an attack draining your stamina (-STA), reason (-REA) or both (-ALL)."
msgstr "DAÑO: después de cada secuencia, los enemigos realizan un ataque que reduce tu STAMINA (-STA), REASON (-REA) o ambas (-ALL)."

msgctxt "woh_comb:93"
msgid "POWER - this stat defines your chance to attack the enemy successfully. The higher its POWER, the harder it will be."
msgstr "PODER: esta estadística determina tus probabilidades de atacar al enemigo con éxito. Cuanto mayor sea su PODER, más difícil será."

msgctxt "woh_comb:94"
msgid "ATTACK WITH YOUR WEAPON"
msgstr "ATACAR CON TU ARMA"

msgctxt "woh_comb:95"
msgid "[needs an equipped weapon to perform this action]"
msgstr "[necesitas tener un arma equipada para realizar esta acción]"

msgctxt "woh_comb:96"
msgid "KICK"
msgstr "PATADA"

msgctxt "woh_comb:97"
msgid "[attack without a weapon]"
msgstr "[atacar sin un arma]"

msgctxt "woh_comb:98"
msgid "STRONG ATTACK"
msgstr "ATAQUE FUERTE"

msgctxt "woh_comb:99"
msgid "LOOK FOR AN IMPROVISED WEAPON"
msgstr "BUSCAR UN ARMA IMPROVISADA"

msgctxt "woh_comb:100"
msgid "pick up a random improvised weapon"
msgstr "recoge un arma improvisada aleatoria"

msgctxt "woh_comb:101"
msgid "You missed the attack!"
msgstr "¡Has fallado el ataque!"

msgctxt "woh_comb:102"
msgid "You prepare to strike..."
msgstr "Te preparas para atacar..."

msgctxt "woh_comb:103"
msgid ""
"[Fill the COMBAT SEQUENCE (white bar) with combat moves and click the 'LAUNCH SEQUENCE' to attack your enemy.]\n"
"\n"
"(right click) - delete the last combat move"
msgstr ""
"[Para atacar, llena la SECUENCIA DE COMBATE (barra blanca) con movimientos de combate y haz clic en «INICIAR SECUENCIA».]\n"
"\n"
"(clic derecho): elimina el último movimiento de combate"

msgctxt "woh_comb:104"
msgid "[you can't run from this encounter]"
msgstr "[no puedes huir de este encuentro]"

msgctxt "woh_comb:105"
msgid "RUN AWAY"
msgstr "HUIR"

msgctxt "woh_comb:106"
msgid "PREPARE YOUR ATTACK"
msgstr "PREPARAR TU ATAQUE"

msgctxt "woh_comb:107"
msgid "next attack is guaranteed to hit."
msgstr "el siguiente ataque acertará con seguridad."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_comb:108"
msgid "ATTACK BOOST"
msgstr "AUMENTO DE ATAQUE"

#. Descripción de «ATTACK BOOST» (woh_comb:108).
msgctxt "woh_comb:109"
msgid "your next attack has an additional 10% chance to hit; this effect stacks"
msgstr "tu próximo ataque tiene un 10% más de probabilidad de impactar; este efecto se acumula"

#. Opción de «ATTACK BOOST» (woh_comb:108). Opciones: BITE · You bite · Target.
msgctxt "woh_comb:110"
msgid "BITE"
msgstr "MORDER"

#. Opción de «ATTACK BOOST» (woh_comb:108). Opciones: BITE · You bite · Target.
msgctxt "woh_comb:111"
msgid "You bite"
msgstr "Muerdes"

#. Opción de «ATTACK BOOST» (woh_comb:108). Opciones: BITE · You bite · Target.
msgctxt "woh_comb:112"
msgid "Target"
msgstr "Objetivo"

#. Parte de «ATTACK BOOST» (woh_comb:108).
msgctxt "woh_comb:113"
msgid "Target the other enemy."
msgstr "Apunta al otro enemigo."

msgctxt "woh_comb:114"
msgid "ASSESS THE SITUATION"
msgstr "EVALUAR LA SITUACIÓN"

msgctxt "woh_comb:115"
msgid "learn about your enemy"
msgstr "averigua más sobre tu enemigo"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_comb:116"
msgid "BOW"
msgstr "INCLINARSE"

#. Descripción de «BOW» (woh_comb:116).
msgctxt "woh_comb:117"
msgid ""
"a part of a ritual (Most combat rituals are a combination of five BOWS and CLAPS.\n"
"Even if you don't get it right, you'll be provided with a hint.)"
msgstr ""
"una parte de un ritual (La mayoría de los rituales de combate combinan cinco INCLINACIONES y APLAUSOS.\n"
"Aunque no lo hagas bien, recibirás una pista.)"

#. Opción de «BOW» (woh_comb:116). Opciones: CLAP.
msgctxt "woh_comb:118"
msgid "CLAP"
msgstr "APLAUDIR"

#. Parte de «BOW» (woh_comb:116).
msgctxt "woh_comb:119"
msgid "NO HOPE!"
msgstr "¡NO HAY ESPERANZA!"

#. Parte de «BOW» (woh_comb:116).
msgctxt "woh_comb:120"
msgid "run from the horrible beast like a coward"
msgstr "huye de la horrible bestia como un cobarde"

#. Parte de «BOW» (woh_comb:116).
msgctxt "woh_comb:121"
msgid "THIS IS TOO MUCH!"
msgstr "¡ESTO ES DEMASIADO!"

#. Parte de «BOW» (woh_comb:116).
msgctxt "woh_comb:122"
msgid "You close your eyes, fighting the increasing dizziness..."
msgstr "Cierras los ojos mientras luchas contra el mareo cada vez más intenso..."

#. Parte de «BOW» (woh_comb:116).
msgctxt "woh_comb:123"
msgid ""
"ends the encounter for a DOOM penalty\n"
"[+0% DOOM]"
msgstr ""
"termina el encuentro a cambio de una penalización de DOOM\n"
"[+0% de DOOM]"

msgctxt "woh_comb:124"
