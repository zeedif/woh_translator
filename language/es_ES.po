msgctxt "woh_halo:0"
msgid "PREPARING FOR INVESTIGATION"
msgstr "PREPARATIVOS PARA LA INVESTIGACIÓN"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:1"
msgid "<<Is there even anything useful left?>>"
msgstr "<<¿Queda algo útil por aquí?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:2"
msgid "PREPARE"
msgstr "PREPARAR"

#. Descripción de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:3"
msgid "Looking carefully, you can find character-unique items to help you."
msgstr "Si buscas con atención, puedes encontrar objetos exclusivos de cada personaje que te ayudarán."

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:4"
msgid ""
"[costs DOOM to enter]\n"
"[unique items]"
msgstr ""
"[cuesta DOOM entrar]\n"
"[objetos exclusivos]"

#. Opción de «PREPARE» (woh_halo:2). Opciones: [costs DOOM to enter] / [unique items] · KIRIE'S BAG.
msgctxt "woh_halo:5"
msgid "KIRIE'S BAG"
msgstr "BOLSO DE KIRIE"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:6"
msgid "(while in inventory): forgetting SPELLS lowers REASON by 1-2 and increases DOOM by 1%, gain a random SPELL"
msgstr "(mientras esté en el inventario): olvidar HECHIZOS reduce la CORDURA en 1-2 y aumenta la DOOM un 1%; aprende un HECHIZO aleatorio"

#. Parte de «PREPARE» (woh_halo:2).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:7"
msgid "<<I've been collecting these notes for quite some time now.>>"
msgstr "<<Llevo bastante tiempo recopilando estas notas.>>"

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:8"
msgid "An unseen force guides your hand to the bag..."
msgstr "Una fuerza invisible guía tu mano hacia el bolso..."

#. Parte de «PREPARE» (woh_halo:2).
msgctxt "woh_halo:9"
msgid "full of knowledge"
msgstr "lleno de conocimientos"

msgctxt "woh_halo:10"
msgid "AIKO'S PLUSH TOY"
msgstr "PELUCHE DE AIKO"

msgctxt "woh_halo:11"
msgid ""
"-1 incoming combat damage\n"
"-2 PERCEPTION; -2 LUCK"
msgstr ""
"-1 al daño recibido en combate\n"
"-2 PERCEPCIÓN; -2 SUERTE"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:12"
msgid "<<they are not real they are not real they are not real>>"
msgstr "<<no son reales no son reales no son reales>>"

msgctxt "woh_halo:13"
msgid "only friend"
msgstr "único amigo"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:14"
msgid "CIGARETTE CASE"
msgstr "CIGARRERA"

#. Descripción de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:15"
msgid "(while in inventory): 15% of regaining one CIGARETTE after investigating a location"
msgstr "(mientras esté en el inventario): 15% de probabilidad de recuperar un CIGARRILLO tras investigar una ubicación"

#. Opción de «CIGARETTE CASE» (woh_halo:14). Opciones: <<This will stay in my family forever.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:16"
msgid "<<This will stay in my family forever.>>"
msgstr "<<Esto permanecerá en mi familia para siempre.>>"

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:17"
msgid "You smoke an old cigarette from your CIGARETTE CASE..."
msgstr "Fumas un viejo cigarrillo de tu CIGARRERA..."

#. Parte de «CIGARETTE CASE» (woh_halo:14).
msgctxt "woh_halo:18"
msgid "grandpa's"
msgstr "del abuelo"

msgctxt "woh_halo:19"
msgid "VANITY MIRROR"
msgstr "ESPEJO DE TOCADOR"

msgctxt "woh_halo:20"
msgid "reveals extra information about event choices"
msgstr "revela información adicional sobre las opciones de los eventos"

msgctxt "woh_halo:21"
msgid "You can catch glimpses of the future in this tiny mirror..."
msgstr "Puedes vislumbrar el futuro en este pequeño espejo..."

msgctxt "woh_halo:22"
msgid "The VANITY MIRROR will start working next event."
msgstr "El ESPEJO DE TOCADOR empezará a funcionar en el próximo evento."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:23"
msgid "<<I'm so pretty-->>"
msgstr "<<Soy tan guapa...>>"

msgctxt "woh_halo:24"
msgid "FILM ROLL"
msgstr "ROLLO DE PELÍCULA"

msgctxt "woh_halo:25"
msgid "(use): -1 FUNDS; +10 EXPERIENCE"
msgstr "(usar): -1 FONDOS; +10 EXPERIENCIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:26"
msgid "<<I can only develop this at a trusted place>>"
msgstr "<<Solo puedo revelar esto en un lugar de confianza.>>"

msgctxt "woh_halo:27"
msgid "You develop the FILM ROLL containing crucial evidence!"
msgstr "¡Revelas el ROLLO DE PELÍCULA que contiene pruebas cruciales!"

msgctxt "woh_halo:28"
msgid "You can't afford that!"
msgstr "¡No puedes permitírtelo!"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:29"
msgid "<<contains evidence ...I think>>"
msgstr "<<contiene pruebas... creo>>"

msgctxt "woh_halo:30"
msgid "ANATOMY BOOK"
msgstr "LIBRO DE ANATOMÍA"

msgctxt "woh_halo:31"
msgid "(use): -2 STAMINA; +8 EXP"
msgstr "(usar): -2 RESISTENCIA; +8 EXP"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:32"
msgid "<<I can learn so much studying my own body...>>"
msgstr "<<Puedo aprender muchísimo estudiando mi propio cuerpo...>>"

msgctxt "woh_halo:33"
msgid "Slicing your body open, you learn new things about anatomy..."
msgstr "Al abrirte el cuerpo, aprendes cosas nuevas sobre anatomía..."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:34"
msgid "<<I'm ill?>>"
msgstr "<<¿Estoy enferma?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:35"
msgid "GUITAR"
msgstr "GUITARRA"

#. Descripción de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:36"
msgid "(while in inventory): resting regains more REASON, increases DOOM"
msgstr "(mientras esté en el inventario): descansar recupera más CORDURA, pero aumenta la DOOM"

#. Opción de «GUITAR» (woh_halo:35). Opciones: <<I worked all summer to buy this guitar.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:37"
msgid "<<I worked all summer to buy this guitar.>>"
msgstr "<<Trabajé todo el verano para comprar esta guitarra.>>"

#. Parte de «GUITAR» (woh_halo:35).
msgctxt "woh_halo:38"
msgid "Your loud guitar practice can be heard across the whole building."
msgstr "Tu ruidosa práctica de guitarra se oye por todo el edificio."

msgctxt "woh_halo:39"
msgid "HELL YEAH"
msgstr "¡CLARO QUE SÍ!"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:40"
msgid "BLESSED SHELL"
msgstr "PROYECTIL BENDITO"

#. Descripción de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:41"
msgid "(use in combat): (+1 AMMO / +5% DOOM); +10 SHOOT DAMAGE for the duration of this combat"
msgstr "(usar en combate): (+1 MUNICIÓN / +5% DOOM); +10 DAÑO DE DISPARO durante el resto del combate"

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:42"
msgid "<<I've loaded it with mom's silver jewelry...>>"
msgstr "<<Lo he cargado con las joyas de plata de mamá...>>"

#. Opción de «BLESSED SHELL» (woh_halo:40). Opciones: <<I've loaded it with mom's silver jewelry...>> · <<...sorry mom.>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:43"
msgid "<<...sorry mom.>>"
msgstr "<<...perdón, mamá.>>"

#. Parte de «BLESSED SHELL» (woh_halo:40).
msgctxt "woh_halo:44"
msgid "You can't use this outside of combat."
msgstr "No puedes usar esto fuera del combate."

#. Parte de «BLESSED SHELL» (woh_halo:40).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:45"
msgid "<<Should I?...>>"
msgstr "<<¿Debería...?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_halo:46"
msgid "MARKED BIBLE"
msgstr "BIBLIA MARCADA"

#. Descripción de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:47"
msgid "(while in inventory): resting regains extra REASON/STAMINA, depending on character's FAITH level"
msgstr "(mientras esté en el inventario): descansar recupera CORDURA y RESISTENCIA adicionales, según el nivel de FE del personaje"

#. Opción de «MARKED BIBLE» (woh_halo:46). Opciones: <<I don't remember certain parts of it, is this real?>>.
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:48"
msgid "<<I don't remember certain parts of it, is this real?>>"
msgstr "<<No recuerdo algunos pasajes. ¿Esto es real?>>"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:49"
msgid "Reading the MARKED BIBLE, you find your inner peace. (+1 REASON)"
msgstr "Al leer la BIBLIA MARCADA, encuentras paz interior. (+1 CORDURA)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:50"
msgid "MARKED BIBLE fills you with determination. (+1 STAMINA)"
msgstr "La BIBLIA MARCADA te llena de determinación. (+1 RESISTENCIA)"

#. Parte de «MARKED BIBLE» (woh_halo:46).
msgctxt "woh_halo:51"
msgid "dies irae"
msgstr "Dies irae"

msgctxt "woh_halo:52"
msgid "AYAKA'S CHALK"
msgstr "TIZA DE AYAKA"

msgctxt "woh_halo:53"
msgid "+2 DAMAGE against GHOST enemies"
msgstr "+2 DAÑO contra enemigos FANTASMA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:54"
msgid "<<They died because of me...>>"
msgstr "<<Murieron por mi culpa...>>"

msgctxt "woh_halo:55"
msgid "used in rituals"
msgstr "usada en rituales"

msgctxt "woh_halo:56"
msgid "BOOK STRAP"
msgstr "SUJETALIBROS"

msgctxt "woh_halo:57"
msgid "faster combat actions for each BOOK item in the inventory"
msgstr "las acciones de combate son más rápidas por cada objeto LIBRO en el inventario"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:58"
msgid "<<That's not the only book I've taken.>>"
msgstr "<<No es el único libro que me he llevado.>>"

msgctxt "woh_halo:59"
msgid "made of leather"
msgstr "hecho de cuero"

msgctxt "woh_halo:60"
msgid "CHECK BOOK"
msgstr "TALONARIO DE CHEQUES"

msgctxt "woh_halo:61"
msgid "(use): +3 FUNDS; +4% DOOM"
msgstr "(usar): +3 FONDOS; +4% DOOM"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:62"
msgid "<<Using this will make me easier to track down...>>"
msgstr "<<Si uso esto, será más fácil que me encuentren...>>"

msgctxt "woh_halo:63"
msgid "You've used your CHECK BOOK."
msgstr "Has usado tu TALONARIO DE CHEQUES."

msgctxt "woh_halo:64"
msgid "family's fortune"
msgstr "la fortuna de la familia"

msgctxt "woh_halo:65"
msgid "BASEBALL"
msgstr "PELOTA DE BÉISBOL"

msgctxt "woh_halo:66"
msgid "(use in combat): lower the ENEMY's power down to 0"
msgstr "(usar en combate): reduce el PODER del ENEMIGO a 0"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:67"
msgid "<<I'm not the best pitcher but it must be enough.>>"
msgstr "<<No soy el mejor lanzador, pero debería bastar.>>"

msgctxt "woh_halo:68"
msgid "You throw the BASEBALL at your enemy!"
msgstr "¡Lanzas la PELOTA DE BÉISBOL contra tu enemigo!"

msgctxt "woh_halo:69"
msgid "only one I got"
msgstr "la única que tengo"

msgctxt "woh_halo:70"
msgid "FAVORITE SNACKS"
msgstr "APERITIVOS FAVORITOS"

msgctxt "woh_halo:71"
msgid "(use): +3 REASON and STAMINA"
msgstr "(usar): +3 CORDURA y RESISTENCIA"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_halo:72"
msgid "<<I heard they are going to stop the production of these because they are too damn tasty!-->>"
msgstr "<<¡He oído que van a dejar de fabricarlos porque están demasiado buenos!>>"

msgctxt "woh_halo:73"
msgid "You eat your FAVORITE SNACKS."
msgstr "Te comes tus APERITIVOS FAVORITOS."

msgctxt "woh_halo:74"
msgid "yum yum"
msgstr "ñam ñam"

msgctxt "woh_halo:75"
msgid "You rummage through your belongings trying to find anything that will help you."
msgstr "Rebuscas entre tus pertenencias intentando encontrar algo que pueda ayudarte."

msgctxt "woh_halo:76"
msgid "You finally pick up"
msgstr "Finalmente encuentras"

msgctxt "woh_halo:77"
msgid ""
"Hopefully, it will be enough.\n"
"(+5% DOOM)"
msgstr ""
"Esperemos que sea suficiente.\n"
"(+5% DOOM)"

msgctxt "woh_halo:78"
msgid ""
"You don't find anything except some loose change laying around.\n"
"(+1 FUNDS / +2% DOOM)"
msgstr ""
"No encuentras nada, salvo unas monedas sueltas por ahí.\n"
"(+1 FONDOS / +2% DOOM)"

msgctxt "woh_halo:79"
msgid "It's dangerous here, your STAMINA penalty increased!"
msgstr "Este lugar es peligroso, ¡tu penalización de RESISTENCIA ha aumentado!"

msgctxt "woh_halo:80"
msgid "It's dangerous here, your REASON penalty increased!"
msgstr "Este lugar es peligroso, ¡tu penalización de CORDURA ha aumentado!"

msgctxt "woh_halo:81"
msgid ""
"\n"
"[DOOM EFFIGY]: DOOM lowered"
msgstr ""
"\n"
"[[EFIGIE DE DOOM]: DOOM reducida"

