msgid "This spell targets HUMAN enemies only."
msgstr "Este hechizo solo afecta a enemigos [HUMANOS]."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:13"
msgid "This spell targets ELDRITCH enemies only."
msgstr "Este hechizo solo afecta a enemigos [ELDRITCH]."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:14"
msgid "Occult signs attract unknown power!"
msgstr "¡Los símbolos ocultistas atraen un poder desconocido!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:15"
msgid "It's too much for your mind! (-1 REASON)"
msgstr "¡Es demasiado para tu mente! (-1 CORDURA)"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:16"
msgid "CURRENT SPELL LIMIT"
msgstr "LÍMITE ACTUAL DE HECHIZOS"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:17"
msgid "MIND DRAIN"
msgstr "DRENAR MENTE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:18"
msgid ""
"deals 5 damage\n"
"regain 2 REASON\n"
"[COST: -1 MAX REASON]"
msgstr ""
"inflige 5 de daño\n"
"recupera 2 CORDURA\n"
"[COSTE: -1 CORDURA MÁXIMA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:19"
msgid "You reach out your hand in an occult gesture, draining ENEMY's mind!"
msgstr "¡Extiendes la mano con un gesto ocultista y drenas la mente del ENEMIGO!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:20"
msgid "REGENERATION"
msgstr "REGENERACIÓN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:21"
msgid ""
"regain 4 STAMINA\n"
"[COST: 2 REASON]"
msgstr ""
"recupera 4 RESISTENCIA\n"
"[COSTE: 2 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:22"
msgid "You can feel your wounds slowly closing!"
msgstr "¡Sientes cómo tus heridas se cierran lentamente!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:23"
msgid "SKIN REMOVAL"
msgstr "DESOLLAMIENTO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:24"
msgid ""
"deals 6 damage\n"
"[COST: 3 REASON]"
msgstr ""
"inflige 6 de daño\n"
"[COSTE: 3 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:25"
msgid "The skin of your enemy starts falling off in big patches!"
msgstr "¡La piel de tu enemigo comienza a desprenderse a grandes tiras!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:26"
msgid "MULTIPLY WOUND"
msgstr "HERIDA MÚLTIPLE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:27"
msgid ""
"deals damage to an enemy, which increases the lower your STAMINA is\n"
"[COST: 2 STAMINA]"
msgstr ""
"inflige daño a un enemigo, que aumenta cuanto menor sea tu RESISTENCIA\n"
"[COSTE: 2 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «MULTIPLY WOUND» (woh_spell:26).
msgctxt "woh_spell:28"
msgid "The wounds of your enemy explode with gore!"
msgstr "¡Las heridas de tu enemigo estallan en un baño de sangre!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:29"
msgid "K'NPHA RITUAL"
msgstr "RITUAL K'NPHA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:30"
msgid ""
"when your allies die, a random STAT gets raised by 1\n"
"[COST: 2 REASON]"
msgstr ""
"cuando mueran tus aliados, una ESTADÍSTICA aleatoria aumenta en 1\n"
"[COSTE: 2 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:31"
msgid "Part of your ally's essence stays with you!"
msgstr "¡Una parte de la esencia de tu aliado permanece contigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «K'NPHA RITUAL» (woh_spell:29).
msgctxt "woh_spell:32"
msgid ""
"K'NPHA RITUAL\n"
"[allies -> stats]"
msgstr ""
"RITUAL K'NPHA\n"
"[aliados -> estadísticas]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:33"
msgid "INVISIBILITY"
msgstr "INVISIBILIDAD"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:34"
msgid ""
"until the end of the current mystery, there is no DOOM penalty for escaping from combat\n"
"[COST: 4 REASON]"
msgstr ""
"hasta el final del misterio actual, escapar del combate no conlleva ninguna penalización de DOOM\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:35"
msgid "You shift into the shadow realm!"
msgstr "¡Te adentras en el reino de las sombras!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «INVISIBILITY» (woh_spell:33).
msgctxt "woh_spell:36"
msgid "You are already invisible!"
msgstr "¡Ya eres invisible!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:37"
msgid "ABOLISH"
msgstr "ABOLIR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:38"
msgid ""
"lowers ELDRITCH enemy DAMAGE by 1\n"
"[COST: 3 STAMINA]"
msgstr ""
"reduce en 1 el DAÑO de los enemigos ELDRITCH\n"
"[COSTE: 3 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:39"
msgid "A magic barrier appears, absorbing the damage!"
msgstr "¡Aparece una barrera mágica que absorbe el daño!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:40"
msgid "Additional barriers won't help!"
msgstr "¡Más barreras no servirán de nada!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:41"
msgid "ABSORB"
msgstr "ABSORCIÓN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:42"
msgid ""
"deals 3 damage, gain 2 STAMINA\n"
"[COST: 4 REASON]"
msgstr ""
"inflige 3 de daño y recupera 2 RESISTENCIA\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:43"
msgid "You suck the life force out of your enemy!"
msgstr "¡Absorbes la fuerza vital de tu enemigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:44"
msgid "THIRD EYE"
msgstr "TERCER OJO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:45"
msgid ""
"+1 KNOWLEDGE and PERCEPTION until the end of the mystery\n"
"[effect doesn't stack]\n"
"[COST: 3 REASON]"
msgstr ""
"+1 CONOCIMIENTO y PERCEPCIÓN hasta el final del misterio\n"
"[el efecto no se acumula]\n"
"[COSTE: 3 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:46"
msgid "You can feel your inner eye open!"
msgstr "¡Sientes cómo se abre tu ojo interior!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «THIRD EYE» (woh_spell:44).
msgctxt "woh_spell:47"
msgid "You wouldn't want a fourth eye, would you?"
msgstr "No querrás tener un cuarto ojo, ¿verdad?"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:48"
msgid "ITHOTU FLAME"
msgstr "LLAMA DE ITHOTU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:49"
msgid ""
"deals 8 damage\n"
"+2% DOOM\n"
"[COST: 1 REASON]\n"
"[COST: 1 STAMINA]"
msgstr ""
"inflige 8 de daño\n"
"+2% DOOM\n"
"[COSTE: 1 CORDURA]\n"
"[COSTE: 1 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:50"
msgid "A column of fire engulfs the enemy!"
msgstr "¡Una columna de fuego envuelve al enemigo!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:51"
msgid "SEAL OF SAVVESH"
msgstr "SELLO DE SAVVESH"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:52"
msgid ""
"+1 STRENGTH\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 FUERZA\n"
"[se descarta al usarlo]\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:53"
msgid "A new seal appears on your skin!"
msgstr "¡Aparece un nuevo sello en tu piel!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:54"
msgid "SEAL OF BRAM'EL"
msgstr "SELLO DE BRAM'EL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:55"
msgid ""
"+1 KNOWLEDGE\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"+1 CONOCIMIENTO\n"
"[se descarta al usarlo]\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:56"
msgid "THREAD OF FATE"
msgstr "HILO DEL DESTINO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:57"
msgid ""
"defeat target HUMAN enemy\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"derrota al enemigo HUMANO objetivo\n"
"[se descarta al usarlo]\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:58"
msgid "Enemy falls to the ground, dead."
msgstr "El enemigo cae al suelo, muerto."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:59"
msgid "ANCESTRAL STRENGTH"
msgstr "FUERZA ANCESTRAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:60"
msgid ""
"+1 DAMAGE\n"
"[COST: 4 REASON]"
msgstr ""
"+1 DAÑO\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:61"
msgid "Someone is guiding your moves..."
msgstr "Alguien guía tus movimientos..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:62"
msgid ""
"ANCESTRAL STRENGTH\n"
"[+1 DAMAGE]"
msgstr ""
"FUERZA ANCESTRAL\n"
"[+1 DAÑO]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:63"
msgid "ENTHRALLMENT"
msgstr "FASCINACIÓN"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:64"
msgid ""
"gain an additional follower\n"
"[discard on use]\n"
"[COST: 4 REASON]"
msgstr ""
"obtienes un seguidor adicional\n"
"[se descarta al usarlo]\n"
"[COSTE: 4 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ENTHRALLMENT» (woh_spell:63).
msgctxt "woh_spell:65"
msgid "A new person follows your lead..."
msgstr "Una nueva persona sigue tus pasos..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:66"
msgid "AWAKEN"
msgstr "DESPERTAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:67"
msgid ""
"gain a permanent boost of two randomly selected stats\n"
"[COST: 10% DOOM]"
msgstr ""
"obtienes una mejora permanente de dos estadísticas seleccionadas al azar\n"
"[COSTE: 10% DOOM]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «AWAKEN» (woh_spell:66).
msgctxt "woh_spell:68"
msgid "You've attracted the attention of something evil..."
msgstr "Has atraído la atención de algo maligno..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:69"
msgid "BINDING AGONY"
msgstr "AGONÍA VINCULANTE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:70"
msgid ""
"target enemy's damage is lowered by 1\n"
"[COST: 3 REASON]"
msgstr ""
"el daño del enemigo objetivo se reduce en 1\n"
"[COSTE: 3 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:71"
msgid "BINDING AGONY makes their movement slower!"
msgstr "¡AGONÍA VINCULANTE ralentiza sus movimientos!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:72"
msgid "WITNESS CURSE"
msgstr "MALDICIÓN DEL TESTIGO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:73"
msgid ""
"converts all combat STAMINA damage taken into extra DOOM\n"
"[COST: 2 REASON]"
msgstr ""
"convierte todo el daño de RESISTENCIA recibido en combate en DOOM adicional\n"
"[COSTE: 2 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:74"
msgid ""
"WITNESS CURSE\n"
"[- STAMINA -> + DOOM]"
msgstr ""
"MALDICIÓN DEL TESTIGO\n"
"[- RESISTENCIA -> + DOOM]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «WITNESS CURSE» (woh_spell:72). Opciones: WITNESS CURSE / [- STAMINA -> + DOOM] · SHADOW SHROUD.
msgctxt "woh_spell:75"
msgid "SHADOW SHROUD"
msgstr "VELO DE SOMBRAS"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:76"
msgid ""
"for the duration of this mystery, ignore location's THREAT level\n"
"[COST: 3 REASON]"
msgstr ""
"durante este misterio, ignora el nivel de AMENAZA de la ubicación\n"
"[COSTE: 3 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «WITNESS CURSE» (woh_spell:72).
msgctxt "woh_spell:77"
msgid "You feel more in tune with the weird..."
msgstr "Sientes una mayor conexión con lo extraño..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:78"
msgid "MEND"
msgstr "REPARAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:79"
msgid ""
"gain 1 REASON\n"
"[COST: 2 STAMINA]"
msgstr ""
"recupera 1 CORDURA\n"
"[COSTE: 2 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:80"
msgid "You regain some of the lost REASON."
msgstr "Recuperas parte de la CORDURA perdida."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:81"
msgid "VOID"
msgstr "VACÍO"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «VOID» (woh_spell:81).
msgctxt "woh_spell:82"
msgid ""
"ignore the current event and instantly investigate a random OTHERWORLD location\n"
"[one time use only]\n"
"[COST: 3 REASON]"
msgstr ""
"ignora el evento actual e investiga al instante una ubicación aleatoria de OTRO MUNDO\n"
"[solo se puede usar una vez]\n"
"[COSTE: 3 CORDURA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:83"
msgid "CAUTERIZE"
msgstr "CAUTERIZAR"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Opción de «VOID» (woh_spell:81). Opciones: CAUTERIZE · +2 STAMINA / [one time use only].
msgctxt "woh_spell:84"
msgid ""
"+2 STAMINA\n"
"[one time use only]"
msgstr ""
"+2 RESISTENCIA\n"
"[solo se puede usar una vez]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «VOID» (woh_spell:81).
msgctxt "woh_spell:85"
msgid "The torn flesh closes, stopping the bleeding."
msgstr "La carne desgarrada se cierra y detiene la hemorragia."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:86"
msgid "MEMORY EXTRACT"
msgstr "EXTRAER RECUERDOS"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:87"
msgid ""
"+2 REASON\n"
"[COST: 10 EXP]"
msgstr ""
"+2 CORDURA\n"
"[COSTE: 10 EXP]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:88"
msgid "Traumatic memories leave your mind..."
msgstr "¡Los recuerdos traumáticos abandonan tu mente...!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:89"
msgid "This spell requires more EXPERIENCE."
msgstr "Este hechizo requiere más EXPERIENCIA."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:90"
msgid "ASHEN CONTRACT"
msgstr "PACTO DE CENIZA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:91"
msgid ""
"immediately kills any non-eldritch enemy\n"
"[one time use only]\n"
"[COST: 7% DOOM]"
msgstr ""
"mata al instante a cualquier enemigo que no sea eldritch\n"
"[solo se puede usar una vez]\n"
"[COSTE: 7% DOOM]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Parte de «ASHEN CONTRACT» (woh_spell:90).
msgctxt "woh_spell:92"
msgid "It is done."
msgstr "Está hecho."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:93"
msgid "MIDASU TOUCH"
msgstr "TOQUE DE MIDASU"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:94"
msgid ""
"+1 FUNDS\n"
"[COST: 2 STAMINA]"
msgstr ""
"+1 FONDOS\n"
"[COSTE: 2 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:95"
msgid "Your fingernail turns silver, you rip it off!"
msgstr "¡Tu uña se vuelve plateada y te la arrancas!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:96"
msgid "Your tooth turns to gold, you twist it off!"
msgstr "¡Tu diente se vuelve de oro y te lo arrancas!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:97"
msgid "FLESH REGROWTH"
msgstr "REGENERACIÓN DE CARNE"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:98"
msgid ""
"+3 STAMINA\n"
"-2 MAX STAMINA"
msgstr ""
"+3 RESISTENCIA\n"
"-2 RESISTENCIA MÁXIMA"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:99"
msgid "Your veins extend and seal the ripped flesh!"
msgstr "¡Tus venas se extienden y cierran la carne desgarrada!"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:100"
msgid "EXPEL EVIL"
msgstr "EXPULSAR EL MAL"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:101"
msgid ""
"-6% DOOM\n"
"[one time use only]\n"
"[COST: 2 STAMINA]"
msgstr ""
"-6% DOOM\n"
"[solo se puede usar una vez]\n"
"[COSTE: 2 RESISTENCIA]"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
msgctxt "woh_spell:102"
msgid "You cough up blood and... s-something else..."
msgstr "Toses sangre y... a-algo más..."

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_spell:103"
msgid "GROW TEETH"
msgstr "HACER CRECER DIENTES"

#. Hechizos: tipos, efectos y mensajes al lanzarlos.
#. Descripción de «GROW TEETH» (woh_spell:103).
msgctxt "woh_spell:104"
msgid ""
"adds a new combat action, [BITE], until the end of this mystery\n"
