msgid "eng"
msgstr "eng"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_chara:1"
msgid "WORLD OF HORROR"
msgstr "WORLD OF HORROR"

#. Descripción de «WORLD OF HORROR» (woh_chara:1).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_chara:2"
msgid "<<At the beginning, no one had any idea what we were up against.>>"
msgstr "<<Al comienzo, nadie tenía idea de a qué nos enfrentábamos.>>"

#. Opción de «WORLD OF HORROR» (woh_chara:1). Opciones: [NO EFFECT] · MEDICAL HISTORY.
msgctxt "woh_chara:3"
msgid "[NO EFFECT]"
msgstr "[NO EFFECT]"

#. Opción de «WORLD OF HORROR» (woh_chara:1). Opciones: [NO EFFECT] · MEDICAL HISTORY.
msgctxt "woh_chara:4"
msgid "MEDICAL HISTORY"
msgstr "HISTORIAL MÉDICO"

#. Parte de «WORLD OF HORROR» (woh_chara:1).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_chara:5"
msgid "<<Brittle bones run in your family and you've spent each summer in a cast.>>"
msgstr "<<Los huesos frágiles son hereditarios en tu familia y has pasado todos los veranos con una escayola.>>"

#. Parte de «WORLD OF HORROR» (woh_chara:1).
msgctxt "woh_chara:6"
msgid "[you start with extra EXP and BANDAGES but an INJURY may occur whenever the player takes damage in combat]"
msgstr "[comienzas con EXP y VENDAS adicionales, pero puedes sufrir una LESIÓN cada vez que recibes daño en combate]"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_chara:7"
msgid "HUNTED BY THE CULT"
msgstr "PERSEGUIDO POR EL CULTO"

#. Descripción de «HUNTED BY THE CULT» (woh_chara:7).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_chara:8"
msgid "<<You've managed to run from them once, but the cult is tireless...>>"
msgstr "<<Conseguiste escapar de ellos una vez, pero el culto no descansa...>>"

#. Parte de «HUNTED BY THE CULT» (woh_chara:7).
msgctxt "woh_chara:9"
msgid "[solving mysteries reduces more DOOM but you get more unique combat encounters]"
msgstr "[resolver misterios reduce más el DOOM, pero tendrás más encuentros de combate únicos]"

msgctxt "woh_chara:10"
msgid "THE SEVENTH CURSE"
msgstr "LA SÉPTIMA MALDICIÓN"

#. Diálogo o pensamiento entre << >>.
