msgstr "% de DOOM"

msgctxt "woh_comb:126"
msgid "ends the encounter for a DOOM penalty"
msgstr "termina el encuentro a cambio de una penalización de DOOM"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_comb:127"
msgid "FORCE MANHOLE OPEN (WITHOUT TOOL)"
msgstr "FORZAR LA TAPA DE LA ALCANTARILLA (SIN HERRAMIENTA)"

