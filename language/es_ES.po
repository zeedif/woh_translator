msgctxt "woh_comb:42"
msgid ""
"[one-time use only]\n"
"[needs STAMINA or REASON to be lower than 3]"
msgstr ""
"[solo se puede usar una vez]\n"
"[requiere que STAMINA o REASON sea inferior a 3]"

