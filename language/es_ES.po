msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "¡Has recuperado un objeto del almacén!"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "¡No hay espacio suficiente para un objeto!"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "ALMACÉN"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "OBJETOS ALMACENADOS"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "¡No hay espacio suficiente! ¡El objeto se ha guardado en el almacén!"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "Para subir de nivel, pulsa el botón parpadeante."

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "¡No tienes suficiente experiencia!"

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "HABLAR CON EL ESTUDIANTE"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "MONTAR UN TELESCOPIO"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "VOLVER"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "No tienes un telescopio."

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "El estudiante está murmurando algo para sí misma."

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "Probablemente deberías dejarla tranquila."

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr "El agua fría te ayuda a ordenar tus pensamientos. (+1 CORDURA)"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr "El agua caliente alivia tus músculos doloridos. (+1 RESISTENCIA)"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"Clavar un muñeco de paja en este árbol hará realidad tu deseo...\n"
"\n"
"siempre que pagues el precio."

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[puedes clavar dos muñecos de paja más aquí]"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[puedes clavar un muñeco de paja más aquí]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"No deberías haber vuelto aquí.\n"
"(+1% DOOM)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "ÁRBOL DE LA BRUJA"

#. Descripción de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "Según las leyendas, las raíces de este árbol llegan hasta la tumba de una bruja linchada..."

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr "Descubres una cartera escondida bajo una rama caída. (+2 FONDOS)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "La bruja enterrada te pasa factura..."

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "¡Cánticos prohibidos resuenan en tu cabeza!"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr "¡De repente te sientes mucho mejor! (+2 RESISTENCIA)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr ""
"desear fuerza\n"
"[+2 RESISTENCIA]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr ""
"desear conocimiento\n"
"[+HECHIZO]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr ""
"desear dinero\n"
"[+2 FONDOS]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr ""
"es una mala idea\n"
"[marcharse]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"Una joven policía te detiene.\n"
"\n"
"<<¿En qué podemos ayudarte?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "COMISARÍA"

#. Descripción de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "Los agentes de la comisaría están ocupados investigando diversos casos extraños..."

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "solicitar más patrullas policiales"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "quejarse de las patrullas policiales"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr ""
"compartir información\n"
"(11 EXP -> 1 FONDO)"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "salir de la comisaría"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"El agente te da las gracias y promete aumentar las patrullas policiales.\n"
"[Nivel de amenaza reducido]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "El agente se disculpa y dice que ya no les quedan unidades de patrulla."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr ""
"El detective te agradece la información y te entrega una recompensa.\n"
"[-11 EXP / +1 FONDO]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "El detective te agradece la información, pero dice que no es suficiente para darte una recompensa."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"¡Por fin has conseguido entrar en el faro maldito!\n"
"\n"
"Tu instinto te dice dos cosas: quienquiera (o lo que sea) que esté detrás de los extraños sucesos debe encontrarse en el piso más alto de este lugar, y deberías huir de aquí tan lejos y tan rápido como puedas. Temes que no haya vuelta atrás una vez empieces a subir estas escaleras..."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:41"
msgid "access storage"
msgstr "acceder al almacén"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "descansar un poco (+2% DOOM)"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "empezar a subir"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr "Has descansado un poco. (+1 CORDURA y RESISTENCIA)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "FARO (PLANTA BAJA)"

#. Descripción de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr "A medida que la niebla antinatural se disipa lentamente, sientes alivio y te desplomas en el suelo..."

#. Parte de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"Las nubes oscuras giran alrededor del faro.\n"
"¿Has llegado demasiado tarde?"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "EL MONUMENTO"

#. Descripción de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "Olvidada por todos, la ENTIDAD EXTERIOR espera pacientemente a quienes la necesitan..."

#. Opción de «THE MONUMENT» (woh_addy:48). Opciones: leave without a sacrifice  / [angers the OUTER ENTITY].
msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr ""
"marcharse sin ofrecer un sacrificio \n"
"[enfurece a la ENTIDAD EXTERIOR]"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "Te cortas la mano y llenas el cuenco con tu sangre..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "Puedes sentir cómo tus recuerdos más preciados te abandonan..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "Quemas el dinero del cuenco..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "Has enfurecido a la ENTIDAD EXTERIOR..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "Negociar con una ENTIDAD EXTERIOR es arriesgado, pero quizá pueda retrasar la fatalidad que se aproxima..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "ofrecer tu sangre a la ENTIDAD EXTERIOR"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr "entregar tus recuerdos más preciados a la ENTIDAD EXTERIOR"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "ofrecer un regalo material"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "Todavía queda algo de tiempo antes de que te llamen al despacho."

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "SALA DE RECEPCIÓN"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "Esperas pacientemente en la sala de recepción."

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "Muchos enfermos esperan a que el agotado personal del hospital los atienda."

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "entrar en la CONSULTA (+2% DOOM)"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "ir al PASILLO A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr ""
"entrar en la FARMACIA\n"
"(+3% DOOM)"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "Una enfermera pasa apresuradamente a tu lado."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "CONSULTA MÉDICA"

#. Descripción de «DOCTOR'S OFFICE» (woh_addy:67).
msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "El servicio de urgencias está abarrotado debido directamente a los extraños sucesos que están ocurriendo en tu ciudad."

#. Parte de «DOCTOR'S OFFICE» (woh_addy:67).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"Por fin te llaman para entrar en la consulta.\n"
"\n"
"<<Bien... ¿en qué puedo ayudarte hoy?>>"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "SALIR"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[ACCIONES ADICIONALES DISPONIBLES EN LAS TARJETAS DE LESIONES]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "Aprovechas la oportunidad y robas un frasco de pastillas."

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "No deberías arriesgarte a robar otro frasco."

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "Sientes que la calavera observa cada uno de tus movimientos."

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "PASILLO A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "Avanzas por el pasillo..."

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "volver a la SALA DE RECEPCIÓN"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "coger el ASCENSOR"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "entrar en la MORGUE"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "¿Qué haces aquí?"

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "La puerta de la morgue está cerrada."

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "PASILLO B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "El piso superior está inquietantemente silencioso en comparación..."

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "examinar la HABITACIÓN DEL PACIENTE"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "No deberías molestar a los pacientes que se están recuperando."

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "DESCANSANDO EN CASA"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "Sin duda, se está bien de vuelta en casa."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "RESISTENCIA/CORDURA"

#. Descripción de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "El tiempo pasa volando. Te preparas para salir y continuar con tu investigación."

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "DOOM"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "RESISTENCIA/CORDURA"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"Espera... ¿qué es eso?\n"
"[ALGO MALIGNO SABE DÓNDE VIVES]"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "Te echas una pequeña siesta en la cama."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "Te vendás las heridas recientes."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "Te das una larga ducha caliente."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "Te tomas los analgésicos."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "Llamas a tu mejor amigo y habláis de cosas sin importancia."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "Te sientas en el sofá y lees tu libro favorito."

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "PASILLO DEL APARTAMENTO"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "Llamas a la puerta de tu amigo y esperas..."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr "<<Oye, idiota, estoy contigo. ¿Por qué volvemos a mi casa?>>"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr "<<Holaaa... Hoy estoy muy ocupada. Quedemos otro día, ¿vale?>>"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"Vaya, KANA no está en casa.\n"
"Deberías volver más tarde..."

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "Comprar objetos consume un tiempo muy valioso. (+4% DOOM)"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "Eh... ¿dónde está ese perro?"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "COMPRAR OBJETOS"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "SALIR SIN COMPRAR NADA"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "usa TARJETA YAKUZA"

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "OBJETOS DISPONIBLES"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "PRECIO"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "FONDOS"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "Un objeto aleatorio con descuento."

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "REPONER EXISTENCIAS"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "cambiar los objetos (+3% DOOM)"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "Has comprado un objeto nuevo."

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "No tienes suficiente dinero."

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "¡Guau!-"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "-OBJETO CON DESCUENTO-"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "De camino a la salida, te detienes en las máquinas expendedoras. (+2% DOOM)"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "COMPRAR OBJETOS"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"[cuesta DOOM entrar]\n"
"[fondos -> objetos]"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"[cuesta DOOM entrar]\n"
"[recuperar RESISTENCIA y CORDURA]"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "DESCANSAR"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "MÁQUINA EXPENDEDORA"

#. Descripción de «VENDING MACHINE» (woh_addy:124).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"Al entrar en el REFUGIO ILEGAL, reconoces inmediatamente a la chica que te atacó y dejó caer la receta médica.\n"
"Arrojas la costosa medicina sobre la mesa antes de acercarte.\n"
"\n"
"<<¿E-es la medicina para mi abuela?...>> Sus ojos se iluminan.\n"
