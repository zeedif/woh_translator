msgstr "OMITIR PANTALLA DE MALETÍN: ACTIVADO/DESACTIVADO"

msgctxt "woh_halo:83"
msgid ""
"SKIP CARD PACK SCREEN: ON/OFF\n"
"(all packs enabled)"
msgstr ""
"OMITIR PANTALLA DE CARTAS: ACTIVADO/DESACTIVADO\n"
"(todos los paquetes)"

msgctxt "woh_halo:84"
msgid "CREEPY NEIGHBOR: ON/OFF"
msgstr "VECINO SINIESTRO: ACTIVADO/DESACTIVADO"

msgctxt "woh_halo:85"
msgid "CHECK FOR CONNECTED GAMEPADS: ON/OFF"
msgstr "COMPROBAR MANDOS CONECTADOS: ACTIVADO/DESACTIVADO"

msgctxt "woh_halo:86"
msgid "WAVY EFFECT: ON/OFF"
msgstr "EFECTO ONDULADO: ACTIVADO/DESACTIVADO"

msgctxt "woh_halo:87"
msgid "SKIP PLAYTHROUGH INTRO"
msgstr "OMITIR INTRODUCCIÓN DE LA PARTIDA"

msgctxt "woh_halo:88"
msgid "SKIP MYSTERY TUTORIAL"
msgstr "OMITIR TUTORIAL DEL MISTERIO"

msgctxt "woh_halo:89"
msgid "MOUSE TRAIL: ON/OFF"
msgstr "RASTRO DEL RATÓN: ACTIVADO/DESACTIVADO"

msgctxt "woh_halo:90"
msgid "SKIP PALETTE CUSTOMIZATION"
msgstr "OMITIR PERSONALIZACIÓN DE LA PALETA"

