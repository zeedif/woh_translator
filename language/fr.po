#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:0"
msgid "[UPGRADE]"
msgstr "[AMÉLIORATION]"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:1"
msgid "SECOND SIGHT"
msgstr "DOUBLE VUE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:2"
msgid "additional damage against GHOST and ELDRITCH enemies"
msgstr "vous infligez des dégâts supplémentaires aux FANTÔMES et aux ENTITÉS PARANORMALES"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:3"
msgid "SELF-THERAPY"
msgstr "AUTOTHÉRAPIE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:4"
msgid "forgetting spells regains extra REASON"
msgstr "vous restaurez plus de LUCIDITÉ en oubliant des sorts"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:5"
msgid "Your self-therapy allows you to forget all this! (+2 REASON)"
msgstr "L'autothérapie vous permet d'oublier vos soucis ! (+2 LUCIDITÉ)"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:6"
msgid "GHOST CONNECTION"
msgstr "MÉDIUMNITÉ"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:7"
msgid "completing a mystery grants a random SPELL"
msgstr "vous obtenez un SORT aléatoire à chaque mystère terminé"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:8"
msgid "[GHOST CONNECTION] You learn something new!"
msgstr "[MÉDIUMNITÉ] Vous avez appris quelque chose de nouveau !"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:9"
msgid "ARCANE GRASP"
msgstr "SAVOIR ARCANIQUE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:10"
msgid "+2 additional SPELL slots available"
msgstr "+2 emplacements de SORT disponibles"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:11"
msgid "RUNNING SHOES"
msgstr "BASKETS"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:12"
msgid "smaller DOOM penalty from running from combat"
msgstr "pénalité de CALAMITÉ réduite quand vous fuyez un combat"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:13"
msgid "HOT BATH"
msgstr "BAIN CHAUD"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:14"
msgid "improved resting at home"
msgstr "le repos à la maison est de meilleure qualité"

