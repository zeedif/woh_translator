msgid "[+ITEM]"
msgstr "[+ OBJET]"

msgctxt "woh_chal:149"
msgid "[+MEDICAL KIT]"
msgstr "[+ KIT MÉDICAL]"

msgctxt "woh_chal:150"
msgid "[+SPELL]"
msgstr "[+ SORT]"

