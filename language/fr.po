msgctxt "woh_perk:15"
msgid "DISCIPLINE"
msgstr "DISCIPLINE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:16"
msgid "regain 1 STAMINA for all successful event skill checks"
msgstr "vous restaurez 1 ENDURANCE pour chaque jet de caractéristique réussi"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:17"
msgid "Your discipline and hard work pay off! (+1 STAMINA)"
msgstr "Vos efforts et votre discipline ont porté leurs fruits ! (+1 ENDURANCE)"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:18"
msgid "FAST SWIMMER"
msgstr "NAGE RAPIDE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:19"
msgid "faster offensive actions"
msgstr ""
"les actions offensives sont\n"
"plus rapides"

