msgid ""
msgstr ""
"Project-Id-Version: World of Horror\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "woh_addy:0"
msgid "You've retrieved an item from storage!"
msgstr "Vous avez récupéré un objet dans votre coffre !"

msgctxt "woh_addy:1"
msgid "Not enough room for an item!"
msgstr "Votre inventaire est plein !"

msgctxt "woh_addy:2"
msgid "STORAGE"
msgstr "COFFRE"

msgctxt "woh_addy:3"
msgid "STORED ITEMS"
msgstr "OBJETS STOCKÉS"

msgctxt "woh_addy:4"
msgid "Not enough room! Item added to the storage!"
msgstr "Votre inventaire est plein ! Objet envoyé au coffre !"

msgctxt "woh_addy:5"
msgid "To gain a new level, press the flashing button."
msgstr "Appuyez pour gagner un niveau."

msgctxt "woh_addy:6"
msgid "You don't have enough experience!"
msgstr "Vous n'avez pas assez de points d'expérience !"

msgctxt "woh_addy:7"
msgid "TALK WITH STUDENT"
msgstr "PARLER AVEC L'ÉLÈVE"

msgctxt "woh_addy:8"
msgid "SET UP A TELESCOPE"
msgstr "INSTALLER LE TÉLESCOPE"

msgctxt "woh_addy:9"
msgid "RETURN"
msgstr "RETOUR"

msgctxt "woh_addy:10"
msgid "You don't have a telescope."
msgstr "Vous n'avez pas de télescope."

msgctxt "woh_addy:11"
msgid "Student is mumbling something to herself."
msgstr "L'élève marmonne quelque chose."

msgctxt "woh_addy:12"
msgid "You should probably leave her alone."
msgstr "Vous devriez la laisser tranquille."

msgctxt "woh_addy:13"
msgid "Cold water helps you to organize your thoughts. (+1 REASON)"
msgstr "L'eau fraîche vous aide à organiser vos pensées. (+1 LUCIDITÉ)"

msgctxt "woh_addy:14"
msgid "Hot water helps with your sore muscles. (+1 STAMINA)"
msgstr "L'eau chaude soulage vos courbatures. (+1 ENDURANCE)"

msgctxt "woh_addy:15"
msgid ""
"Nailing a straw doll to this tree will grant you your wish...\n"
"\n"
"for a price, that is."
msgstr ""
"Vous pouvez clouer une poupée vaudou à cet arbre pour faire un vœu...\n"
"mais ça ne sera pas gratuit."

msgctxt "woh_addy:16"
msgid ""
"\n"
"\n"
"[you can nail two more straw dolls here]"
msgstr ""
"\n"
"\n"
"[vous pouvez encore clouer 2 poupées]"

msgctxt "woh_addy:17"
msgid ""
"\n"
"\n"
"[you can nail one more straw doll here]"
msgstr ""
"\n"
"\n"
"[vous pouvez encore clouer 1 poupée]"

msgctxt "woh_addy:18"
msgid ""
"You shouldn't have come here again.\n"
"(+1% DOOM)"
msgstr ""
"Vous n'auriez pas dû revenir ici.\n"
"(+1% CALAMITÉ)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:19"
msgid "WITCH'S TREE"
msgstr "ARBRE DE LA SORCIÈRE"

#. Descripción de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:20"
msgid "According to legends, this tree's roots reach towards the grave of a lynched witch..."
msgstr "Selon la légende, les racines de cet arbre s'enfoncent dans la tombe d'une sorcière massacrée..."

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:21"
msgid "You notice a wallet hidden underneath a fallen branch. (+2 FUNDS)"
msgstr "Vous remarquez un porte-monnaie caché sous une branche tombée. (+2 ARGENT)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:22"
msgid "The buried witch takes her toll..."
msgstr "La sorcière enterrée perçoit sa dîme..."

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:23"
msgid "You head fills with forbidden chants!"
msgstr "Des chants interdits assaillent vos pensées !"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:24"
msgid "You suddenly feel much better! (+2 STAMINA)"
msgstr "Vous vous sentez soudainement mieux. (+2 ENDURANCE)"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:25"
msgid ""
"wish for strength\n"
"[+2 STAMINA]"
msgstr ""
"vœu de résistance\n"
"[+2 ENDURANCE]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:26"
msgid ""
"wish for knowledge\n"
"[+SPELL]"
msgstr ""
"vœu de savoir\n"
"[+SORT]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:27"
msgid ""
"wish for money\n"
"[+2 FUNDS]"
msgstr ""
"vœu de richesse\n"
"[+2 ARGENT]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
msgctxt "woh_addy:28"
msgid ""
"it's a bad idea\n"
"[leave]"
msgstr ""
"mauvaise idée\n"
"[partir]"

#. Parte de «WITCH'S TREE» (woh_addy:19).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:29"
msgid ""
"You are stopped by a young policewoman.\n"
"\n"
"<<How can we help you?>>"
msgstr ""
"Une jeune policière vous interpelle.\n"
"\n"
"<<Je peux vous aider ?>>"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:30"
msgid "POLICE STATION"
msgstr "COMMISSARIAT"

#. Descripción de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:31"
msgid "Officers at the police station are busy working on various weird cases..."
msgstr "Les agents de police sont occupés à résoudre d'étranges affaires..."

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:32"
msgid "request more police patrols"
msgstr "demander plus de patrouilles de police"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:33"
msgid "complain about police patrols"
msgstr "se plaindre des patrouilles de police"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:34"
msgid ""
"share some information\n"
"(11 EXP -> 1 FND)"
msgstr ""
"partager des informations\n"
"(11 EXP -> 1 AGT)"

#. Opción de «POLICE STATION» (woh_addy:30). Opciones: request more police patrols · complain about police patrols · share some information / (11 EXP -> 1 FND) · exit the station.
msgctxt "woh_addy:35"
msgid "exit the station"
msgstr "partir"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:36"
msgid ""
"Officer thanks you and promises more police patrols.\n"
"[Threat Level decreased]"
msgstr ""
"L'agent vous remercie et promet de doubler les patrouilles.\n"
"[Niveau de danger réduit]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:37"
msgid "The officer apologizes and says they don't have any patrol units left."
msgstr "L'agent s'excuse en expliquant qu'aucune autre patrouille n'est disponible."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:38"
msgid ""
"The detective thanks you for the information and hands you a reward.\n"
"[-11 EXP / +1 FUNDS]"
msgstr ""
"Le détective vous remercie pour l'information et vous tend une récompense.\n"
"[-11 EXP / +1 AGT]"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:39"
msgid "The detective thanks you for the information but says that's not enough for a prize."
msgstr "Le détective vous remercie pour l'information, mais considère qu'elle ne vaut pas une récompense."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:40"
msgid ""
"You've finally made it inside the cursed lighthouse!\n"
"\n"
"Your gut is telling you two things: that whoever (or whatever) is behind the weird events, must be on the highest floor of this place and that you should run away from this place as far and fast as you can. You're afraid there won't be a way back once you start climbing these stairs..."
msgstr ""
"Vous avez enfin réussi à entrer\n"
"dans le phare maudit !\n"
"Deux intuitions vous envahissent : primo, la personne (ou la chose) qui se cache derrière les événements étranges doit se trouver au dernier étage ; deuxio... vous devriez prendre vos jambes à votre cou. Vous craignez de ne pas pouvoir revenir sur vos pas une fois que vous aurez commencé à monter ces marches..."

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:41"
msgid "access storage"
msgstr "accéder au coffre"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:42"
msgid "rest a bit (+2% DOOM)"
msgstr "se reposer (+2% CALAMITÉ)"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:43"
msgid "start climbing"
msgstr "commencer à monter"

#. Parte de «POLICE STATION» (woh_addy:30).
msgctxt "woh_addy:44"
msgid "You've rested a bit. (+1 REASON and STAMINA)"
msgstr "Vous avez fait une pause. (+1 LUCIDITÉ et ENDURANCE)"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:45"
msgid "LIGHTHOUSE (GROUND FLOOR)"
msgstr "PHARE (REZ-DE-CHAUSSÉE)"

#. Descripción de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:46"
msgid "As the unnatural fog slowly lifts you are relieved and collapse on the floor..."
msgstr "À mesure que le brouillard surnaturel se lève, il vous libère et vous vous effondrez au sol..."

#. Parte de «LIGHTHOUSE (GROUND FLOOR)» (woh_addy:45).
msgctxt "woh_addy:47"
msgid ""
"The dark clouds swirl around the lighthouse.\n"
"Did you arrive too late?"
msgstr ""
"De sombres nuages tourbillonnent autour du phare.\n"
"Est-ce trop tard ?"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:48"
msgid "THE MONUMENT"
msgstr "LE MONUMENT"

#. Descripción de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:49"
msgid "Forgotten by everyone, the OUTER ENTITY waits patiently for those, who need it..."
msgstr "Oubliée de tous, l'OUTRÂME attend patiemment celles et ceux qui cherchent son assistance..."

#. Opción de «THE MONUMENT» (woh_addy:48). Opciones: leave without a sacrifice  / [angers the OUTER ENTITY].
msgctxt "woh_addy:50"
msgid ""
"leave without a sacrifice \n"
"[angers the OUTER ENTITY]"
msgstr ""
"partir sans faire de sacrifice \n"
"[provoque la colère de l'OUTRÂME]"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:51"
msgid "You cut your hand and fill the bowl with your blood..."
msgstr "Vous entaillez votre main et versez votre sang dans le bol..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:52"
msgid "You can feel your most cherised memories leave you..."
msgstr "Vous sentez vos plus chers souvenirs vous quitter..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:53"
msgid "You burn the money in the bowl..."
msgstr "Vous brûlez de l'argent dans le bol..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:54"
msgid "You've angered the OUTER ENTITY..."
msgstr "Vous avez mis l'OUTRÂME en colère..."

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:55"
msgid "Bargaining with an OUTER ENTITY is a risky thing but maybe it can postpone the approaching doom?"
msgstr "Il est toujours risqué de négocier avec une OUTRÂME, mais vous pourrez peut-être repousser l'imminente calamité ?"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:56"
msgid "feed the OUTER ENTITY with your blood"
msgstr "offrir votre sang à l'OUTRÂME"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:57"
msgid "give the OUTER ENTITY your most cherished memories"
msgstr "donner à l'OUTRÂME vos plus précieux souvenirs"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:58"
msgid "leave a material gift"
msgstr "offrir un présent matériel"

#. Parte de «THE MONUMENT» (woh_addy:48).
msgctxt "woh_addy:59"
msgid "You still have some time before you are asked to the office."
msgstr "Il vous reste un peu de temps avant votre consultation."

msgctxt "woh_addy:60"
msgid "RECEPTION AREA"
msgstr "RÉCEPTION"

msgctxt "woh_addy:61"
msgid "You wait patiently in the reception area."
msgstr "Vous attendez patiemment à la réception."

msgctxt "woh_addy:62"
msgid "Many sick people are waiting to be examined by the overworked hospital staff."
msgstr "Une foule de patients attend que les médecins débordés les auscultent."

msgctxt "woh_addy:63"
msgid "enter DOCTOR'S OFFICE (+2% DOOM)"
msgstr "entrer dans le BUREAU DU DOCTEUR (+2% CALAMITÉ)"

msgctxt "woh_addy:64"
msgid "move to CORRIDOR A"
msgstr "se rendre dans le COULOIR A"

msgctxt "woh_addy:65"
msgid ""
"enter PHARMACY\n"
"(+3% DOOM)"
msgstr ""
"entrer dans la PHARMACIE\n"
"(+3% CALAMITÉ)"

msgctxt "woh_addy:66"
msgid "A nurse walks past you in a hurry."
msgstr "Un infirmier vous dépasse en hâte."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:67"
msgid "DOCTOR'S OFFICE"
msgstr "BUREAU DU DOCTEUR"

#. Descripción de «DOCTOR'S OFFICE» (woh_addy:67).
msgctxt "woh_addy:68"
msgid "The emergency department is crowded as a direct result of the weird things happening in your town."
msgstr "Les urgences sont saturées à cause des choses étranges qui se passent en ville."

#. Parte de «DOCTOR'S OFFICE» (woh_addy:67).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:69"
msgid ""
"You finally are asked to the doctor's office.\n"
"\n"
"<<Now... how can I help you today?>>"
msgstr ""
"Votre nom est enfin appelé.\n"
"\n"
"<<Bonjour... Alors, que se passe-t-il ?>>"

msgctxt "woh_addy:70"
msgid "EXIT"
msgstr "SORTIE"

msgctxt "woh_addy:71"
msgid "[ADDITIONAL ACTIONS AVAILABLE ON THE INJURY CARDS]"
msgstr "[ACTIONS SECONDAIRES DISPONIBLES SUR LES CARTES BLESSURE]"

msgctxt "woh_addy:72"
msgid "You use the opportunity and steal a bottle of pills."
msgstr "Vous profitez de l'occasion pour voler un flacon de pilules."

msgctxt "woh_addy:73"
msgid "You shouldn't risk stealing another bottle."
msgstr "C'est trop risqué de voler un deuxième flacon."

msgctxt "woh_addy:74"
msgid "You feel like the skull is observing your every move."
msgstr "Vous avez l'impression que le crâne scrute le moindre de vos mouvements."

msgctxt "woh_addy:75"
msgid "CORRIDOR A"
msgstr "COULOIR A"

msgctxt "woh_addy:76"
msgid "You venture further down the corridor..."
msgstr "Vous vous aventurez plus loin dans le couloir..."

msgctxt "woh_addy:77"
msgid "return to the RECEPTION AREA"
msgstr "retourner à la RÉCEPTION"

msgctxt "woh_addy:78"
msgid "take the ELEVATOR"
msgstr "prendre l'ASCENSEUR"

msgctxt "woh_addy:79"
msgid "enter MORGUE"
msgstr "entrer dans la MORGUE"

msgctxt "woh_addy:80"
msgid "What are you doing here?"
msgstr "Qu'est-ce que vous faites ici ?"

msgctxt "woh_addy:81"
msgid "The morgue's door is closed."
msgstr "La porte de la morgue est fermée."

msgctxt "woh_addy:82"
msgid "CORRIDOR B"
msgstr "COULOIR B"

msgctxt "woh_addy:83"
msgid "Upper floor is eerily silent in comparison..."
msgstr "L'étage supérieur baigne dans un étrange silence, par comparaison..."

msgctxt "woh_addy:84"
msgid "check out PATIENT ROOM"
msgstr "examiner la SALLE DE RÉVEIL"

msgctxt "woh_addy:85"
msgid "You shouldn't bother the recovering patients."
msgstr "Vous ne devriez pas déranger les patients en convalescence."

msgctxt "woh_addy:86"
msgid "RESTING AT HOME"
msgstr "SE REPOSER CHEZ SOI"

msgctxt "woh_addy:87"
msgid "It certainly feels good to be back at home."
msgstr "Ça fait du bien d'être de retour chez soi."

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:88"
msgid "STAMINA/REASON"
msgstr "ENDURANCE/LUCIDITÉ"

#. Descripción de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:89"
msgid "Time flies by so fast, you prepare yourself to leave and continue your long investigation."
msgstr "Le temps file à toute vitesse. Vous vous préparez à partir et à continuer votre enquête."

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:90"
msgid "DOOM"
msgstr "CALAMITÉ"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:91"
msgid "STAMINA/REASON"
msgstr "ENDURANCE/LUCIDITÉ"

#. Opción de «STAMINA/REASON» (woh_addy:88). Opciones: DOOM · STAMINA/REASON · Wait... what's that? / [SOMETHING EVIL KNOWS WHERE YOU LIVE].
msgctxt "woh_addy:92"
msgid ""
"Wait... what's that?\n"
"[SOMETHING EVIL KNOWS WHERE YOU LIVE]"
msgstr ""
"Attends... c'est quoi, ça ?\n"
"[LE MALIN SAIT OÙ TU HABITES]"

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:93"
msgid "You take a short nap on your bed."
msgstr "Vous faites une courte sieste sur votre lit."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:94"
msgid "You bandage up the fresh wounds."
msgstr "Vous pansez vos plaies."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:95"
msgid "You take a long hot shower."
msgstr "Vous prenez une longue douche bien chaude."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:96"
msgid "You swallow the painkillers."
msgstr "Vous avalez les antidouleurs."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:97"
msgid "You phone your best friend and talk about unrelated stuff."
msgstr "Vous téléphonez à votre pote et parlez de choses et d'autres."

#. Parte de «STAMINA/REASON» (woh_addy:88).
msgctxt "woh_addy:98"
msgid "You sit on a couch and read your favorite book."
msgstr "Vous vous asseyez sur le canapé et lisez votre livre préféré."

msgctxt "woh_addy:99"
msgid "APARTMENT CORRIDOR"
msgstr "COULOIR"

msgctxt "woh_addy:100"
msgid "You knock on your friend's door and wait..."
msgstr "Vous frappez à la porte de votre camarade et attendez..."

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:101"
msgid "<<Hey dork, I'm with you. Why are we going back to my place?>>"
msgstr "<<Hé, j'suis là, tronche de cake. Pourquoi est-ce qu'on retourne chez moi ?>>"

#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:102"
msgid "<<Heyyy... I'm really busy today. Let's hang out some other time, okay?>>"
msgstr "<<Saluuut... J'ai pas le temps aujourd'hui. On se capte plus tard, d'ac ?>>"

msgctxt "woh_addy:103"
msgid ""
"Huh, KANA's not home.\n"
"You should check later..."
msgstr ""
"Tiens ?\n"
"KANA n'est pas là.\n"
"Revenez plus tard..."

msgctxt "woh_addy:104"
msgid "Shopping for items takes precious time. (+4% DOOM)"
msgstr "Les emplettes, ça prend du temps... (+4% CALAMITÉ)"

msgctxt "woh_addy:105"
msgid "Huh... where is that dog?"
msgstr "Mais où peut bien être ce sac à puces ?"

msgctxt "woh_addy:106"
msgid "SHOPPING FOR ITEMS"
msgstr "FAIRE DES ACHATS"

msgctxt "woh_addy:107"
msgid "EXIT WITHOUT BUYING ANYTHING"
msgstr "PARTIR SANS RIEN ACHETER"

msgctxt "woh_addy:108"
msgid "needs YAKUZA CARD"
msgstr "\"CARTE DE YAKUZA\""

msgctxt "woh_addy:109"
msgid "AVAILABLE ITEMS"
msgstr "ARTICLES DISPONIBLES"

msgctxt "woh_addy:110"
msgid "PRICE"
msgstr "PRIX"

msgctxt "woh_addy:111"
msgid "FUNDS"
msgstr "ARGENT"

msgctxt "woh_addy:112"
msgid "A random discounted item."
msgstr "Un article aléatoire en promotion."

msgctxt "woh_addy:113"
msgid "RESTOCK"
msgstr "RÉAPPROVISIONNER"

msgctxt "woh_addy:114"
msgid "reroll items (+3% DOOM)"
msgstr "changer d'articles (+3% CALAMITÉ)"

msgctxt "woh_addy:115"
msgid "You've bought a new item."
msgstr "Vous avez acheté un nouvel article."

msgctxt "woh_addy:116"
msgid "You don't have enough money."
msgstr "Vous n'avez pas assez d'argent."

msgctxt "woh_addy:117"
msgid "Woof!-"
msgstr "Wouf ! -"

msgctxt "woh_addy:118"
msgid "-DISCOUNT ITEM-"
msgstr "-PROMOTION-"

msgctxt "woh_addy:119"
msgid "On your way out, you stop by the vending machines. (+2% DOOM)"
msgstr "En sortant, vous vous arrêtez aux distributeurs automatiques. (+1% CALAMITÉ)"

msgctxt "woh_addy:120"
msgid "SHOP FOR ITEMS"
msgstr "FAIRE DES ACHATS"

msgctxt "woh_addy:121"
msgid ""
"[costs DOOM to enter]\n"
"[funds -> items]"
msgstr ""
"[dépenser CALAMITÉ pour valider]\n"
"[Argent -> articles]"

msgctxt "woh_addy:122"
msgid ""
"[costs DOOM to enter]\n"
"[regain STAMINA and REASON]"
msgstr ""
"[dépenser CALAMITÉ pour valider]\n"
"[récupérer ENDURANCE et LUCIDITÉ]"

msgctxt "woh_addy:123"
msgid "REST"
msgstr "SE REPOSER"

#. Título; los textos siguientes forman parte de su bloque.
msgctxt "woh_addy:124"
msgid "VENDING MACHINE"
msgstr "DISTRIB. AUTOMATIQUE"

#. Descripción de «VENDING MACHINE» (woh_addy:124).
#. Diálogo o pensamiento entre << >>.
msgctxt "woh_addy:125"
msgid ""
"Entering the ILLEGAL DEN, you instantly recognize the girl who attacked you and dropped the prescription.\n"
"You throw the expensive medicine on the table before getting closer.\n"
"\n"
"<<I-is that the drug for my grandma?...>> Her eyes light up.\n"
"<<I thought it was gone forever... but why would you help me at all?>>"
msgstr ""
"En entrant dans l'ANTRE ILLÉGAL, vous reconnaissez immédiatement la fille qui a fait tomber son ordonnance dans la bagarre, un peu plus tôt.\n"
"Vous jetez les pilules hors de prix sur la table avant de vous approcher.\n"
"\n"
