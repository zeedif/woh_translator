msgctxt "woh_spell:18"
msgid ""
"deals 5 damage\n"
"regain 2 REASON\n"
"[COST: -1 MAX REASON]"
msgstr ""
"inflige 5 dégâts\n"
"restaure 2 LUCIDITÉ\n"
"[COÛT : -1 LUCIDITÉ MAX]"

