msgid "[+4 STAMINA]"
msgstr "[+4 ENDURANCE]"

msgctxt "woh_chal:145"
msgid "[+4 REASON]"
msgstr "[+4 LUCIDITÉ]"

msgctxt "woh_chal:146"
msgid "[+2 FUNDS]"
msgstr "[+2 ARGENT]"

