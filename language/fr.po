msgctxt "woh_perk:20"
msgid "CQC TRAINING"
msgstr "COMBAT RAPPROCHÉ"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:21"
msgid "using firearms as melee weapons deals more damage"
msgstr "vous infligez plus de dégâts en utilisant des armes à feu en tant qu'arme de mêlée"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:22"
msgid "IREZUMI"
msgstr "TATOUAGE"

#. Mejoras (perks): nombre, efecto y mensaje al activarse.
msgctxt "woh_perk:23"
msgid ""
"items in the shops are cheaper by 1\n"
"[minimum 1]"
msgstr ""
"le prix des articles de la boutique est réduit de 1\n"
"[minimum 1]"

