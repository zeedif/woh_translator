msgctxt "woh_halo:7"
msgid "<<I've been collecting these notes for quite some time now.>>"
msgstr "<<Je réunis ces notes depuis un moment déjà.>>"

msgctxt "woh_halo:8"
msgid "An unseen force guides your hand to the bag..."
msgstr "Une force invisible guide votre main dans le sac..."

msgctxt "woh_halo:9"
