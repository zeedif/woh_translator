msgctxt "woh_spell:91"
msgid ""
"immediately kills any non-eldritch enemy\n"
"[one time use only]\n"
"[COST: 7% DOOM]"
msgstr ""
"élimine instantanément tout ennemi non paranormal\n"
"[usage unique]\n"
"[COÛT : 7% CALAMITÉ]"

