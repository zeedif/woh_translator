msgctxt "woh_spell:70"
msgid ""
"target enemy's damage is lowered by 1\n"
"[COST: 3 REASON]"
msgstr ""
"les dégâts de la cible ennemie sont réduits de 1\n"
"[COÛT : 3 LUCIDITÉ]"

